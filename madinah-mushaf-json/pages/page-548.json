  "verses": [
    {
      "surah_number": 59,
      "ayah_number": 17,
      "words": [
        {
          "word_index": 0,
          "text": "فَكَانَ"
        },
        {
          "word_index": 1,
          "text": "عَـٰقِبَتَهُمَآ"
        },
        {
          "word_index": 2,
          "text": "أَنَّهُمَا"
        },
        {
          "word_index": 3,
          "text": "فِى"
        },
        {
          "word_index": 4,
          "text": "ٱلنَّارِ"
        },
        {
          "word_index": 5,
          "text": "خَـٰلِدَيْنِ"
        },
        {
          "word_index": 6,
          "text": "فِيهَا ۚ"
        },
        {
          "word_index": 7,
          "text": "وَذَٰلِكَ"
        },
        {
          "word_index": 8,
          "text": "جَزَٰٓؤُا۟"
        },
        {
          "word_index": 9,
          "text": "ٱلظَّـٰلِمِينَ"
        }
      ]
    },
    {
      "surah_number": 59,
      "ayah_number": 18,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 3,
          "text": "ٱتَّقُوا۟"
        },
        {
          "word_index": 4,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 5,
          "text": "وَلْتَنظُرْ"
        },
        {
          "word_index": 6,
          "text": "نَفْسٌۭ"
        },
        {
          "word_index": 7,
          "text": "مَّا"
        },
        {
          "word_index": 8,
          "text": "قَدَّمَتْ"
        },
        {
          "word_index": 9,
          "text": "لِغَدٍۢ ۖ"
        },
        {
          "word_index": 10,
          "text": "وَٱتَّقُوا۟"
        },
        {
          "word_index": 11,
          "text": "ٱللَّهَ ۚ"
        },
        {
          "word_index": 12,
          "text": "إِنَّ"
        },
        {
          "word_index": 13,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 14,
          "text": "خَبِيرٌۢ"
        },
        {
          "word_index": 15,
          "text": "بِمَا"
        },
        {
          "word_index": 16,
          "text": "تَعْمَلُونَ"
        }
      ]
    },
    {
      "surah_number": 59,
      "ayah_number": 19,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَا"
        },
        {
          "word_index": 1,
          "text": "تَكُونُوا۟"
        },
        {
          "word_index": 2,
          "text": "كَٱلَّذِينَ"
        },
        {
          "word_index": 3,
          "text": "نَسُوا۟"
        },
        {
          "word_index": 4,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 5,
          "text": "فَأَنسَىٰهُمْ"
        },
        {
          "word_index": 6,
          "text": "أَنفُسَهُمْ ۚ"
        },
        {
          "word_index": 7,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 8,
          "text": "هُمُ"
        },
        {
          "word_index": 9,
          "text": "ٱلْفَـٰسِقُونَ"
        }
      ]
    },
    {
