{
  "page": 7,
  "verses": [
    {
      "surah_number": 2,
      "ayah_number": 38,
      "words": [
        {
          "word_index": 0,
          "text": "قُلْنَا"
        },
        {
          "word_index": 1,
          "text": "ٱهْبِطُوا۟"
        },
        {
          "word_index": 2,
          "text": "مِنْهَا"
        },
        {
          "word_index": 3,
          "text": "جَمِيعًۭا ۖ"
        },
        {
          "word_index": 4,
          "text": "فَإِمَّا"
        },
        {
          "word_index": 5,
          "text": "يَأْتِيَنَّكُم"
        },
        {
          "word_index": 6,
          "text": "مِّنِّى"
        },
        {
          "word_index": 7,
          "text": "هُدًۭى"
        },
        {
          "word_index": 8,
          "text": "فَمَن"
        },
        {
          "word_index": 9,
          "text": "تَبِعَ"
        },
        {
          "word_index": 10,
          "text": "هُدَاىَ"
        },
        {
          "word_index": 11,
          "text": "فَلَا"
        },
        {
          "word_index": 12,
          "text": "خَوْفٌ"
        },
        {
          "word_index": 13,
          "text": "عَلَيْهِمْ"
        },
        {
          "word_index": 14,
          "text": "وَلَا"
        },
        {
          "word_index": 15,
          "text": "هُمْ"
        },
        {
          "word_index": 16,
          "text": "يَحْزَنُونَ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 39,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "كَفَرُوا۟"
        },
        {
          "word_index": 2,
          "text": "وَكَذَّبُوا۟"
        },
        {
          "word_index": 3,
          "text": "بِـَٔايَـٰتِنَآ"
        },
        {
          "word_index": 4,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 5,
          "text": "أَصْحَـٰبُ"
        },
        {
          "word_index": 6,
          "text": "ٱلنَّارِ ۖ"
        },
        {
          "word_index": 7,
          "text": "هُمْ"
        },
        {
          "word_index": 8,
          "text": "فِيهَا"
        },
        {
          "word_index": 9,
          "text": "خَـٰلِدُونَ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 40,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰبَنِىٓ"
        },
        {
          "word_index": 1,
          "text": "إِسْرَٰٓءِيلَ"
        },
        {
          "word_index": 2,
          "text": "ٱذْكُرُوا۟"
        },
        {
          "word_index": 3,
          "text": "نِعْمَتِىَ"
        },
        {
          "word_index": 4,
          "text": "ٱلَّتِىٓ"
        },
        {
          "word_index": 5,
          "text": "أَنْعَمْتُ"
        },
        {
          "word_index": 6,
          "text": "عَلَيْكُمْ"
        },
        {
          "word_index": 7,
          "text": "وَأَوْفُوا۟"
        },
        {
          "word_index": 8,
          "text": "بِعَهْدِىٓ"
        },
        {
          "word_index": 9,
          "text": "أُوفِ"
        },
        {
          "word_index": 10,
          "text": "بِعَهْدِكُمْ"
        },
        {
          "word_index": 11,
          "text": "وَإِيَّـٰىَ"
        },
        {
          "word_index": 12,
          "text": "فَٱرْهَبُونِ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 41,
      "words": [
        {
          "word_index": 0,
          "text": "وَءَامِنُوا۟"
        },
        {
          "word_index": 1,
          "text": "بِمَآ"
        },
        {
          "word_index": 2,
          "text": "أَنزَلْتُ"
        },
        {
          "word_index": 3,
          "text": "مُصَدِّقًۭا"
        },
        {
          "word_index": 4,
          "text": "لِّمَا"
        },
        {
          "word_index": 5,
          "text": "مَعَكُمْ"
        },
        {
          "word_index": 6,
          "text": "وَلَا"
        },
        {
          "word_index": 7,
          "text": "تَكُونُوٓا۟"
        },
        {
          "word_index": 8,
          "text": "أَوَّلَ"
        },
        {
          "word_index": 9,
          "text": "كَافِرٍۭ"
        },
        {
          "word_index": 10,
          "text": "بِهِۦ ۖ"
        },
        {
          "word_index": 11,
          "text": "وَلَا"
        },
        {
          "word_index": 12,
          "text": "تَشْتَرُوا۟"
        },
        {
          "word_index": 13,
          "text": "بِـَٔايَـٰتِى"
        },
        {
          "word_index": 14,
          "text": "ثَمَنًۭا"
        },
        {
          "word_index": 15,
          "text": "قَلِيلًۭا"
        },
        {
          "word_index": 16,
          "text": "وَإِيَّـٰىَ"
        },
        {
          "word_index": 17,
          "text": "فَٱتَّقُونِ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 42,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَا"
        },
        {
          "word_index": 1,
          "text": "تَلْبِسُوا۟"
        },
        {
          "word_index": 2,
          "text": "ٱلْحَقَّ"
        },
        {
          "word_index": 3,
          "text": "بِٱلْبَـٰطِلِ"
        },
        {
          "word_index": 4,
          "text": "وَتَكْتُمُوا۟"
        },
        {
          "word_index": 5,
          "text": "ٱلْحَقَّ"
        },
        {
          "word_index": 6,
          "text": "وَأَنتُمْ"
        },
        {
          "word_index": 7,
          "text": "تَعْلَمُونَ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 43,
      "words": [
        {
          "word_index": 0,
          "text": "وَأَقِيمُوا۟"
        },
        {
          "word_index": 1,
          "text": "ٱلصَّلَوٰةَ"
        },
        {
          "word_index": 2,
          "text": "وَءَاتُوا۟"
        },
        {
          "word_index": 3,
          "text": "ٱلزَّكَوٰةَ"
        },
        {
          "word_index": 4,
          "text": "وَٱرْكَعُوا۟"
        },
        {
          "word_index": 5,
          "text": "مَعَ"
        },
        {
          "word_index": 6,
          "text": "ٱلرَّٰكِعِينَ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 44,
      "words": [
        {
          "word_index": 0,
          "text": "۞ أَتَأْمُرُونَ"
        },
        {
          "word_index": 1,
          "text": "ٱلنَّاسَ"
        },
        {
          "word_index": 2,
          "text": "بِٱلْبِرِّ"
        },
        {
          "word_index": 3,
          "text": "وَتَنسَوْنَ"
        },
        {
          "word_index": 4,
          "text": "أَنفُسَكُمْ"
        },
        {
          "word_index": 5,
          "text": "وَأَنتُمْ"
        },
        {
          "word_index": 6,
          "text": "تَتْلُونَ"
        },
        {
          "word_index": 7,
          "text": "ٱلْكِتَـٰبَ ۚ"
        },
        {
          "word_index": 8,
          "text": "أَفَلَا"
        },
        {
          "word_index": 9,
          "text": "تَعْقِلُونَ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 45,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱسْتَعِينُوا۟"
