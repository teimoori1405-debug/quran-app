          "word_index": 1,
          "text": "قَوْمِ"
        },
        {
          "word_index": 2,
          "text": "مُوسَىٰٓ"
        },
        {
          "word_index": 3,
          "text": "أُمَّةٌۭ"
        },
        {
          "word_index": 4,
          "text": "يَهْدُونَ"
        },
        {
          "word_index": 5,
          "text": "بِٱلْحَقِّ"
