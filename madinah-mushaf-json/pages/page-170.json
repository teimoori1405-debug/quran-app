{
  "page": 170,
  "verses": [
    {
      "surah_number": 7,
      "ayah_number": 156,
      "words": [
        {
          "word_index": 0,
          "text": "۞ وَٱكْتُبْ"
        },
        {
          "word_index": 1,
          "text": "لَنَا"
        },
        {
          "word_index": 2,
          "text": "فِى"
        },
        {
          "word_index": 3,
          "text": "هَـٰذِهِ"
        },
        {
          "word_index": 4,
          "text": "ٱلدُّنْيَا"
        },
        {
          "word_index": 5,
          "text": "حَسَنَةًۭ"
        },
        {
          "word_index": 6,
          "text": "وَفِى"
        },
        {
          "word_index": 7,
          "text": "ٱلْـَٔاخِرَةِ"
        },
        {
          "word_index": 8,
          "text": "إِنَّا"
        },
        {
          "word_index": 9,
          "text": "هُدْنَآ"
        },
        {
          "word_index": 10,
          "text": "إِلَيْكَ ۚ"
        },
        {
          "word_index": 11,
          "text": "قَالَ"
        },
        {
          "word_index": 12,
          "text": "عَذَابِىٓ"
        },
        {
          "word_index": 13,
          "text": "أُصِيبُ"
        },
        {
          "word_index": 14,
          "text": "بِهِۦ"
        },
        {
          "word_index": 15,
          "text": "مَنْ"
        },
        {
          "word_index": 16,
          "text": "أَشَآءُ ۖ"
        },
        {
          "word_index": 17,
          "text": "وَرَحْمَتِى"
        },
        {
          "word_index": 18,
          "text": "وَسِعَتْ"
        },
        {
          "word_index": 19,
          "text": "كُلَّ"
        },
        {
          "word_index": 20,
          "text": "شَىْءٍۢ ۚ"
        },
        {
          "word_index": 21,
          "text": "فَسَأَكْتُبُهَا"
        },
        {
          "word_index": 22,
          "text": "لِلَّذِينَ"
        },
        {
          "word_index": 23,
          "text": "يَتَّقُونَ"
        },
        {
          "word_index": 24,
          "text": "وَيُؤْتُونَ"
        },
        {
          "word_index": 25,
          "text": "ٱلزَّكَوٰةَ"
        },
        {
          "word_index": 26,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 27,
          "text": "هُم"
        },
        {
          "word_index": 28,
          "text": "بِـَٔايَـٰتِنَا"
        },
        {
          "word_index": 29,
          "text": "يُؤْمِنُونَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 157,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "يَتَّبِعُونَ"
        },
        {
          "word_index": 2,
          "text": "ٱلرَّسُولَ"
        },
        {
          "word_index": 3,
          "text": "ٱلنَّبِىَّ"
        },
        {
          "word_index": 4,
          "text": "ٱلْأُمِّىَّ"
        },
        {
          "word_index": 5,
          "text": "ٱلَّذِى"
        },
        {
          "word_index": 6,
          "text": "يَجِدُونَهُۥ"
        },
        {
          "word_index": 7,
          "text": "مَكْتُوبًا"
        },
        {
          "word_index": 8,
          "text": "عِندَهُمْ"
        },
        {
          "word_index": 9,
          "text": "فِى"
        },
        {
          "word_index": 10,
          "text": "ٱلتَّوْرَىٰةِ"
        },
        {
          "word_index": 11,
          "text": "وَٱلْإِنجِيلِ"
        },
        {
          "word_index": 12,
          "text": "يَأْمُرُهُم"
        },
        {
          "word_index": 13,
          "text": "بِٱلْمَعْرُوفِ"
        },
        {
          "word_index": 14,
          "text": "وَيَنْهَىٰهُمْ"
        },
        {
          "word_index": 15,
          "text": "عَنِ"
        },
        {
          "word_index": 16,
          "text": "ٱلْمُنكَرِ"
        },
        {
          "word_index": 17,
          "text": "وَيُحِلُّ"
        },
        {
          "word_index": 18,
          "text": "لَهُمُ"
        },
        {
          "word_index": 19,
          "text": "ٱلطَّيِّبَـٰتِ"
        },
        {
          "word_index": 20,
          "text": "وَيُحَرِّمُ"
        },
        {
          "word_index": 21,
          "text": "عَلَيْهِمُ"
        },
        {
          "word_index": 22,
          "text": "ٱلْخَبَـٰٓئِثَ"
        },
        {
          "word_index": 23,
          "text": "وَيَضَعُ"
        },
        {
          "word_index": 24,
          "text": "عَنْهُمْ"
        },
        {
          "word_index": 25,
          "text": "إِصْرَهُمْ"
        },
        {
          "word_index": 26,
          "text": "وَٱلْأَغْلَـٰلَ"
        },
        {
          "word_index": 27,
          "text": "ٱلَّتِى"
        },
        {
          "word_index": 28,
          "text": "كَانَتْ"
        },
        {
          "word_index": 29,
          "text": "عَلَيْهِمْ ۚ"
        },
        {
          "word_index": 30,
          "text": "فَٱلَّذِينَ"
        },
        {
          "word_index": 31,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 32,
          "text": "بِهِۦ"
        },
        {
          "word_index": 33,
          "text": "وَعَزَّرُوهُ"
        },
        {
          "word_index": 34,
          "text": "وَنَصَرُوهُ"
        },
        {
          "word_index": 35,
          "text": "وَٱتَّبَعُوا۟"
        },
        {
          "word_index": 36,
          "text": "ٱلنُّورَ"
        },
        {
          "word_index": 37,
          "text": "ٱلَّذِىٓ"
        },
        {
          "word_index": 38,
          "text": "أُنزِلَ"
        },
        {
          "word_index": 39,
          "text": "مَعَهُۥٓ ۙ"
        },
        {
          "word_index": 40,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 41,
          "text": "هُمُ"
        },
        {
          "word_index": 42,
          "text": "ٱلْمُفْلِحُونَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 158,
      "words": [
        {
          "word_index": 0,
          "text": "قُلْ"
        },
        {
          "word_index": 1,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 2,
          "text": "ٱلنَّاسُ"
        },
        {
          "word_index": 3,
          "text": "إِنِّى"
        },
        {
          "word_index": 4,
          "text": "رَسُولُ"
        },
        {
          "word_index": 5,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 6,
          "text": "إِلَيْكُمْ"
        },
        {
          "word_index": 7,
          "text": "جَمِيعًا"
        },
        {
          "word_index": 8,
          "text": "ٱلَّذِى"
        },
        {
          "word_index": 9,
          "text": "لَهُۥ"
        },
        {
          "word_index": 10,
          "text": "مُلْكُ"
        },
        {
          "word_index": 11,
          "text": "ٱلسَّمَـٰوَٰتِ"
        },
        {
          "word_index": 12,
          "text": "وَٱلْأَرْضِ ۖ"
        },
        {
          "word_index": 13,
          "text": "لَآ"
        },
        {
          "word_index": 14,
          "text": "إِلَـٰهَ"
        },
        {
          "word_index": 15,
          "text": "إِلَّا"
        },
        {
          "word_index": 16,
          "text": "هُوَ"
        },
        {
          "word_index": 17,
          "text": "يُحْىِۦ"
        },
        {
          "word_index": 18,
          "text": "وَيُمِيتُ ۖ"
        },
        {
          "word_index": 19,
          "text": "فَـَٔامِنُوا۟"
        },
        {
          "word_index": 20,
          "text": "بِٱللَّهِ"
        },
        {
          "word_index": 21,
          "text": "وَرَسُولِهِ"
        },
        {
          "word_index": 22,
          "text": "ٱلنَّبِىِّ"
        },
        {
          "word_index": 23,
          "text": "ٱلْأُمِّىِّ"
        },
        {
          "word_index": 24,
          "text": "ٱلَّذِى"
        },
        {
          "word_index": 25,
          "text": "يُؤْمِنُ"
        },
        {
          "word_index": 26,
          "text": "بِٱللَّهِ"
        },
        {
          "word_index": 27,
          "text": "وَكَلِمَـٰتِهِۦ"
        },
        {
          "word_index": 28,
          "text": "وَٱتَّبِعُوهُ"
        },
        {
          "word_index": 29,
          "text": "لَعَلَّكُمْ"
        },
        {
          "word_index": 30,
          "text": "تَهْتَدُونَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 159,
      "words": [
