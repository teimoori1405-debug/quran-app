{
  "page": 363,
  "verses": [
    {
      "surah_number": 25,
      "ayah_number": 33,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَا"
        },
        {
          "word_index": 1,
          "text": "يَأْتُونَكَ"
        },
        {
          "word_index": 2,
          "text": "بِمَثَلٍ"
        },
        {
          "word_index": 3,
          "text": "إِلَّا"
        },
        {
          "word_index": 4,
          "text": "جِئْنَـٰكَ"
        },
        {
          "word_index": 5,
          "text": "بِٱلْحَقِّ"
        },
        {
          "word_index": 6,
          "text": "وَأَحْسَنَ"
        },
        {
          "word_index": 7,
          "text": "تَفْسِيرًا"
        }
      ]
    },
    {
      "surah_number": 25,
      "ayah_number": 34,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "يُحْشَرُونَ"
        },
        {
          "word_index": 2,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 3,
          "text": "وُجُوهِهِمْ"
        },
        {
          "word_index": 4,
          "text": "إِلَىٰ"
        },
        {
          "word_index": 5,
          "text": "جَهَنَّمَ"
        },
        {
          "word_index": 6,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 7,
          "text": "شَرٌّۭ"
        },
        {
          "word_index": 8,
          "text": "مَّكَانًۭا"
        },
        {
          "word_index": 9,
          "text": "وَأَضَلُّ"
        },
        {
          "word_index": 10,
          "text": "سَبِيلًۭا"
        }
      ]
    },
    {
      "surah_number": 25,
      "ayah_number": 35,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "ءَاتَيْنَا"
        },
        {
          "word_index": 2,
          "text": "مُوسَى"
        },
        {
          "word_index": 3,
          "text": "ٱلْكِتَـٰبَ"
        },
        {
          "word_index": 4,
          "text": "وَجَعَلْنَا"
        },
        {
          "word_index": 5,
          "text": "مَعَهُۥٓ"
        },
        {
          "word_index": 6,
          "text": "أَخَاهُ"
        },
        {
          "word_index": 7,
          "text": "هَـٰرُونَ"
        },
        {
          "word_index": 8,
          "text": "وَزِيرًۭا"
        }
      ]
    },
    {
      "surah_number": 25,
      "ayah_number": 36,
      "words": [
        {
          "word_index": 0,
          "text": "فَقُلْنَا"
        },
        {
          "word_index": 1,
          "text": "ٱذْهَبَآ"
        },
        {
          "word_index": 2,
          "text": "إِلَى"
        },
        {
          "word_index": 3,
          "text": "ٱلْقَوْمِ"
        },
        {
          "word_index": 4,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 5,
          "text": "كَذَّبُوا۟"
        },
        {
          "word_index": 6,
          "text": "بِـَٔايَـٰتِنَا"
        },
        {
          "word_index": 7,
          "text": "فَدَمَّرْنَـٰهُمْ"
        },
        {
          "word_index": 8,
          "text": "تَدْمِيرًۭا"
        }
      ]
    },
    {
      "surah_number": 25,
      "ayah_number": 37,
      "words": [
        {
          "word_index": 0,
          "text": "وَقَوْمَ"
        },
        {
          "word_index": 1,
          "text": "نُوحٍۢ"
        },
        {
          "word_index": 2,
          "text": "لَّمَّا"
        },
        {
          "word_index": 3,
          "text": "كَذَّبُوا۟"
        },
        {
          "word_index": 4,
          "text": "ٱلرُّسُلَ"
        },
        {
          "word_index": 5,
          "text": "أَغْرَقْنَـٰهُمْ"
        },
        {
          "word_index": 6,
          "text": "وَجَعَلْنَـٰهُمْ"
        },
        {
          "word_index": 7,
          "text": "لِلنَّاسِ"
        },
        {
          "word_index": 8,
          "text": "ءَايَةًۭ ۖ"
        },
        {
          "word_index": 9,
          "text": "وَأَعْتَدْنَا"
        },
        {
          "word_index": 10,
          "text": "لِلظَّـٰلِمِينَ"
        },
        {
          "word_index": 11,
          "text": "عَذَابًا"
        },
        {
          "word_index": 12,
          "text": "أَلِيمًۭا"
        }
      ]
    },
    {
      "surah_number": 25,
      "ayah_number": 38,
      "words": [
        {
          "word_index": 0,
          "text": "وَعَادًۭا"
        },
        {
          "word_index": 1,
          "text": "وَثَمُودَا۟"
        },
        {
          "word_index": 2,
          "text": "وَأَصْحَـٰبَ"
        },
        {
          "word_index": 3,
          "text": "ٱلرَّسِّ"
        },
        {
          "word_index": 4,
          "text": "وَقُرُونًۢا"
        },
        {
          "word_index": 5,
          "text": "بَيْنَ"
        },
        {
          "word_index": 6,
          "text": "ذَٰلِكَ"
        },
        {
          "word_index": 7,
          "text": "كَثِيرًۭا"
