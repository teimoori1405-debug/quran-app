{
  "page": 492,
  "verses": [
    {
      "surah_number": 43,
      "ayah_number": 34,
      "words": [
        {
          "word_index": 0,
          "text": "وَلِبُيُوتِهِمْ"
        },
        {
          "word_index": 1,
          "text": "أَبْوَٰبًۭا"
        },
        {
          "word_index": 2,
          "text": "وَسُرُرًا"
        },
        {
          "word_index": 3,
          "text": "عَلَيْهَا"
        },
        {
          "word_index": 4,
          "text": "يَتَّكِـُٔونَ"
        }
      ]
    },
    {
      "surah_number": 43,
      "ayah_number": 35,
      "words": [
        {
          "word_index": 0,
          "text": "وَزُخْرُفًۭا ۚ"
        },
        {
          "word_index": 1,
          "text": "وَإِن"
        },
        {
          "word_index": 2,
          "text": "كُلُّ"
        },
        {
          "word_index": 3,
          "text": "ذَٰلِكَ"
        },
        {
          "word_index": 4,
          "text": "لَمَّا"
        },
        {
          "word_index": 5,
          "text": "مَتَـٰعُ"
        },
        {
          "word_index": 6,
          "text": "ٱلْحَيَوٰةِ"
        },
        {
          "word_index": 7,
          "text": "ٱلدُّنْيَا ۚ"
        },
        {
          "word_index": 8,
          "text": "وَٱلْـَٔاخِرَةُ"
        },
        {
          "word_index": 9,
          "text": "عِندَ"
        },
        {
          "word_index": 10,
          "text": "رَبِّكَ"
        },
        {
          "word_index": 11,
          "text": "لِلْمُتَّقِينَ"
        }
      ]
    },
    {
      "surah_number": 43,
      "ayah_number": 36,
      "words": [
        {
          "word_index": 0,
          "text": "وَمَن"
        },
        {
          "word_index": 1,
          "text": "يَعْشُ"
        },
        {
          "word_index": 2,
          "text": "عَن"
        },
        {
          "word_index": 3,
          "text": "ذِكْرِ"
        },
        {
          "word_index": 4,
          "text": "ٱلرَّحْمَـٰنِ"
        },
        {
          "word_index": 5,
          "text": "نُقَيِّضْ"
        },
        {
          "word_index": 6,
          "text": "لَهُۥ"
        },
        {
          "word_index": 7,
          "text": "شَيْطَـٰنًۭا"
        },
        {
          "word_index": 8,
          "text": "فَهُوَ"
        },
        {
          "word_index": 9,
          "text": "لَهُۥ"
        },
        {
          "word_index": 10,
          "text": "قَرِينٌۭ"
        }
      ]
    },
    {
      "surah_number": 43,
      "ayah_number": 37,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِنَّهُمْ"
        },
        {
          "word_index": 1,
          "text": "لَيَصُدُّونَهُمْ"
