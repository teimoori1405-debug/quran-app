          "word_index": 2,
          "text": "عَنِ"
        },
        {
          "word_index": 3,
          "text": "ٱلسَّبِيلِ"
        },
        {
          "word_index": 4,
          "text": "وَيَحْسَبُونَ"
        },
        {
          "word_index": 5,
          "text": "أَنَّهُم"
        },
        {
          "word_index": 6,
          "text": "مُّهْتَدُونَ"
