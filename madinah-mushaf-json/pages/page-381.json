{
  "page": 381,
  "verses": [
    {
      "surah_number": 27,
      "ayah_number": 45,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "أَرْسَلْنَآ"
        },
        {
          "word_index": 2,
          "text": "إِلَىٰ"
        },
        {
          "word_index": 3,
          "text": "ثَمُودَ"
        },
        {
          "word_index": 4,
          "text": "أَخَاهُمْ"
        },
        {
          "word_index": 5,
          "text": "صَـٰلِحًا"
        },
        {
          "word_index": 6,
          "text": "أَنِ"
        },
        {
          "word_index": 7,
          "text": "ٱعْبُدُوا۟"
        },
        {
          "word_index": 8,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 9,
          "text": "فَإِذَا"
        },
        {
          "word_index": 10,
          "text": "هُمْ"
        },
        {
          "word_index": 11,
          "text": "فَرِيقَانِ"
        },
        {
          "word_index": 12,
          "text": "يَخْتَصِمُونَ"
        }
      ]
    },
    {
      "surah_number": 27,
      "ayah_number": 46,
      "words": [
        {
          "word_index": 0,
          "text": "قَالَ"
        },
        {
          "word_index": 1,
          "text": "يَـٰقَوْمِ"
        },
        {
          "word_index": 2,
          "text": "لِمَ"
        },
        {
          "word_index": 3,
          "text": "تَسْتَعْجِلُونَ"
        },
        {
          "word_index": 4,
          "text": "بِٱلسَّيِّئَةِ"
        },
        {
          "word_index": 5,
          "text": "قَبْلَ"
        },
        {
          "word_index": 6,
          "text": "ٱلْحَسَنَةِ ۖ"
        },
        {
          "word_index": 7,
          "text": "لَوْلَا"
        },
        {
          "word_index": 8,
          "text": "تَسْتَغْفِرُونَ"
        },
        {
          "word_index": 9,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 10,
          "text": "لَعَلَّكُمْ"
        },
        {
          "word_index": 11,
          "text": "تُرْحَمُونَ"
        }
      ]
    },
    {
      "surah_number": 27,
      "ayah_number": 47,
      "words": [
        {
          "word_index": 0,
          "text": "قَالُوا۟"
        },
        {
          "word_index": 1,
          "text": "ٱطَّيَّرْنَا"
        },
        {
          "word_index": 2,
          "text": "بِكَ"
        },
        {
          "word_index": 3,
          "text": "وَبِمَن"
        },
        {
          "word_index": 4,
          "text": "مَّعَكَ ۚ"
        },
        {
          "word_index": 5,
          "text": "قَالَ"
        },
        {
          "word_index": 6,
          "text": "طَـٰٓئِرُكُمْ"
        },
        {
          "word_index": 7,
          "text": "عِندَ"
        },
        {
          "word_index": 8,
          "text": "ٱللَّهِ ۖ"
