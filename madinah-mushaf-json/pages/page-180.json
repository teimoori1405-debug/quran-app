  "verses": [
    {
      "surah_number": 8,
      "ayah_number": 26,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱذْكُرُوٓا۟"
        },
        {
          "word_index": 1,
          "text": "إِذْ"
        },
        {
          "word_index": 2,
          "text": "أَنتُمْ"
        },
        {
          "word_index": 3,
          "text": "قَلِيلٌۭ"
        },
        {
          "word_index": 4,
          "text": "مُّسْتَضْعَفُونَ"
        },
        {
          "word_index": 5,
          "text": "فِى"
        },
        {
          "word_index": 6,
          "text": "ٱلْأَرْضِ"
        },
        {
          "word_index": 7,
          "text": "تَخَافُونَ"
        },
        {
          "word_index": 8,
          "text": "أَن"
        },
        {
          "word_index": 9,
          "text": "يَتَخَطَّفَكُمُ"
