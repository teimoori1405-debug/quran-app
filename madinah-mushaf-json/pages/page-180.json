          "word_index": 3,
          "text": "لَا"
        },
        {
          "word_index": 4,
          "text": "تَخُونُوا۟"
        },
        {
          "word_index": 5,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 6,
          "text": "وَٱلرَّسُولَ"
        },
        {
          "word_index": 7,
          "text": "وَتَخُونُوٓا۟"
