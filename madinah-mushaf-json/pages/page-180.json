          "text": "ٱلنَّاسُ"
        },
        {
          "word_index": 11,
          "text": "فَـَٔاوَىٰكُمْ"
        },
        {
          "word_index": 12,
          "text": "وَأَيَّدَكُم"
        },
        {
          "word_index": 13,
          "text": "بِنَصْرِهِۦ"
        },
        {
          "word_index": 14,
          "text": "وَرَزَقَكُم"
        },
        {
          "word_index": 15,
          "text": "مِّنَ"
        },
        {
          "word_index": 16,
          "text": "ٱلطَّيِّبَـٰتِ"
        },
        {
          "word_index": 17,
          "text": "لَعَلَّكُمْ"
        },
        {
          "word_index": 18,
          "text": "تَشْكُرُونَ"
        }
      ]
    },
    {
      "surah_number": 8,
      "ayah_number": 27,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوا۟"
        },
