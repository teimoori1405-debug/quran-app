          "text": "يَكْتُبَ"
        },
        {
          "word_index": 19,
          "text": "كَمَا"
        },
        {
          "word_index": 20,
          "text": "عَلَّمَهُ"
        },
        {
          "word_index": 21,
          "text": "ٱللَّهُ ۚ"
        },
        {
          "word_index": 22,
          "text": "فَلْيَكْتُبْ"
        },
        {
          "word_index": 23,
          "text": "وَلْيُمْلِلِ"
