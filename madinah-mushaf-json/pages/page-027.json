          "word_index": 27,
          "text": "ٱلسَّبِيلِ"
        },
        {
          "word_index": 28,
          "text": "وَٱلسَّآئِلِينَ"
        },
        {
          "word_index": 29,
          "text": "وَفِى"
        },
        {
          "word_index": 30,
          "text": "ٱلرِّقَابِ"
        },
        {
          "word_index": 31,
          "text": "وَأَقَامَ"
