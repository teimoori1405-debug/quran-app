          "word_index": 3,
          "text": "تُوَلُّوا۟"
        },
        {
          "word_index": 4,
          "text": "وُجُوهَكُمْ"
        },
        {
          "word_index": 5,
          "text": "قِبَلَ"
        },
        {
          "word_index": 6,
          "text": "ٱلْمَشْرِقِ"
        },
        {
          "word_index": 7,
          "text": "وَٱلْمَغْرِبِ"
        },
        {
          "word_index": 8,
          "text": "وَلَـٰكِنَّ"
        },
        {
          "word_index": 9,
          "text": "ٱلْبِرَّ"
        },
        {
          "word_index": 10,
          "text": "مَنْ"
        },
        {
          "word_index": 11,
          "text": "ءَامَنَ"
        },
        {
          "word_index": 12,
          "text": "بِٱللَّهِ"
        },
        {
          "word_index": 13,
          "text": "وَٱلْيَوْمِ"
        },
        {
          "word_index": 14,
          "text": "ٱلْـَٔاخِرِ"
        },
        {
          "word_index": 15,
          "text": "وَٱلْمَلَـٰٓئِكَةِ"
        },
        {
          "word_index": 16,
          "text": "وَٱلْكِتَـٰبِ"
        },
        {
          "word_index": 17,
          "text": "وَٱلنَّبِيِّـۧنَ"
        },
        {
          "word_index": 18,
          "text": "وَءَاتَى"
        },
        {
          "word_index": 19,
          "text": "ٱلْمَالَ"
        },
        {
          "word_index": 20,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 21,
          "text": "حُبِّهِۦ"
        },
        {
          "word_index": 22,
          "text": "ذَوِى"
        },
        {
          "word_index": 23,
          "text": "ٱلْقُرْبَىٰ"
        },
        {
          "word_index": 24,
          "text": "وَٱلْيَتَـٰمَىٰ"
        },
        {
          "word_index": 25,
          "text": "وَٱلْمَسَـٰكِينَ"
        },
        {
          "word_index": 26,
          "text": "وَٱبْنَ"
