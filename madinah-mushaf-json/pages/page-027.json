        {
          "word_index": 32,
          "text": "ٱلصَّلَوٰةَ"
        },
        {
          "word_index": 33,
          "text": "وَءَاتَى"
        },
        {
          "word_index": 34,
          "text": "ٱلزَّكَوٰةَ"
        },
        {
          "word_index": 35,
          "text": "وَٱلْمُوفُونَ"
        },
        {
          "word_index": 36,
          "text": "بِعَهْدِهِمْ"
