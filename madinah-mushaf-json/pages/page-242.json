        {
          "word_index": 2,
          "text": "بِجَهَازِهِمْ"
        },
        {
          "word_index": 3,
          "text": "قَالَ"
        },
        {
          "word_index": 4,
          "text": "ٱئْتُونِى"
        },
        {
          "word_index": 5,
          "text": "بِأَخٍۢ"
        },
        {
          "word_index": 6,
          "text": "لَّكُم"
        },
        {
          "word_index": 7,
          "text": "مِّنْ"
        },
        {
          "word_index": 8,
          "text": "أَبِيكُمْ ۚ"
        },
        {
          "word_index": 9,
          "text": "أَلَا"
        },
        {
          "word_index": 10,
          "text": "تَرَوْنَ"
        },
        {
