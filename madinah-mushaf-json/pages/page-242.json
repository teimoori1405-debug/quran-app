  "verses": [
    {
      "surah_number": 12,
      "ayah_number": 53,
      "words": [
        {
          "word_index": 0,
          "text": "۞ وَمَآ"
        },
        {
          "word_index": 1,
          "text": "أُبَرِّئُ"
        },
        {
          "word_index": 2,
          "text": "نَفْسِىٓ ۚ"
        },
        {
          "word_index": 3,
          "text": "إِنَّ"
        },
        {
          "word_index": 4,
          "text": "ٱلنَّفْسَ"
        },
        {
          "word_index": 5,
          "text": "لَأَمَّارَةٌۢ"
        },
        {
          "word_index": 6,
          "text": "بِٱلسُّوٓءِ"
        },
        {
          "word_index": 7,
          "text": "إِلَّا"
        },
        {
          "word_index": 8,
          "text": "مَا"
        },
        {
          "word_index": 9,
          "text": "رَحِمَ"
        },
        {
          "word_index": 10,
          "text": "رَبِّىٓ ۚ"
        },
        {
          "word_index": 11,
          "text": "إِنَّ"
        },
        {
          "word_index": 12,
          "text": "رَبِّى"
        },
        {
          "word_index": 13,
          "text": "غَفُورٌۭ"
        },
        {
          "word_index": 14,
          "text": "رَّحِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 54,
      "words": [
        {
          "word_index": 0,
          "text": "وَقَالَ"
        },
        {
          "word_index": 1,
          "text": "ٱلْمَلِكُ"
        },
        {
          "word_index": 2,
          "text": "ٱئْتُونِى"
        },
        {
          "word_index": 3,
          "text": "بِهِۦٓ"
        },
        {
          "word_index": 4,
          "text": "أَسْتَخْلِصْهُ"
        },
        {
          "word_index": 5,
          "text": "لِنَفْسِى ۖ"
        },
        {
          "word_index": 6,
          "text": "فَلَمَّا"
        },
        {
          "word_index": 7,
          "text": "كَلَّمَهُۥ"
        },
        {
          "word_index": 8,
          "text": "قَالَ"
        },
        {
          "word_index": 9,
          "text": "إِنَّكَ"
        },
        {
          "word_index": 10,
          "text": "ٱلْيَوْمَ"
        },
        {
          "word_index": 11,
          "text": "لَدَيْنَا"
        },
        {
          "word_index": 12,
          "text": "مَكِينٌ"
        },
        {
          "word_index": 13,
          "text": "أَمِينٌۭ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 55,
      "words": [
        {
          "word_index": 0,
          "text": "قَالَ"
        },
        {
          "word_index": 1,
          "text": "ٱجْعَلْنِى"
        },
        {
          "word_index": 2,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 3,
          "text": "خَزَآئِنِ"
        },
        {
          "word_index": 4,
          "text": "ٱلْأَرْضِ ۖ"
        },
        {
          "word_index": 5,
          "text": "إِنِّى"
        },
        {
          "word_index": 6,
          "text": "حَفِيظٌ"
        },
        {
          "word_index": 7,
          "text": "عَلِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 56,
      "words": [
        {
          "word_index": 0,
          "text": "وَكَذَٰلِكَ"
        },
        {
          "word_index": 1,
          "text": "مَكَّنَّا"
        },
        {
          "word_index": 2,
          "text": "لِيُوسُفَ"
        },
        {
          "word_index": 3,
          "text": "فِى"
        },
        {
          "word_index": 4,
          "text": "ٱلْأَرْضِ"
        },
        {
          "word_index": 5,
          "text": "يَتَبَوَّأُ"
        },
        {
          "word_index": 6,
          "text": "مِنْهَا"
        },
        {
          "word_index": 7,
          "text": "حَيْثُ"
        },
        {
          "word_index": 8,
          "text": "يَشَآءُ ۚ"
        },
        {
          "word_index": 9,
          "text": "نُصِيبُ"
        },
        {
          "word_index": 10,
          "text": "بِرَحْمَتِنَا"
        },
        {
          "word_index": 11,
          "text": "مَن"
        },
        {
          "word_index": 12,
          "text": "نَّشَآءُ ۖ"
        },
        {
          "word_index": 13,
          "text": "وَلَا"
        },
        {
          "word_index": 14,
          "text": "نُضِيعُ"
        },
        {
          "word_index": 15,
          "text": "أَجْرَ"
        },
        {
          "word_index": 16,
          "text": "ٱلْمُحْسِنِينَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 57,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَأَجْرُ"
        },
        {
          "word_index": 1,
          "text": "ٱلْـَٔاخِرَةِ"
        },
        {
          "word_index": 2,
          "text": "خَيْرٌۭ"
        },
        {
          "word_index": 3,
          "text": "لِّلَّذِينَ"
        },
        {
          "word_index": 4,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 5,
          "text": "وَكَانُوا۟"
        },
        {
          "word_index": 6,
          "text": "يَتَّقُونَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 58,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَآءَ"
        },
        {
          "word_index": 1,
          "text": "إِخْوَةُ"
        },
        {
          "word_index": 2,
          "text": "يُوسُفَ"
        },
        {
          "word_index": 3,
          "text": "فَدَخَلُوا۟"
        },
        {
          "word_index": 4,
          "text": "عَلَيْهِ"
        },
        {
          "word_index": 5,
          "text": "فَعَرَفَهُمْ"
        },
        {
          "word_index": 6,
          "text": "وَهُمْ"
        },
        {
          "word_index": 7,
          "text": "لَهُۥ"
        },
        {
          "word_index": 8,
          "text": "مُنكِرُونَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 59,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَمَّا"
        },
