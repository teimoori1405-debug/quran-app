          "text": "أَنِّىٓ"
        },
        {
          "word_index": 12,
          "text": "أُوفِى"
        },
        {
          "word_index": 13,
          "text": "ٱلْكَيْلَ"
        },
        {
          "word_index": 14,
          "text": "وَأَنَا۠"
        },
        {
          "word_index": 15,
          "text": "خَيْرُ"
        },
        {
          "word_index": 16,
          "text": "ٱلْمُنزِلِينَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 60,
      "words": [
        {
          "word_index": 0,
          "text": "فَإِن"
        },
        {
          "word_index": 1,
          "text": "لَّمْ"
        },
        {
          "word_index": 2,
          "text": "تَأْتُونِى"
