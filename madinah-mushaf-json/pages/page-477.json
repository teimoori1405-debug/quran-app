      "ayah_number": 1,
      "words": [
        {
          "word_index": 0,
          "text": "حمٓ"
        }
      ]
    },
    {
      "surah_number": 41,
      "ayah_number": 2,
      "words": [
        {
          "word_index": 0,
          "text": "تَنزِيلٌۭ"
        },
        {
          "word_index": 1,
          "text": "مِّنَ"
        },
        {
          "word_index": 2,
          "text": "ٱلرَّحْمَـٰنِ"
        },
        {
          "word_index": 3,
          "text": "ٱلرَّحِيمِ"
        }
      ]
    },
    {
      "surah_number": 41,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "كِتَـٰبٌۭ"
        },
        {
          "word_index": 1,
          "text": "فُصِّلَتْ"
        },
        {
          "word_index": 2,
          "text": "ءَايَـٰتُهُۥ"
        },
        {
          "word_index": 3,
          "text": "قُرْءَانًا"
        },
        {
          "word_index": 4,
          "text": "عَرَبِيًّۭا"
        },
        {
          "word_index": 5,
          "text": "لِّقَوْمٍۢ"
        },
        {
          "word_index": 6,
          "text": "يَعْلَمُونَ"
        }
      ]
    },
    {
      "surah_number": 41,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "بَشِيرًۭا"
        },
        {
          "word_index": 1,
          "text": "وَنَذِيرًۭا"
        },
        {
          "word_index": 2,
          "text": "فَأَعْرَضَ"
        },
        {
          "word_index": 3,
          "text": "أَكْثَرُهُمْ"
        },
        {
          "word_index": 4,
          "text": "فَهُمْ"
        },
        {
          "word_index": 5,
          "text": "لَا"
        },
        {
          "word_index": 6,
          "text": "يَسْمَعُونَ"
        }
      ]
    },
    {
      "surah_number": 41,
      "ayah_number": 5,
      "words": [
        {
          "word_index": 0,
          "text": "وَقَالُوا۟"
        },
        {
          "word_index": 1,
          "text": "قُلُوبُنَا"
        },
        {
          "word_index": 2,
          "text": "فِىٓ"
        },
        {
          "word_index": 3,
          "text": "أَكِنَّةٍۢ"
        },
        {
          "word_index": 4,
          "text": "مِّمَّا"
        },
        {
          "word_index": 5,
          "text": "تَدْعُونَآ"
        },
        {
          "word_index": 6,
          "text": "إِلَيْهِ"
        },
        {
          "word_index": 7,
          "text": "وَفِىٓ"
        },
        {
          "word_index": 8,
          "text": "ءَاذَانِنَا"
        },
        {
          "word_index": 9,
          "text": "وَقْرٌۭ"
        },
        {
          "word_index": 10,
          "text": "وَمِنۢ"
        },
        {
          "word_index": 11,
          "text": "بَيْنِنَا"
        },
        {
          "word_index": 12,
          "text": "وَبَيْنِكَ"
        },
        {
          "word_index": 13,
          "text": "حِجَابٌۭ"
        },
        {
          "word_index": 14,
          "text": "فَٱعْمَلْ"
        },
        {
          "word_index": 15,
          "text": "إِنَّنَا"
        },
        {
          "word_index": 16,
          "text": "عَـٰمِلُونَ"
        }
      ]
    },
    {
      "surah_number": 41,
      "ayah_number": 6,
      "words": [
        {
          "word_index": 0,
          "text": "قُلْ"
        },
        {
          "word_index": 1,
          "text": "إِنَّمَآ"
        },
        {
          "word_index": 2,
          "text": "أَنَا۠"
        },
        {
          "word_index": 3,
          "text": "بَشَرٌۭ"
        },
        {
          "word_index": 4,
          "text": "مِّثْلُكُمْ"
        },
        {
          "word_index": 5,
          "text": "يُوحَىٰٓ"
        },
        {
          "word_index": 6,
          "text": "إِلَىَّ"
        },
        {
          "word_index": 7,
          "text": "أَنَّمَآ"
        },
        {
          "word_index": 8,
          "text": "إِلَـٰهُكُمْ"
        },
        {
          "word_index": 9,
          "text": "إِلَـٰهٌۭ"
        },
        {
          "word_index": 10,
          "text": "وَٰحِدٌۭ"
        },
        {
          "word_index": 11,
          "text": "فَٱسْتَقِيمُوٓا۟"
