          "word_index": 14,
          "text": "فَلَهُمْ"
        },
        {
          "word_index": 15,
          "text": "أَجْرُهُمْ"
        },
        {
          "word_index": 16,
          "text": "عِندَ"
        },
        {
          "word_index": 17,
          "text": "رَبِّهِمْ"
        },
        {
          "word_index": 18,
          "text": "وَلَا"
        },
        {
          "word_index": 19,
          "text": "خَوْفٌ"
        },
        {
          "word_index": 20,
          "text": "عَلَيْهِمْ"
        },
        {
          "word_index": 21,
          "text": "وَلَا"
