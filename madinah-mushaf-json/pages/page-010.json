          "text": "يَحْزَنُونَ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 63,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِذْ"
        },
        {
          "word_index": 1,
          "text": "أَخَذْنَا"
        },
        {
          "word_index": 2,
          "text": "مِيثَـٰقَكُمْ"
        },
        {
          "word_index": 3,
          "text": "وَرَفَعْنَا"
        },
        {
          "word_index": 4,
          "text": "فَوْقَكُمُ"
        },
        {
          "word_index": 5,
          "text": "ٱلطُّورَ"
        },
        {
          "word_index": 6,
          "text": "خُذُوا۟"
