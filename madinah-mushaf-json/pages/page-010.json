          "text": "هَادُوا۟"
        },
        {
          "word_index": 5,
          "text": "وَٱلنَّصَـٰرَىٰ"
        },
        {
          "word_index": 6,
          "text": "وَٱلصَّـٰبِـِٔينَ"
        },
        {
          "word_index": 7,
          "text": "مَنْ"
        },
        {
          "word_index": 8,
          "text": "ءَامَنَ"
        },
        {
          "word_index": 9,
          "text": "بِٱللَّهِ"
        },
        {
          "word_index": 10,
          "text": "وَٱلْيَوْمِ"
        },
        {
          "word_index": 11,
          "text": "ٱلْـَٔاخِرِ"
        },
        {
          "word_index": 12,
          "text": "وَعَمِلَ"
