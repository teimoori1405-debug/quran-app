  "verses": [
    {
      "surah_number": 45,
      "ayah_number": 14,
      "words": [
        {
          "word_index": 0,
          "text": "قُل"
        },
        {
          "word_index": 1,
          "text": "لِّلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 3,
          "text": "يَغْفِرُوا۟"
        },
        {
          "word_index": 4,
          "text": "لِلَّذِينَ"
        },
        {
          "word_index": 5,
          "text": "لَا"
        },
        {
          "word_index": 6,
          "text": "يَرْجُونَ"
        },
        {
          "word_index": 7,
          "text": "أَيَّامَ"
        },
        {
          "word_index": 8,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 9,
          "text": "لِيَجْزِىَ"
        },
        {
          "word_index": 10,
          "text": "قَوْمًۢا"
        },
        {
          "word_index": 11,
          "text": "بِمَا"
        },
        {
          "word_index": 12,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 13,
          "text": "يَكْسِبُونَ"
        }
      ]
    },
    {
      "surah_number": 45,
      "ayah_number": 15,
      "words": [
        {
          "word_index": 0,
          "text": "مَنْ"
        },
        {
          "word_index": 1,
          "text": "عَمِلَ"
        },
        {
          "word_index": 2,
          "text": "صَـٰلِحًۭا"
        },
        {
          "word_index": 3,
          "text": "فَلِنَفْسِهِۦ ۖ"
        },
        {
          "word_index": 4,
          "text": "وَمَنْ"
        },
        {
          "word_index": 5,
          "text": "أَسَآءَ"
        },
        {
          "word_index": 6,
          "text": "فَعَلَيْهَا ۖ"
        },
        {
          "word_index": 7,
          "text": "ثُمَّ"
        },
        {
          "word_index": 8,
          "text": "إِلَىٰ"
        },
        {
          "word_index": 9,
          "text": "رَبِّكُمْ"
        },
        {
          "word_index": 10,
          "text": "تُرْجَعُونَ"
        }
      ]
    },
    {
      "surah_number": 45,
      "ayah_number": 16,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
