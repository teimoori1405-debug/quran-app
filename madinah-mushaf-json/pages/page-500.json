          "text": "بَنِىٓ"
        },
        {
          "word_index": 3,
          "text": "إِسْرَٰٓءِيلَ"
        },
        {
          "word_index": 4,
          "text": "ٱلْكِتَـٰبَ"
        },
        {
          "word_index": 5,
          "text": "وَٱلْحُكْمَ"
        },
        {
          "word_index": 6,
          "text": "وَٱلنُّبُوَّةَ"
        },
        {
          "word_index": 7,
          "text": "وَرَزَقْنَـٰهُم"
