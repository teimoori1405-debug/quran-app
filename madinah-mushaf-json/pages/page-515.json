          "text": "رَّسُولُ"
        },
        {
          "word_index": 2,
          "text": "ٱللَّهِ ۚ"
        },
        {
          "word_index": 3,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 4,
          "text": "مَعَهُۥٓ"
        },
        {
          "word_index": 5,
          "text": "أَشِدَّآءُ"
        },
        {
          "word_index": 6,
          "text": "عَلَى"
        },
        {
          "word_index": 7,
          "text": "ٱلْكُفَّارِ"
