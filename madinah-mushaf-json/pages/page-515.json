          "text": "مَثَلُهُمْ"
        },
        {
          "word_index": 26,
          "text": "فِى"
        },
        {
          "word_index": 27,
          "text": "ٱلتَّوْرَىٰةِ ۚ"
        },
        {
          "word_index": 28,
          "text": "وَمَثَلُهُمْ"
