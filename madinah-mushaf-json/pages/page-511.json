      "words": [
        {
          "word_index": 0,
          "text": "إِنَّا"
        },
        {
          "word_index": 1,
          "text": "فَتَحْنَا"
        },
        {
          "word_index": 2,
          "text": "لَكَ"
        },
        {
          "word_index": 3,
          "text": "فَتْحًۭا"
        },
        {
          "word_index": 4,
          "text": "مُّبِينًۭا"
        }
      ]
    },
    {
      "surah_number": 48,
      "ayah_number": 2,
      "words": [
        {
          "word_index": 0,
          "text": "لِّيَغْفِرَ"
        },
        {
          "word_index": 1,
          "text": "لَكَ"
        },
        {
          "word_index": 2,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 3,
          "text": "مَا"
        },
        {
          "word_index": 4,
          "text": "تَقَدَّمَ"
        },
        {
          "word_index": 5,
          "text": "مِن"
        },
        {
          "word_index": 6,
          "text": "ذَنۢبِكَ"
        },
        {
          "word_index": 7,
          "text": "وَمَا"
        },
        {
          "word_index": 8,
          "text": "تَأَخَّرَ"
        },
        {
          "word_index": 9,
          "text": "وَيُتِمَّ"
        },
        {
          "word_index": 10,
          "text": "نِعْمَتَهُۥ"
        },
        {
          "word_index": 11,
          "text": "عَلَيْكَ"
        },
        {
          "word_index": 12,
          "text": "وَيَهْدِيَكَ"
        },
        {
          "word_index": 13,
          "text": "صِرَٰطًۭا"
        },
        {
          "word_index": 14,
          "text": "مُّسْتَقِيمًۭا"
        }
      ]
    },
    {
      "surah_number": 48,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "وَيَنصُرَكَ"
        },
        {
          "word_index": 1,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 2,
          "text": "نَصْرًا"
        },
        {
          "word_index": 3,
          "text": "عَزِيزًا"
        }
      ]
    },
    {
      "surah_number": 48,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "هُوَ"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِىٓ"
        },
        {
          "word_index": 2,
          "text": "أَنزَلَ"
        },
        {
          "word_index": 3,
          "text": "ٱلسَّكِينَةَ"
        },
        {
          "word_index": 4,
          "text": "فِى"
        },
        {
          "word_index": 5,
          "text": "قُلُوبِ"
        },
        {
          "word_index": 6,
          "text": "ٱلْمُؤْمِنِينَ"
        },
        {
          "word_index": 7,
          "text": "لِيَزْدَادُوٓا۟"
        },
        {
          "word_index": 8,
          "text": "إِيمَـٰنًۭا"
        },
        {
          "word_index": 9,
          "text": "مَّعَ"
        },
        {
          "word_index": 10,
          "text": "إِيمَـٰنِهِمْ ۗ"
        },
        {
          "word_index": 11,
          "text": "وَلِلَّهِ"
        },
        {
          "word_index": 12,
          "text": "جُنُودُ"
        },
        {
          "word_index": 13,
          "text": "ٱلسَّمَـٰوَٰتِ"
        },
        {
          "word_index": 14,
          "text": "وَٱلْأَرْضِ ۚ"
        },
        {
          "word_index": 15,
          "text": "وَكَانَ"
        },
        {
          "word_index": 16,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 17,
          "text": "عَلِيمًا"
        },
        {
          "word_index": 18,
          "text": "حَكِيمًۭا"
        }
      ]
    },
    {
      "surah_number": 48,
      "ayah_number": 5,
      "words": [
        {
          "word_index": 0,
          "text": "لِّيُدْخِلَ"
        },
        {
          "word_index": 1,
          "text": "ٱلْمُؤْمِنِينَ"
        },
        {
          "word_index": 2,
          "text": "وَٱلْمُؤْمِنَـٰتِ"
        },
        {
          "word_index": 3,
          "text": "جَنَّـٰتٍۢ"
        },
        {
          "word_index": 4,
          "text": "تَجْرِى"
        },
        {
          "word_index": 5,
          "text": "مِن"
        },
        {
          "word_index": 6,
          "text": "تَحْتِهَا"
        },
        {
          "word_index": 7,
          "text": "ٱلْأَنْهَـٰرُ"
        },
        {
          "word_index": 8,
          "text": "خَـٰلِدِينَ"
        },
        {
          "word_index": 9,
          "text": "فِيهَا"
        },
        {
          "word_index": 10,
          "text": "وَيُكَفِّرَ"
