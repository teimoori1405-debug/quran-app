        {
          "word_index": 11,
          "text": "عَنْهُمْ"
        },
        {
          "word_index": 12,
          "text": "سَيِّـَٔاتِهِمْ ۚ"
        },
        {
          "word_index": 13,
          "text": "وَكَانَ"
        },
        {
          "word_index": 14,
          "text": "ذَٰلِكَ"
        },
        {
          "word_index": 15,
          "text": "عِندَ"
        },
        {
          "word_index": 16,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 17,
          "text": "فَوْزًا"
        },
        {
          "word_index": 18,
          "text": "عَظِيمًۭا"
        }
      ]
    },
    {
      "surah_number": 48,
      "ayah_number": 6,
      "words": [
        {
          "word_index": 0,
          "text": "وَيُعَذِّبَ"
