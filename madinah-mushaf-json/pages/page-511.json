          "word_index": 3,
          "text": "وَٱلْمُشْرِكِينَ"
        },
        {
          "word_index": 4,
          "text": "وَٱلْمُشْرِكَـٰتِ"
        },
        {
          "word_index": 5,
          "text": "ٱلظَّآنِّينَ"
