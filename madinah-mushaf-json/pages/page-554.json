{
  "page": 554,
  "verses": [
    {
      "surah_number": 62,
      "ayah_number": 9,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوٓا۟"
        },
        {
          "word_index": 3,
          "text": "إِذَا"
        },
        {
          "word_index": 4,
          "text": "نُودِىَ"
        },
        {
          "word_index": 5,
          "text": "لِلصَّلَوٰةِ"
        },
        {
          "word_index": 6,
          "text": "مِن"
        },
        {
          "word_index": 7,
          "text": "يَوْمِ"
        },
        {
          "word_index": 8,
          "text": "ٱلْجُمُعَةِ"
        },
        {
          "word_index": 9,
          "text": "فَٱسْعَوْا۟"
        },
        {
          "word_index": 10,
          "text": "إِلَىٰ"
        },
        {
          "word_index": 11,
          "text": "ذِكْرِ"
        },
        {
          "word_index": 12,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 13,
          "text": "وَذَرُوا۟"
        },
        {
          "word_index": 14,
          "text": "ٱلْبَيْعَ ۚ"
        },
        {
          "word_index": 15,
          "text": "ذَٰلِكُمْ"
        },
        {
          "word_index": 16,
          "text": "خَيْرٌۭ"
        },
        {
          "word_index": 17,
          "text": "لَّكُمْ"
        },
        {
          "word_index": 18,
          "text": "إِن"
        },
        {
          "word_index": 19,
          "text": "كُنتُمْ"
        },
        {
          "word_index": 20,
          "text": "تَعْلَمُونَ"
        }
      ]
    },
    {
      "surah_number": 62,
      "ayah_number": 10,
      "words": [
        {
          "word_index": 0,
          "text": "فَإِذَا"
        },
        {
          "word_index": 1,
          "text": "قُضِيَتِ"
        },
        {
          "word_index": 2,
          "text": "ٱلصَّلَوٰةُ"
        },
        {
          "word_index": 3,
          "text": "فَٱنتَشِرُوا۟"
        },
        {
          "word_index": 4,
          "text": "فِى"
        },
        {
          "word_index": 5,
          "text": "ٱلْأَرْضِ"
        },
        {
          "word_index": 6,
          "text": "وَٱبْتَغُوا۟"
        },
        {
          "word_index": 7,
          "text": "مِن"
        },
        {
          "word_index": 8,
          "text": "فَضْلِ"
        },
        {
          "word_index": 9,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 10,
          "text": "وَٱذْكُرُوا۟"
        },
        {
          "word_index": 11,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 12,
          "text": "كَثِيرًۭا"
        },
        {
          "word_index": 13,
          "text": "لَّعَلَّكُمْ"
        },
        {
          "word_index": 14,
          "text": "تُفْلِحُونَ"
        }
      ]
    },
    {
      "surah_number": 62,
      "ayah_number": 11,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِذَا"
        },
        {
          "word_index": 1,
          "text": "رَأَوْا۟"
        },
        {
          "word_index": 2,
          "text": "تِجَـٰرَةً"
        },
        {
          "word_index": 3,
          "text": "أَوْ"
        },
        {
          "word_index": 4,
          "text": "لَهْوًا"
        },
        {
          "word_index": 5,
          "text": "ٱنفَضُّوٓا۟"
        },
        {
          "word_index": 6,
          "text": "إِلَيْهَا"
        },
        {
          "word_index": 7,
          "text": "وَتَرَكُوكَ"
        },
        {
          "word_index": 8,
          "text": "قَآئِمًۭا ۚ"
