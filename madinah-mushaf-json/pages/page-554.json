        {
          "word_index": 9,
          "text": "قُلْ"
        },
        {
          "word_index": 10,
          "text": "مَا"
        },
        {
          "word_index": 11,
          "text": "عِندَ"
        },
        {
          "word_index": 12,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 13,
          "text": "خَيْرٌۭ"
        },
        {
          "word_index": 14,
          "text": "مِّنَ"
        },
        {
          "word_index": 15,
          "text": "ٱللَّهْوِ"
        },
        {
          "word_index": 16,
          "text": "وَمِنَ"
        },
        {
          "word_index": 17,
          "text": "ٱلتِّجَـٰرَةِ ۚ"
        },
        {
          "word_index": 18,
          "text": "وَٱللَّهُ"
        },
        {
          "word_index": 19,
          "text": "خَيْرُ"
        },
        {
