          "word_index": 22,
          "text": "إِنَّ"
        },
        {
          "word_index": 23,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 24,
          "text": "عَزِيزٌ"
        },
        {
          "word_index": 25,
          "text": "حَكِيمٌۭ"
        }
      ]
    },
    {
