      "words": [
        {
          "word_index": 0,
          "text": "فِى"
        },
        {
          "word_index": 1,
          "text": "ٱلدُّنْيَا"
        },
        {
          "word_index": 2,
          "text": "وَٱلْـَٔاخِرَةِ ۗ"
        },
        {
          "word_index": 3,
          "text": "وَيَسْـَٔلُونَكَ"
        },
        {
          "word_index": 4,
          "text": "عَنِ"
        },
        {
          "word_index": 5,
          "text": "ٱلْيَتَـٰمَىٰ ۖ"
        },
        {
          "word_index": 6,
          "text": "قُلْ"
        },
        {
          "word_index": 7,
          "text": "إِصْلَاحٌۭ"
        },
        {
          "word_index": 8,
          "text": "لَّهُمْ"
        },
        {
          "word_index": 9,
          "text": "خَيْرٌۭ ۖ"
        },
        {
          "word_index": 10,
          "text": "وَإِن"
        },
        {
          "word_index": 11,
          "text": "تُخَالِطُوهُمْ"
        },
        {
          "word_index": 12,
          "text": "فَإِخْوَٰنُكُمْ ۚ"
        },
        {
          "word_index": 13,
          "text": "وَٱللَّهُ"
        },
        {
          "word_index": 14,
          "text": "يَعْلَمُ"
        },
        {
          "word_index": 15,
          "text": "ٱلْمُفْسِدَ"
        },
        {
          "word_index": 16,
          "text": "مِنَ"
        },
        {
          "word_index": 17,
          "text": "ٱلْمُصْلِحِ ۚ"
        },
        {
          "word_index": 18,
          "text": "وَلَوْ"
        },
        {
          "word_index": 19,
          "text": "شَآءَ"
        },
        {
