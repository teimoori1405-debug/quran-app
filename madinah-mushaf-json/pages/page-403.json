  "verses": [
    {
      "surah_number": 29,
      "ayah_number": 53,
      "words": [
        {
          "word_index": 0,
          "text": "وَيَسْتَعْجِلُونَكَ"
        },
        {
          "word_index": 1,
          "text": "بِٱلْعَذَابِ ۚ"
        },
        {
          "word_index": 2,
          "text": "وَلَوْلَآ"
        },
        {
          "word_index": 3,
          "text": "أَجَلٌۭ"
        },
        {
          "word_index": 4,
          "text": "مُّسَمًّۭى"
        },
        {
          "word_index": 5,
          "text": "لَّجَآءَهُمُ"
        },
        {
          "word_index": 6,
          "text": "ٱلْعَذَابُ"
        },
        {
          "word_index": 7,
          "text": "وَلَيَأْتِيَنَّهُم"
        },
        {
          "word_index": 8,
          "text": "بَغْتَةًۭ"
        },
        {
          "word_index": 9,
          "text": "وَهُمْ"
        },
        {
          "word_index": 10,
          "text": "لَا"
        },
        {
          "word_index": 11,
          "text": "يَشْعُرُونَ"
        }
      ]
    },
    {
      "surah_number": 29,
      "ayah_number": 54,
      "words": [
        {
