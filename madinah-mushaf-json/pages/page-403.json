        {
          "word_index": 5,
          "text": "وَمِن"
        },
        {
          "word_index": 6,
          "text": "تَحْتِ"
        },
        {
          "word_index": 7,
          "text": "أَرْجُلِهِمْ"
        },
        {
          "word_index": 8,
          "text": "وَيَقُولُ"
        },
        {
          "word_index": 9,
          "text": "ذُوقُوا۟"
