{
  "page": 171,
  "verses": [
    {
      "surah_number": 7,
      "ayah_number": 160,
      "words": [
        {
          "word_index": 0,
          "text": "وَقَطَّعْنَـٰهُمُ"
        },
        {
          "word_index": 1,
          "text": "ٱثْنَتَىْ"
        },
        {
          "word_index": 2,
          "text": "عَشْرَةَ"
        },
        {
          "word_index": 3,
          "text": "أَسْبَاطًا"
        },
        {
          "word_index": 4,
          "text": "أُمَمًۭا ۚ"
        },
        {
          "word_index": 5,
          "text": "وَأَوْحَيْنَآ"
        },
        {
          "word_index": 6,
          "text": "إِلَىٰ"
        },
        {
          "word_index": 7,
          "text": "مُوسَىٰٓ"
        },
        {
          "word_index": 8,
          "text": "إِذِ"
        },
        {
          "word_index": 9,
          "text": "ٱسْتَسْقَىٰهُ"
        },
        {
          "word_index": 10,
          "text": "قَوْمُهُۥٓ"
        },
        {
          "word_index": 11,
          "text": "أَنِ"
        },
        {
          "word_index": 12,
          "text": "ٱضْرِب"
        },
        {
          "word_index": 13,
          "text": "بِّعَصَاكَ"
        },
        {
          "word_index": 14,
          "text": "ٱلْحَجَرَ ۖ"
        },
        {
          "word_index": 15,
          "text": "فَٱنۢبَجَسَتْ"
        },
        {
          "word_index": 16,
          "text": "مِنْهُ"
        },
        {
          "word_index": 17,
          "text": "ٱثْنَتَا"
        },
        {
          "word_index": 18,
          "text": "عَشْرَةَ"
        },
        {
          "word_index": 19,
          "text": "عَيْنًۭا ۖ"
        },
        {
          "word_index": 20,
          "text": "قَدْ"
        },
        {
          "word_index": 21,
          "text": "عَلِمَ"
        },
        {
          "word_index": 22,
          "text": "كُلُّ"
        },
        {
          "word_index": 23,
          "text": "أُنَاسٍۢ"
        },
        {
          "word_index": 24,
          "text": "مَّشْرَبَهُمْ ۚ"
        },
        {
          "word_index": 25,
          "text": "وَظَلَّلْنَا"
        },
        {
          "word_index": 26,
          "text": "عَلَيْهِمُ"
        },
        {
          "word_index": 27,
          "text": "ٱلْغَمَـٰمَ"
        },
        {
          "word_index": 28,
          "text": "وَأَنزَلْنَا"
        },
        {
          "word_index": 29,
          "text": "عَلَيْهِمُ"
        },
        {
          "word_index": 30,
          "text": "ٱلْمَنَّ"
        },
        {
          "word_index": 31,
          "text": "وَٱلسَّلْوَىٰ ۖ"
        },
        {
          "word_index": 32,
          "text": "كُلُوا۟"
        },
        {
          "word_index": 33,
          "text": "مِن"
        },
        {
          "word_index": 34,
          "text": "طَيِّبَـٰتِ"
        },
        {
          "word_index": 35,
          "text": "مَا"
        },
        {
          "word_index": 36,
          "text": "رَزَقْنَـٰكُمْ ۚ"
        },
        {
          "word_index": 37,
          "text": "وَمَا"
        },
        {
          "word_index": 38,
          "text": "ظَلَمُونَا"
        },
        {
          "word_index": 39,
          "text": "وَلَـٰكِن"
        },
        {
          "word_index": 40,
          "text": "كَانُوٓا۟"
        },
        {
          "word_index": 41,
          "text": "أَنفُسَهُمْ"
        },
        {
          "word_index": 42,
          "text": "يَظْلِمُونَ"
        }
      ]
    },
    {
