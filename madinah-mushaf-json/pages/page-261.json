        {
          "word_index": 3,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 4,
          "text": "ظَلَمُوٓا۟"
        },
        {
          "word_index": 5,
          "text": "أَنفُسَهُمْ"
        },
        {
          "word_index": 6,
          "text": "وَتَبَيَّنَ"
