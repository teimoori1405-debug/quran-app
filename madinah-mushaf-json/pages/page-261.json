  "verses": [
    {
      "surah_number": 14,
      "ayah_number": 43,
      "words": [
        {
          "word_index": 0,
          "text": "مُهْطِعِينَ"
        },
        {
          "word_index": 1,
          "text": "مُقْنِعِى"
        },
        {
          "word_index": 2,
          "text": "رُءُوسِهِمْ"
        },
        {
          "word_index": 3,
          "text": "لَا"
        },
        {
          "word_index": 4,
          "text": "يَرْتَدُّ"
        },
        {
          "word_index": 5,
          "text": "إِلَيْهِمْ"
        },
        {
          "word_index": 6,
          "text": "طَرْفُهُمْ ۖ"
        },
        {
          "word_index": 7,
          "text": "وَأَفْـِٔدَتُهُمْ"
        },
        {
          "word_index": 8,
          "text": "هَوَآءٌۭ"
        }
      ]
    },
    {
      "surah_number": 14,
      "ayah_number": 44,
      "words": [
        {
          "word_index": 0,
          "text": "وَأَنذِرِ"
        },
        {
          "word_index": 1,
          "text": "ٱلنَّاسَ"
        },
        {
          "word_index": 2,
          "text": "يَوْمَ"
        },
        {
          "word_index": 3,
          "text": "يَأْتِيهِمُ"
        },
        {
          "word_index": 4,
          "text": "ٱلْعَذَابُ"
        },
        {
          "word_index": 5,
          "text": "فَيَقُولُ"
        },
        {
          "word_index": 6,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 7,
          "text": "ظَلَمُوا۟"
        },
        {
          "word_index": 8,
          "text": "رَبَّنَآ"
        },
        {
          "word_index": 9,
          "text": "أَخِّرْنَآ"
        },
        {
          "word_index": 10,
          "text": "إِلَىٰٓ"
        },
        {
          "word_index": 11,
          "text": "أَجَلٍۢ"
        },
        {
          "word_index": 12,
          "text": "قَرِيبٍۢ"
        },
        {
          "word_index": 13,
          "text": "نُّجِبْ"
        },
        {
          "word_index": 14,
          "text": "دَعْوَتَكَ"
        },
        {
          "word_index": 15,
          "text": "وَنَتَّبِعِ"
        },
        {
          "word_index": 16,
          "text": "ٱلرُّسُلَ ۗ"
        },
        {
          "word_index": 17,
          "text": "أَوَلَمْ"
        },
        {
          "word_index": 18,
          "text": "تَكُونُوٓا۟"
        },
        {
          "word_index": 19,
          "text": "أَقْسَمْتُم"
        },
        {
          "word_index": 20,
          "text": "مِّن"
        },
        {
          "word_index": 21,
          "text": "قَبْلُ"
        },
        {
          "word_index": 22,
          "text": "مَا"
        },
        {
          "word_index": 23,
          "text": "لَكُم"
        },
        {
          "word_index": 24,
          "text": "مِّن"
        },
        {
          "word_index": 25,
          "text": "زَوَالٍۢ"
        }
      ]
    },
    {
      "surah_number": 14,
      "ayah_number": 45,
      "words": [
        {
          "word_index": 0,
          "text": "وَسَكَنتُمْ"
