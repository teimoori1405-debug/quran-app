          "word_index": 4,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 5,
          "text": "مَكْرُهُمْ"
        },
        {
          "word_index": 6,
          "text": "وَإِن"
        },
        {
          "word_index": 7,
          "text": "كَانَ"
