  "verses": [
    {
      "surah_number": 4,
      "ayah_number": 34,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلرِّجَالُ"
        },
        {
          "word_index": 1,
          "text": "قَوَّٰمُونَ"
        },
        {
          "word_index": 2,
          "text": "عَلَى"
        },
        {
          "word_index": 3,
          "text": "ٱلنِّسَآءِ"
        },
        {
          "word_index": 4,
          "text": "بِمَا"
        },
        {
          "word_index": 5,
          "text": "فَضَّلَ"
        },
        {
          "word_index": 6,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 7,
          "text": "بَعْضَهُمْ"
        },
        {
          "word_index": 8,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 9,
          "text": "بَعْضٍۢ"
        },
        {
          "word_index": 10,
          "text": "وَبِمَآ"
        },
        {
          "word_index": 11,
          "text": "أَنفَقُوا۟"
        },
        {
          "word_index": 12,
          "text": "مِنْ"
        },
        {
          "word_index": 13,
          "text": "أَمْوَٰلِهِمْ ۚ"
        },
        {
          "word_index": 14,
          "text": "فَٱلصَّـٰلِحَـٰتُ"
        },
        {
          "word_index": 15,
          "text": "قَـٰنِتَـٰتٌ"
        },
        {
          "word_index": 16,
          "text": "حَـٰفِظَـٰتٌۭ"
        },
        {
          "word_index": 17,
          "text": "لِّلْغَيْبِ"
        },
        {
          "word_index": 18,
          "text": "بِمَا"
        },
        {
          "word_index": 19,
          "text": "حَفِظَ"
        },
        {
          "word_index": 20,
          "text": "ٱللَّهُ ۚ"
        },
        {
          "word_index": 21,
          "text": "وَٱلَّـٰتِى"
        },
        {
          "word_index": 22,
          "text": "تَخَافُونَ"
        },
        {
          "word_index": 23,
          "text": "نُشُوزَهُنَّ"
        },
        {
          "word_index": 24,
          "text": "فَعِظُوهُنَّ"
        },
        {
          "word_index": 25,
          "text": "وَٱهْجُرُوهُنَّ"
        },
        {
          "word_index": 26,
          "text": "فِى"
        },
        {
          "word_index": 27,
          "text": "ٱلْمَضَاجِعِ"
        },
        {
          "word_index": 28,
          "text": "وَٱضْرِبُوهُنَّ ۖ"
        },
        {
          "word_index": 29,
          "text": "فَإِنْ"
        },
        {
          "word_index": 30,
          "text": "أَطَعْنَكُمْ"
        },
        {
          "word_index": 31,
          "text": "فَلَا"
        },
        {
          "word_index": 32,
          "text": "تَبْغُوا۟"
        },
        {
          "word_index": 33,
          "text": "عَلَيْهِنَّ"
        },
        {
          "word_index": 34,
          "text": "سَبِيلًا ۗ"
        },
        {
          "word_index": 35,
          "text": "إِنَّ"
        },
        {
          "word_index": 36,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 37,
          "text": "كَانَ"
        },
        {
          "word_index": 38,
          "text": "عَلِيًّۭا"
        },
        {
          "word_index": 39,
          "text": "كَبِيرًۭا"
