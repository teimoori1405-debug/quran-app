{
  "page": 390,
  "verses": [
    {
      "surah_number": 28,
      "ayah_number": 36,
      "words": [
        {
          "word_index": 0,
          "text": "فَلَمَّا"
        },
        {
          "word_index": 1,
          "text": "جَآءَهُم"
        },
        {
          "word_index": 2,
          "text": "مُّوسَىٰ"
        },
        {
          "word_index": 3,
          "text": "بِـَٔايَـٰتِنَا"
        },
        {
          "word_index": 4,
          "text": "بَيِّنَـٰتٍۢ"
        },
        {
          "word_index": 5,
          "text": "قَالُوا۟"
        },
        {
          "word_index": 6,
          "text": "مَا"
        },
        {
          "word_index": 7,
          "text": "هَـٰذَآ"
        },
        {
          "word_index": 8,
          "text": "إِلَّا"
        },
        {
          "word_index": 9,
          "text": "سِحْرٌۭ"
        },
        {
          "word_index": 10,
          "text": "مُّفْتَرًۭى"
        },
        {
          "word_index": 11,
          "text": "وَمَا"
        },
        {
          "word_index": 12,
          "text": "سَمِعْنَا"
        },
        {
          "word_index": 13,
          "text": "بِهَـٰذَا"
        },
        {
          "word_index": 14,
          "text": "فِىٓ"
        },
        {
          "word_index": 15,
          "text": "ءَابَآئِنَا"
        },
        {
          "word_index": 16,
          "text": "ٱلْأَوَّلِينَ"
        }
      ]
    },
    {
      "surah_number": 28,
      "ayah_number": 37,
      "words": [
        {
          "word_index": 0,
          "text": "وَقَالَ"
        },
        {
          "word_index": 1,
          "text": "مُوسَىٰ"
        },
        {
          "word_index": 2,
          "text": "رَبِّىٓ"
        },
        {
          "word_index": 3,
          "text": "أَعْلَمُ"
        },
        {
          "word_index": 4,
          "text": "بِمَن"
        },
        {
          "word_index": 5,
          "text": "جَآءَ"
        },
        {
          "word_index": 6,
          "text": "بِٱلْهُدَىٰ"
        },
        {
          "word_index": 7,
          "text": "مِنْ"
        },
        {
          "word_index": 8,
          "text": "عِندِهِۦ"
        },
        {
          "word_index": 9,
          "text": "وَمَن"
        },
        {
          "word_index": 10,
          "text": "تَكُونُ"
        },
        {
          "word_index": 11,
          "text": "لَهُۥ"
        },
        {
          "word_index": 12,
          "text": "عَـٰقِبَةُ"
        },
        {
          "word_index": 13,
          "text": "ٱلدَّارِ ۖ"
        },
        {
          "word_index": 14,
          "text": "إِنَّهُۥ"
        },
        {
          "word_index": 15,
          "text": "لَا"
        },
        {
          "word_index": 16,
          "text": "يُفْلِحُ"
        },
        {
          "word_index": 17,
          "text": "ٱلظَّـٰلِمُونَ"
        }
      ]
    },
    {
      "surah_number": 28,
      "ayah_number": 38,
      "words": [
        {
          "word_index": 0,
          "text": "وَقَالَ"
        },
        {
          "word_index": 1,
          "text": "فِرْعَوْنُ"
        },
        {
          "word_index": 2,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 3,
          "text": "ٱلْمَلَأُ"
        },
        {
          "word_index": 4,
          "text": "مَا"
        },
        {
          "word_index": 5,
          "text": "عَلِمْتُ"
        },
        {
          "word_index": 6,
          "text": "لَكُم"
        },
        {
          "word_index": 7,
          "text": "مِّنْ"
        },
        {
          "word_index": 8,
          "text": "إِلَـٰهٍ"
        },
        {
          "word_index": 9,
          "text": "غَيْرِى"
        },
        {
          "word_index": 10,
          "text": "فَأَوْقِدْ"
        },
        {
          "word_index": 11,
          "text": "لِى"
        },
        {
          "word_index": 12,
          "text": "يَـٰهَـٰمَـٰنُ"
        },
        {
          "word_index": 13,
          "text": "عَلَى"
        },
        {
          "word_index": 14,
          "text": "ٱلطِّينِ"
        },
        {
          "word_index": 15,
          "text": "فَٱجْعَل"
        },
        {
          "word_index": 16,
          "text": "لِّى"
        },
        {
          "word_index": 17,
          "text": "صَرْحًۭا"
        },
        {
          "word_index": 18,
          "text": "لَّعَلِّىٓ"
        },
        {
          "word_index": 19,
          "text": "أَطَّلِعُ"
        },
        {
          "word_index": 20,
          "text": "إِلَىٰٓ"
        },
        {
          "word_index": 21,
          "text": "إِلَـٰهِ"
        },
        {
          "word_index": 22,
          "text": "مُوسَىٰ"
        },
        {
          "word_index": 23,
          "text": "وَإِنِّى"
        },
        {
          "word_index": 24,
          "text": "لَأَظُنُّهُۥ"
        },
        {
          "word_index": 25,
          "text": "مِنَ"
        },
        {
          "word_index": 26,
          "text": "ٱلْكَـٰذِبِينَ"
        }
      ]
    },
    {
      "surah_number": 28,
      "ayah_number": 39,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱسْتَكْبَرَ"
        },
        {
          "word_index": 1,
          "text": "هُوَ"
        },
        {
          "word_index": 2,
          "text": "وَجُنُودُهُۥ"
        },
        {
          "word_index": 3,
          "text": "فِى"
        },
        {
          "word_index": 4,
          "text": "ٱلْأَرْضِ"
        },
        {
          "word_index": 5,
          "text": "بِغَيْرِ"
        },
        {
          "word_index": 6,
          "text": "ٱلْحَقِّ"
        },
        {
          "word_index": 7,
          "text": "وَظَنُّوٓا۟"
        },
        {
          "word_index": 8,
          "text": "أَنَّهُمْ"
        },
        {
          "word_index": 9,
          "text": "إِلَيْنَا"
        },
        {
          "word_index": 10,
          "text": "لَا"
        },
        {
          "word_index": 11,
          "text": "يُرْجَعُونَ"
        }
      ]
    },
    {
      "surah_number": 28,
      "ayah_number": 40,
      "words": [
        {
          "word_index": 0,
          "text": "فَأَخَذْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "وَجُنُودَهُۥ"
        },
        {
          "word_index": 2,
          "text": "فَنَبَذْنَـٰهُمْ"
        },
        {
          "word_index": 3,
          "text": "فِى"
        },
        {
          "word_index": 4,
          "text": "ٱلْيَمِّ ۖ"
        },
        {
          "word_index": 5,
          "text": "فَٱنظُرْ"
        },
        {
          "word_index": 6,
          "text": "كَيْفَ"
        },
        {
          "word_index": 7,
          "text": "كَانَ"
        },
        {
          "word_index": 8,
          "text": "عَـٰقِبَةُ"
        },
        {
          "word_index": 9,
          "text": "ٱلظَّـٰلِمِينَ"
        }
      ]
    },
    {
      "surah_number": 28,
      "ayah_number": 41,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَعَلْنَـٰهُمْ"
