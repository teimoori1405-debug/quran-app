          "word_index": 3,
          "text": "إِلَى"
        },
        {
          "word_index": 4,
          "text": "ٱلنَّارِ ۖ"
        },
        {
          "word_index": 5,
          "text": "وَيَوْمَ"
        },
        {
          "word_index": 6,
          "text": "ٱلْقِيَـٰمَةِ"
        },
        {
          "word_index": 7,
          "text": "لَا"
        },
        {
          "word_index": 8,
          "text": "يُنصَرُونَ"
