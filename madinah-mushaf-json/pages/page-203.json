          "text": "ٱلْمُهَـٰجِرِينَ"
        },
        {
          "word_index": 4,
          "text": "وَٱلْأَنصَارِ"
        },
        {
          "word_index": 5,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 6,
          "text": "ٱتَّبَعُوهُم"
