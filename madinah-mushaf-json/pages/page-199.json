        },
        {
          "word_index": 14,
          "text": "يَنَالُوا۟ ۚ"
        },
        {
          "word_index": 15,
          "text": "وَمَا"
        },
        {
          "word_index": 16,
          "text": "نَقَمُوٓا۟"
        },
        {
          "word_index": 17,
          "text": "إِلَّآ"
