          "text": "ٱلْكُفَّارَ"
        },
        {
          "word_index": 4,
          "text": "وَٱلْمُنَـٰفِقِينَ"
        },
        {
          "word_index": 5,
          "text": "وَٱغْلُظْ"
        },
        {
          "word_index": 6,
          "text": "عَلَيْهِمْ ۚ"
