  "verses": [
    {
      "surah_number": 9,
      "ayah_number": 73,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلنَّبِىُّ"
        },
