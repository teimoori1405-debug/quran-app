          "word_index": 9,
          "text": "وَبِئْسَ"
        },
        {
          "word_index": 10,
          "text": "ٱلْمَصِيرُ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 74,
      "words": [
        {
          "word_index": 0,
          "text": "يَحْلِفُونَ"
        },
