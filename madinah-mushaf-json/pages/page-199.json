          "text": "قَالُوا۟"
        },
        {
          "word_index": 6,
          "text": "كَلِمَةَ"
        },
        {
          "word_index": 7,
          "text": "ٱلْكُفْرِ"
        },
        {
          "word_index": 8,
          "text": "وَكَفَرُوا۟"
