    },
    {
      "surah_number": 78,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "كَلَّا"
        },
        {
          "word_index": 1,
          "text": "سَيَعْلَمُونَ"
        }
      ]
    },
    {
      "surah_number": 78,
      "ayah_number": 5,
      "words": [
        {
          "word_index": 0,
          "text": "ثُمَّ"
        },
        {
          "word_index": 1,
          "text": "كَلَّا"
        },
        {
          "word_index": 2,
          "text": "سَيَعْلَمُونَ"
