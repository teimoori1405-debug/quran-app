          "word_index": 1,
          "text": "ٱلنَّبَإِ"
        },
        {
          "word_index": 2,
          "text": "ٱلْعَظِيمِ"
        }
      ]
    },
    {
      "surah_number": 78,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلَّذِى"
        },
