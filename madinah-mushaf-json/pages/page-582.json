    },
    {
      "surah_number": 78,
      "ayah_number": 10,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَعَلْنَا"
        },
        {
          "word_index": 1,
          "text": "ٱلَّيْلَ"
        },
        {
          "word_index": 2,
          "text": "لِبَاسًۭا"
