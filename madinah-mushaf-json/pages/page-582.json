    },
    {
      "surah_number": 78,
      "ayah_number": 7,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱلْجِبَالَ"
        },
        {
          "word_index": 1,
          "text": "أَوْتَادًۭا"
        }
      ]
    },
    {
      "surah_number": 78,
      "ayah_number": 8,
      "words": [
        {
          "word_index": 0,
          "text": "وَخَلَقْنَـٰكُمْ"
