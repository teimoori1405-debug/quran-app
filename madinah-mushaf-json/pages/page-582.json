        }
      ]
    },
    {
      "surah_number": 78,
      "ayah_number": 9,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَعَلْنَا"
        },
        {
          "word_index": 1,
          "text": "نَوْمَكُمْ"
