      "words": [
        {
          "word_index": 0,
          "text": "قَالَ"
        },
        {
          "word_index": 1,
          "text": "هَـٰٓؤُلَآءِ"
        },
        {
          "word_index": 2,
          "text": "بَنَاتِىٓ"
        },
        {
          "word_index": 3,
          "text": "إِن"
        },
        {
          "word_index": 4,
          "text": "كُنتُمْ"
        },
        {
          "word_index": 5,
          "text": "فَـٰعِلِينَ"
        }
      ]
    },
    {
      "surah_number": 15,
      "ayah_number": 72,
      "words": [
        {
          "word_index": 0,
          "text": "لَعَمْرُكَ"
        },
        {
          "word_index": 1,
          "text": "إِنَّهُمْ"
        },
        {
          "word_index": 2,
          "text": "لَفِى"
        },
        {
          "word_index": 3,
          "text": "سَكْرَتِهِمْ"
        },
        {
          "word_index": 4,
          "text": "يَعْمَهُونَ"
        }
      ]
    },
    {
      "surah_number": 15,
      "ayah_number": 73,
      "words": [
        {
          "word_index": 0,
          "text": "فَأَخَذَتْهُمُ"
        },
        {
          "word_index": 1,
          "text": "ٱلصَّيْحَةُ"
        },
        {
          "word_index": 2,
          "text": "مُشْرِقِينَ"
        }
      ]
    },
    {
      "surah_number": 15,
      "ayah_number": 74,
      "words": [
        {
          "word_index": 0,
          "text": "فَجَعَلْنَا"
        },
        {
          "word_index": 1,
          "text": "عَـٰلِيَهَا"
        },
        {
          "word_index": 2,
          "text": "سَافِلَهَا"
        },
        {
          "word_index": 3,
          "text": "وَأَمْطَرْنَا"
