          "word_index": 4,
          "text": "عَلَيْهِمْ"
        },
        {
          "word_index": 5,
          "text": "حِجَارَةًۭ"
        },
        {
          "word_index": 6,
          "text": "مِّن"
        },
        {
          "word_index": 7,
          "text": "سِجِّيلٍ"
