  "verses": [
    {
      "surah_number": 37,
      "ayah_number": 127,
      "words": [
        {
          "word_index": 0,
          "text": "فَكَذَّبُوهُ"
        },
        {
          "word_index": 1,
          "text": "فَإِنَّهُمْ"
        },
        {
          "word_index": 2,
          "text": "لَمُحْضَرُونَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 128,
      "words": [
        {
          "word_index": 0,
          "text": "إِلَّا"
        },
        {
          "word_index": 1,
          "text": "عِبَادَ"
        },
        {
          "word_index": 2,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 3,
          "text": "ٱلْمُخْلَصِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 129,
      "words": [
        {
          "word_index": 0,
          "text": "وَتَرَكْنَا"
        },
        {
          "word_index": 1,
          "text": "عَلَيْهِ"
        },
        {
          "word_index": 2,
          "text": "فِى"
        },
        {
          "word_index": 3,
          "text": "ٱلْـَٔاخِرِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 130,
      "words": [
        {
          "word_index": 0,
          "text": "سَلَـٰمٌ"
        },
        {
          "word_index": 1,
          "text": "عَلَىٰٓ"
        },
        {
          "word_index": 2,
          "text": "إِلْ يَاسِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 131,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّا"
        },
        {
          "word_index": 1,
          "text": "كَذَٰلِكَ"
        },
        {
          "word_index": 2,
          "text": "نَجْزِى"
        },
        {
          "word_index": 3,
          "text": "ٱلْمُحْسِنِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 132,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّهُۥ"
        },
        {
          "word_index": 1,
          "text": "مِنْ"
        },
        {
          "word_index": 2,
          "text": "عِبَادِنَا"
        },
        {
          "word_index": 3,
          "text": "ٱلْمُؤْمِنِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 133,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِنَّ"
        },
        {
          "word_index": 1,
          "text": "لُوطًۭا"
        },
        {
          "word_index": 2,
          "text": "لَّمِنَ"
        },
        {
          "word_index": 3,
          "text": "ٱلْمُرْسَلِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 134,
      "words": [
        {
          "word_index": 0,
          "text": "إِذْ"
        },
        {
          "word_index": 1,
          "text": "نَجَّيْنَـٰهُ"
        },
        {
          "word_index": 2,
          "text": "وَأَهْلَهُۥٓ"
        },
        {
          "word_index": 3,
          "text": "أَجْمَعِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 135,
      "words": [
        {
          "word_index": 0,
          "text": "إِلَّا"
        },
        {
          "word_index": 1,
          "text": "عَجُوزًۭا"
        },
        {
          "word_index": 2,
          "text": "فِى"
        },
        {
          "word_index": 3,
          "text": "ٱلْغَـٰبِرِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 136,
      "words": [
        {
          "word_index": 0,
          "text": "ثُمَّ"
        },
        {
          "word_index": 1,
          "text": "دَمَّرْنَا"
        },
        {
          "word_index": 2,
          "text": "ٱلْـَٔاخَرِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 137,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِنَّكُمْ"
        },
        {
          "word_index": 1,
          "text": "لَتَمُرُّونَ"
        },
        {
          "word_index": 2,
          "text": "عَلَيْهِم"
        },
        {
          "word_index": 3,
          "text": "مُّصْبِحِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 138,
      "words": [
        {
          "word_index": 0,
          "text": "وَبِٱلَّيْلِ ۗ"
        },
        {
          "word_index": 1,
          "text": "أَفَلَا"
        },
        {
          "word_index": 2,
          "text": "تَعْقِلُونَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 139,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِنَّ"
        },
        {
          "word_index": 1,
          "text": "يُونُسَ"
        },
        {
          "word_index": 2,
          "text": "لَمِنَ"
        },
        {
          "word_index": 3,
          "text": "ٱلْمُرْسَلِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 140,
      "words": [
        {
          "word_index": 0,
          "text": "إِذْ"
        },
        {
          "word_index": 1,
          "text": "أَبَقَ"
        },
        {
          "word_index": 2,
          "text": "إِلَى"
        },
        {
          "word_index": 3,
          "text": "ٱلْفُلْكِ"
        },
        {
          "word_index": 4,
          "text": "ٱلْمَشْحُونِ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 141,
      "words": [
        {
          "word_index": 0,
          "text": "فَسَاهَمَ"
        },
        {
          "word_index": 1,
          "text": "فَكَانَ"
        },
        {
          "word_index": 2,
          "text": "مِنَ"
        },
        {
          "word_index": 3,
          "text": "ٱلْمُدْحَضِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 142,
      "words": [
        {
          "word_index": 0,
          "text": "فَٱلْتَقَمَهُ"
        },
        {
          "word_index": 1,
          "text": "ٱلْحُوتُ"
        },
        {
          "word_index": 2,
          "text": "وَهُوَ"
        },
        {
          "word_index": 3,
          "text": "مُلِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 143,
      "words": [
        {
          "word_index": 0,
          "text": "فَلَوْلَآ"
        },
        {
          "word_index": 1,
          "text": "أَنَّهُۥ"
        },
        {
          "word_index": 2,
          "text": "كَانَ"
        },
        {
          "word_index": 3,
          "text": "مِنَ"
        },
        {
          "word_index": 4,
          "text": "ٱلْمُسَبِّحِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 144,
      "words": [
        {
          "word_index": 0,
          "text": "لَلَبِثَ"
        },
        {
          "word_index": 1,
          "text": "فِى"
        },
        {
          "word_index": 2,
          "text": "بَطْنِهِۦٓ"
        },
        {
          "word_index": 3,
          "text": "إِلَىٰ"
        },
        {
          "word_index": 4,
          "text": "يَوْمِ"
        },
        {
          "word_index": 5,
          "text": "يُبْعَثُونَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 145,
      "words": [
        {
          "word_index": 0,
          "text": "۞ فَنَبَذْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "بِٱلْعَرَآءِ"
        },
        {
          "word_index": 2,
          "text": "وَهُوَ"
        },
        {
          "word_index": 3,
          "text": "سَقِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 146,
      "words": [
        {
          "word_index": 0,
          "text": "وَأَنۢبَتْنَا"
        },
        {
          "word_index": 1,
          "text": "عَلَيْهِ"
        },
        {
          "word_index": 2,
          "text": "شَجَرَةًۭ"
        },
        {
          "word_index": 3,
          "text": "مِّن"
        },
        {
          "word_index": 4,
          "text": "يَقْطِينٍۢ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 147,
      "words": [
        {
          "word_index": 0,
          "text": "وَأَرْسَلْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "إِلَىٰ"
        },
        {
          "word_index": 2,
          "text": "مِا۟ئَةِ"
        },
        {
          "word_index": 3,
          "text": "أَلْفٍ"
