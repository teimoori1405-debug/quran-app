          "word_index": 4,
          "text": "أَوْ"
        },
        {
          "word_index": 5,
          "text": "يَزِيدُونَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 148,
      "words": [
        {
          "word_index": 0,
          "text": "فَـَٔامَنُوا۟"
        },
        {
          "word_index": 1,
          "text": "فَمَتَّعْنَـٰهُمْ"
