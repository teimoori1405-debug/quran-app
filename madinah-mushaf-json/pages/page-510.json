  "verses": [
    {
      "surah_number": 47,
      "ayah_number": 30,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَوْ"
        },
        {
          "word_index": 1,
          "text": "نَشَآءُ"
        },
        {
          "word_index": 2,
          "text": "لَأَرَيْنَـٰكَهُمْ"
