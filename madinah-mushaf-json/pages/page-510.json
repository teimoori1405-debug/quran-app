          "text": "فَلَعَرَفْتَهُم"
        },
        {
          "word_index": 4,
          "text": "بِسِيمَـٰهُمْ ۚ"
        },
        {
          "word_index": 5,
          "text": "وَلَتَعْرِفَنَّهُمْ"
        },
        {
          "word_index": 6,
          "text": "فِى"
