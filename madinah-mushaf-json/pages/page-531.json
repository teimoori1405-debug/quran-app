  "verses": [
    {
      "surah_number": 54,
      "ayah_number": 50,
      "words": [
        {
          "word_index": 0,
          "text": "وَمَآ"
        },
        {
          "word_index": 1,
          "text": "أَمْرُنَآ"
        },
        {
          "word_index": 2,
          "text": "إِلَّا"
        },
        {
          "word_index": 3,
          "text": "وَٰحِدَةٌۭ"
        },
        {
          "word_index": 4,
          "text": "كَلَمْحٍۭ"
        },
        {
          "word_index": 5,
          "text": "بِٱلْبَصَرِ"
        }
      ]
    },
    {
      "surah_number": 54,
      "ayah_number": 51,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "أَهْلَكْنَآ"
        },
        {
          "word_index": 2,
          "text": "أَشْيَاعَكُمْ"
        },
        {
          "word_index": 3,
          "text": "فَهَلْ"
        },
        {
          "word_index": 4,
          "text": "مِن"
        },
        {
          "word_index": 5,
          "text": "مُّدَّكِرٍۢ"
        }
      ]
    },
    {
      "surah_number": 54,
      "ayah_number": 52,
      "words": [
        {
          "word_index": 0,
          "text": "وَكُلُّ"
        },
        {
          "word_index": 1,
          "text": "شَىْءٍۢ"
        },
        {
          "word_index": 2,
          "text": "فَعَلُوهُ"
        },
        {
          "word_index": 3,
          "text": "فِى"
        },
        {
          "word_index": 4,
          "text": "ٱلزُّبُرِ"
        }
      ]
    },
    {
      "surah_number": 54,
      "ayah_number": 53,
      "words": [
        {
          "word_index": 0,
          "text": "وَكُلُّ"
        },
        {
          "word_index": 1,
          "text": "صَغِيرٍۢ"
        },
        {
          "word_index": 2,
          "text": "وَكَبِيرٍۢ"
        },
        {
          "word_index": 3,
          "text": "مُّسْتَطَرٌ"
        }
      ]
    },
    {
      "surah_number": 54,
      "ayah_number": 54,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّ"
        },
        {
          "word_index": 1,
          "text": "ٱلْمُتَّقِينَ"
        },
        {
          "word_index": 2,
          "text": "فِى"
        },
        {
          "word_index": 3,
          "text": "جَنَّـٰتٍۢ"
        },
        {
          "word_index": 4,
          "text": "وَنَهَرٍۢ"
        }
      ]
    },
    {
      "surah_number": 54,
      "ayah_number": 55,
      "words": [
        {
          "word_index": 0,
          "text": "فِى"
        },
        {
          "word_index": 1,
          "text": "مَقْعَدِ"
        },
        {
          "word_index": 2,
          "text": "صِدْقٍ"
        },
        {
          "word_index": 3,
          "text": "عِندَ"
        },
        {
          "word_index": 4,
          "text": "مَلِيكٍۢ"
        },
        {
          "word_index": 5,
          "text": "مُّقْتَدِرٍۭ"
        }
      ]
    },
    {
      "surah_number": 55,
      "ayah_number": 1,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلرَّحْمَـٰنُ"
        }
      ]
    },
    {
      "surah_number": 55,
      "ayah_number": 2,
      "words": [
        {
          "word_index": 0,
          "text": "عَلَّمَ"
        },
        {
          "word_index": 1,
          "text": "ٱلْقُرْءَانَ"
