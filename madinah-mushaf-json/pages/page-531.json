    },
    {
      "surah_number": 55,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "خَلَقَ"
        },
        {
          "word_index": 1,
          "text": "ٱلْإِنسَـٰنَ"
        }
      ]
    },
    {
      "surah_number": 55,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "عَلَّمَهُ"
        },
