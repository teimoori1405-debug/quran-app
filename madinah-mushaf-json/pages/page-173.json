        {
          "word_index": 2,
          "text": "ٱلْجَبَلَ"
        },
        {
          "word_index": 3,
          "text": "فَوْقَهُمْ"
        },
        {
          "word_index": 4,
          "text": "كَأَنَّهُۥ"
        },
        {
          "word_index": 5,
          "text": "ظُلَّةٌۭ"
        },
        {
          "word_index": 6,
          "text": "وَظَنُّوٓا۟"
        },
        {
          "word_index": 7,
          "text": "أَنَّهُۥ"
        },
        {
          "word_index": 8,
          "text": "وَاقِعٌۢ"
        },
        {
          "word_index": 9,
          "text": "بِهِمْ"
        },
        {
