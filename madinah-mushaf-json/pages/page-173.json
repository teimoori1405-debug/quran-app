          "word_index": 4,
          "text": "بَنِىٓ"
        },
        {
          "word_index": 5,
          "text": "ءَادَمَ"
        },
        {
          "word_index": 6,
          "text": "مِن"
        },
        {
          "word_index": 7,
          "text": "ظُهُورِهِمْ"
        },
        {
          "word_index": 8,
          "text": "ذُرِّيَّتَهُمْ"
        },
        {
          "word_index": 9,
          "text": "وَأَشْهَدَهُمْ"
