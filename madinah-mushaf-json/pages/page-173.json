          "text": "ءَاتَيْنَـٰكُم"
        },
        {
          "word_index": 13,
          "text": "بِقُوَّةٍۢ"
        },
        {
          "word_index": 14,
          "text": "وَٱذْكُرُوا۟"
        },
        {
          "word_index": 15,
          "text": "مَا"
        },
        {
          "word_index": 16,
          "text": "فِيهِ"
        },
        {
          "word_index": 17,
          "text": "لَعَلَّكُمْ"
        },
        {
          "word_index": 18,
          "text": "تَتَّقُونَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 172,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِذْ"
        },
