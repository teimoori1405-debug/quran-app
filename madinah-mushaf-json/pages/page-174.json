          "text": "أَعْيُنٌۭ"
        },
        {
          "word_index": 14,
          "text": "لَّا"
        },
        {
          "word_index": 15,
          "text": "يُبْصِرُونَ"
        },
        {
          "word_index": 16,
          "text": "بِهَا"
        },
        {
          "word_index": 17,
          "text": "وَلَهُمْ"
        },
        {
          "word_index": 18,
          "text": "ءَاذَانٌۭ"
        },
        {
          "word_index": 19,
          "text": "لَّا"
        },
        {
          "word_index": 20,
          "text": "يَسْمَعُونَ"
        },
        {
          "word_index": 21,
          "text": "بِهَآ ۚ"
        },
        {
          "word_index": 22,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 23,
          "text": "كَٱلْأَنْعَـٰمِ"
        },
        {
          "word_index": 24,
          "text": "بَلْ"
