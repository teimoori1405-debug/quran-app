        {
          "word_index": 25,
          "text": "هُمْ"
        },
        {
          "word_index": 26,
          "text": "أَضَلُّ ۚ"
        },
        {
          "word_index": 27,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 28,
          "text": "هُمُ"
        },
        {
          "word_index": 29,
          "text": "ٱلْغَـٰفِلُونَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 180,
      "words": [
        {
          "word_index": 0,
          "text": "وَلِلَّهِ"
