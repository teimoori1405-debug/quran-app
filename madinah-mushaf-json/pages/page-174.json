        },
        {
          "word_index": 3,
          "text": "فَٱدْعُوهُ"
        },
        {
          "word_index": 4,
          "text": "بِهَا ۖ"
        },
        {
          "word_index": 5,
          "text": "وَذَرُوا۟"
        },
