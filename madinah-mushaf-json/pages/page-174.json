  "verses": [
    {
      "surah_number": 7,
      "ayah_number": 179,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "ذَرَأْنَا"
        },
        {
          "word_index": 2,
          "text": "لِجَهَنَّمَ"
        },
        {
          "word_index": 3,
          "text": "كَثِيرًۭا"
        },
        {
          "word_index": 4,
          "text": "مِّنَ"
        },
        {
          "word_index": 5,
          "text": "ٱلْجِنِّ"
        },
        {
          "word_index": 6,
          "text": "وَٱلْإِنسِ ۖ"
        },
        {
          "word_index": 7,
          "text": "لَهُمْ"
        },
        {
          "word_index": 8,
          "text": "قُلُوبٌۭ"
        },
        {
          "word_index": 9,
          "text": "لَّا"
        },
        {
          "word_index": 10,
          "text": "يَفْقَهُونَ"
        },
        {
          "word_index": 11,
          "text": "بِهَا"
        },
        {
          "word_index": 12,
          "text": "وَلَهُمْ"
