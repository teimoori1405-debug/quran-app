        {
          "word_index": 4,
          "text": "وَٱجْتَبَيْنَـٰهُمْ"
        },
        {
          "word_index": 5,
          "text": "وَهَدَيْنَـٰهُمْ"
        },
        {
          "word_index": 6,
          "text": "إِلَىٰ"
        },
