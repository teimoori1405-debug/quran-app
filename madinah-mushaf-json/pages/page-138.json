{
  "page": 138,
  "verses": [
    {
      "surah_number": 6,
      "ayah_number": 82,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 2,
          "text": "وَلَمْ"
        },
        {
          "word_index": 3,
          "text": "يَلْبِسُوٓا۟"
        },
        {
          "word_index": 4,
          "text": "إِيمَـٰنَهُم"
        },
        {
          "word_index": 5,
          "text": "بِظُلْمٍ"
        },
        {
          "word_index": 6,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 7,
          "text": "لَهُمُ"
        },
        {
          "word_index": 8,
          "text": "ٱلْأَمْنُ"
        },
        {
          "word_index": 9,
          "text": "وَهُم"
        },
        {
          "word_index": 10,
          "text": "مُّهْتَدُونَ"
        }
      ]
    },
    {
      "surah_number": 6,
      "ayah_number": 83,
      "words": [
        {
          "word_index": 0,
          "text": "وَتِلْكَ"
        },
        {
          "word_index": 1,
          "text": "حُجَّتُنَآ"
        },
        {
          "word_index": 2,
          "text": "ءَاتَيْنَـٰهَآ"
        },
        {
          "word_index": 3,
          "text": "إِبْرَٰهِيمَ"
        },
        {
          "word_index": 4,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 5,
          "text": "قَوْمِهِۦ ۚ"
        },
        {
          "word_index": 6,
          "text": "نَرْفَعُ"
        },
        {
          "word_index": 7,
          "text": "دَرَجَـٰتٍۢ"
        },
        {
          "word_index": 8,
          "text": "مَّن"
        },
        {
          "word_index": 9,
          "text": "نَّشَآءُ ۗ"
        },
        {
          "word_index": 10,
          "text": "إِنَّ"
        },
        {
          "word_index": 11,
          "text": "رَبَّكَ"
        },
        {
          "word_index": 12,
          "text": "حَكِيمٌ"
        },
        {
          "word_index": 13,
          "text": "عَلِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 6,
      "ayah_number": 84,
      "words": [
        {
          "word_index": 0,
          "text": "وَوَهَبْنَا"
        },
        {
          "word_index": 1,
          "text": "لَهُۥٓ"
        },
        {
          "word_index": 2,
          "text": "إِسْحَـٰقَ"
        },
        {
          "word_index": 3,
          "text": "وَيَعْقُوبَ ۚ"
        },
        {
          "word_index": 4,
          "text": "كُلًّا"
        },
        {
          "word_index": 5,
          "text": "هَدَيْنَا ۚ"
        },
        {
          "word_index": 6,
          "text": "وَنُوحًا"
        },
        {
          "word_index": 7,
          "text": "هَدَيْنَا"
        },
        {
          "word_index": 8,
          "text": "مِن"
        },
        {
          "word_index": 9,
          "text": "قَبْلُ ۖ"
        },
        {
          "word_index": 10,
          "text": "وَمِن"
        },
        {
          "word_index": 11,
          "text": "ذُرِّيَّتِهِۦ"
        },
        {
          "word_index": 12,
          "text": "دَاوُۥدَ"
        },
        {
          "word_index": 13,
          "text": "وَسُلَيْمَـٰنَ"
        },
        {
          "word_index": 14,
          "text": "وَأَيُّوبَ"
        },
        {
          "word_index": 15,
          "text": "وَيُوسُفَ"
        },
        {
          "word_index": 16,
          "text": "وَمُوسَىٰ"
        },
        {
          "word_index": 17,
          "text": "وَهَـٰرُونَ ۚ"
        },
        {
          "word_index": 18,
          "text": "وَكَذَٰلِكَ"
        },
        {
          "word_index": 19,
          "text": "نَجْزِى"
        },
        {
          "word_index": 20,
          "text": "ٱلْمُحْسِنِينَ"
        }
      ]
    },
    {
      "surah_number": 6,
      "ayah_number": 85,
      "words": [
        {
          "word_index": 0,
          "text": "وَزَكَرِيَّا"
        },
        {
          "word_index": 1,
          "text": "وَيَحْيَىٰ"
        },
        {
          "word_index": 2,
          "text": "وَعِيسَىٰ"
        },
        {
          "word_index": 3,
          "text": "وَإِلْيَاسَ ۖ"
