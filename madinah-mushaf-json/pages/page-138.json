        {
          "word_index": 4,
          "text": "كُلٌّۭ"
        },
        {
          "word_index": 5,
          "text": "مِّنَ"
        },
        {
          "word_index": 6,
          "text": "ٱلصَّـٰلِحِينَ"
        }
      ]
    },
    {
      "surah_number": 6,
      "ayah_number": 86,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِسْمَـٰعِيلَ"
