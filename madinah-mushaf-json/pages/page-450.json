          "word_index": 3,
          "text": "ٱلْكَرْبِ"
        },
        {
          "word_index": 4,
          "text": "ٱلْعَظِيمِ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 116,
      "words": [
        {
          "word_index": 0,
          "text": "وَنَصَرْنَـٰهُمْ"
        },
        {
          "word_index": 1,
          "text": "فَكَانُوا۟"
        },
