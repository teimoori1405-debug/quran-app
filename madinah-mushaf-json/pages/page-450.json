{
  "page": 450,
  "verses": [
    {
      "surah_number": 37,
      "ayah_number": 103,
      "words": [
        {
          "word_index": 0,
          "text": "فَلَمَّآ"
        },
        {
          "word_index": 1,
          "text": "أَسْلَمَا"
        },
        {
          "word_index": 2,
          "text": "وَتَلَّهُۥ"
        },
        {
          "word_index": 3,
          "text": "لِلْجَبِينِ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 104,
      "words": [
        {
          "word_index": 0,
          "text": "وَنَـٰدَيْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "أَن"
        },
        {
          "word_index": 2,
          "text": "يَـٰٓإِبْرَٰهِيمُ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 105,
      "words": [
        {
          "word_index": 0,
          "text": "قَدْ"
        },
        {
          "word_index": 1,
          "text": "صَدَّقْتَ"
        },
        {
          "word_index": 2,
          "text": "ٱلرُّءْيَآ ۚ"
        },
        {
          "word_index": 3,
          "text": "إِنَّا"
        },
        {
          "word_index": 4,
          "text": "كَذَٰلِكَ"
        },
        {
          "word_index": 5,
          "text": "نَجْزِى"
        },
        {
          "word_index": 6,
          "text": "ٱلْمُحْسِنِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 106,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّ"
        },
        {
          "word_index": 1,
          "text": "هَـٰذَا"
        },
        {
          "word_index": 2,
          "text": "لَهُوَ"
        },
        {
          "word_index": 3,
          "text": "ٱلْبَلَـٰٓؤُا۟"
        },
        {
          "word_index": 4,
          "text": "ٱلْمُبِينُ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 107,
      "words": [
        {
          "word_index": 0,
          "text": "وَفَدَيْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "بِذِبْحٍ"
        },
        {
          "word_index": 2,
          "text": "عَظِيمٍۢ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 108,
      "words": [
        {
          "word_index": 0,
          "text": "وَتَرَكْنَا"
        },
        {
          "word_index": 1,
          "text": "عَلَيْهِ"
        },
        {
          "word_index": 2,
          "text": "فِى"
        },
        {
          "word_index": 3,
          "text": "ٱلْـَٔاخِرِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 109,
      "words": [
        {
          "word_index": 0,
          "text": "سَلَـٰمٌ"
        },
        {
          "word_index": 1,
          "text": "عَلَىٰٓ"
        },
        {
          "word_index": 2,
          "text": "إِبْرَٰهِيمَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 110,
      "words": [
        {
          "word_index": 0,
          "text": "كَذَٰلِكَ"
        },
        {
          "word_index": 1,
          "text": "نَجْزِى"
        },
        {
          "word_index": 2,
          "text": "ٱلْمُحْسِنِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 111,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّهُۥ"
        },
        {
          "word_index": 1,
          "text": "مِنْ"
        },
        {
          "word_index": 2,
          "text": "عِبَادِنَا"
        },
        {
          "word_index": 3,
          "text": "ٱلْمُؤْمِنِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 112,
      "words": [
        {
          "word_index": 0,
          "text": "وَبَشَّرْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "بِإِسْحَـٰقَ"
        },
        {
          "word_index": 2,
          "text": "نَبِيًّۭا"
        },
        {
          "word_index": 3,
          "text": "مِّنَ"
        },
        {
          "word_index": 4,
          "text": "ٱلصَّـٰلِحِينَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 113,
      "words": [
        {
          "word_index": 0,
          "text": "وَبَـٰرَكْنَا"
        },
        {
          "word_index": 1,
          "text": "عَلَيْهِ"
        },
        {
          "word_index": 2,
          "text": "وَعَلَىٰٓ"
        },
        {
          "word_index": 3,
          "text": "إِسْحَـٰقَ ۚ"
        },
        {
          "word_index": 4,
          "text": "وَمِن"
        },
        {
          "word_index": 5,
          "text": "ذُرِّيَّتِهِمَا"
        },
        {
          "word_index": 6,
          "text": "مُحْسِنٌۭ"
        },
        {
          "word_index": 7,
          "text": "وَظَالِمٌۭ"
        },
        {
          "word_index": 8,
          "text": "لِّنَفْسِهِۦ"
        },
        {
          "word_index": 9,
          "text": "مُبِينٌۭ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 114,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "مَنَنَّا"
        },
        {
          "word_index": 2,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 3,
          "text": "مُوسَىٰ"
        },
        {
          "word_index": 4,
          "text": "وَهَـٰرُونَ"
        }
      ]
    },
    {
      "surah_number": 37,
      "ayah_number": 115,
      "words": [
        {
          "word_index": 0,
          "text": "وَنَجَّيْنَـٰهُمَا"
        },
        {
          "word_index": 1,
          "text": "وَقَوْمَهُمَا"
        },
        {
          "word_index": 2,
          "text": "مِنَ"
