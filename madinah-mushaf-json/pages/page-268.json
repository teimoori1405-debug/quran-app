          "text": "لَّمْ"
        },
        {
          "word_index": 5,
          "text": "تَكُونُوا۟"
        },
        {
          "word_index": 6,
          "text": "بَـٰلِغِيهِ"
        },
        {
          "word_index": 7,
          "text": "إِلَّا"
