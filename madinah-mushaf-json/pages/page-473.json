          "text": "مَّا"
        },
        {
          "word_index": 15,
          "text": "هُم"
        },
        {
          "word_index": 16,
          "text": "بِبَـٰلِغِيهِ ۚ"
        },
        {
          "word_index": 17,
          "text": "فَٱسْتَعِذْ"
        },
        {
          "word_index": 18,
          "text": "بِٱللَّهِ ۖ"
        },
        {
          "word_index": 19,
          "text": "إِنَّهُۥ"
        },
        {
          "word_index": 20,
          "text": "هُوَ"
        },
        {
          "word_index": 21,
          "text": "ٱلسَّمِيعُ"
