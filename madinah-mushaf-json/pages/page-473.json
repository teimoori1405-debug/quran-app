{
  "page": 473,
  "verses": [
    {
      "surah_number": 40,
      "ayah_number": 50,
      "words": [
        {
          "word_index": 0,
          "text": "قَالُوٓا۟"
        },
        {
          "word_index": 1,
          "text": "أَوَلَمْ"
        },
        {
          "word_index": 2,
          "text": "تَكُ"
        },
        {
          "word_index": 3,
          "text": "تَأْتِيكُمْ"
        },
        {
          "word_index": 4,
          "text": "رُسُلُكُم"
        },
        {
          "word_index": 5,
          "text": "بِٱلْبَيِّنَـٰتِ ۖ"
        },
        {
          "word_index": 6,
          "text": "قَالُوا۟"
        },
        {
          "word_index": 7,
          "text": "بَلَىٰ ۚ"
        },
        {
          "word_index": 8,
          "text": "قَالُوا۟"
        },
        {
          "word_index": 9,
          "text": "فَٱدْعُوا۟ ۗ"
        },
        {
          "word_index": 10,
          "text": "وَمَا"
        },
        {
          "word_index": 11,
          "text": "دُعَـٰٓؤُا۟"
        },
        {
          "word_index": 12,
          "text": "ٱلْكَـٰفِرِينَ"
        },
        {
          "word_index": 13,
          "text": "إِلَّا"
        },
        {
          "word_index": 14,
          "text": "فِى"
        },
        {
          "word_index": 15,
          "text": "ضَلَـٰلٍ"
        }
      ]
    },
    {
      "surah_number": 40,
      "ayah_number": 51,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّا"
        },
        {
          "word_index": 1,
          "text": "لَنَنصُرُ"
        },
        {
          "word_index": 2,
          "text": "رُسُلَنَا"
        },
        {
          "word_index": 3,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 4,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 5,
          "text": "فِى"
        },
        {
          "word_index": 6,
          "text": "ٱلْحَيَوٰةِ"
        },
        {
          "word_index": 7,
          "text": "ٱلدُّنْيَا"
        },
        {
          "word_index": 8,
          "text": "وَيَوْمَ"
        },
        {
          "word_index": 9,
          "text": "يَقُومُ"
        },
        {
          "word_index": 10,
          "text": "ٱلْأَشْهَـٰدُ"
        }
      ]
    },
    {
      "surah_number": 40,
      "ayah_number": 52,
      "words": [
        {
          "word_index": 0,
          "text": "يَوْمَ"
        },
        {
          "word_index": 1,
          "text": "لَا"
        },
        {
          "word_index": 2,
          "text": "يَنفَعُ"
        },
        {
          "word_index": 3,
          "text": "ٱلظَّـٰلِمِينَ"
        },
        {
          "word_index": 4,
          "text": "مَعْذِرَتُهُمْ ۖ"
        },
        {
          "word_index": 5,
          "text": "وَلَهُمُ"
        },
        {
          "word_index": 6,
          "text": "ٱللَّعْنَةُ"
        },
        {
          "word_index": 7,
          "text": "وَلَهُمْ"
        },
        {
          "word_index": 8,
          "text": "سُوٓءُ"
        },
        {
          "word_index": 9,
          "text": "ٱلدَّارِ"
        }
      ]
    },
    {
      "surah_number": 40,
      "ayah_number": 53,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "ءَاتَيْنَا"
        },
        {
          "word_index": 2,
          "text": "مُوسَى"
        },
        {
          "word_index": 3,
          "text": "ٱلْهُدَىٰ"
        },
        {
          "word_index": 4,
          "text": "وَأَوْرَثْنَا"
        },
        {
          "word_index": 5,
          "text": "بَنِىٓ"
        },
        {
          "word_index": 6,
          "text": "إِسْرَٰٓءِيلَ"
        },
        {
          "word_index": 7,
          "text": "ٱلْكِتَـٰبَ"
        }
      ]
    },
    {
      "surah_number": 40,
      "ayah_number": 54,
      "words": [
        {
          "word_index": 0,
          "text": "هُدًۭى"
        },
        {
          "word_index": 1,
          "text": "وَذِكْرَىٰ"
        },
        {
          "word_index": 2,
          "text": "لِأُو۟لِى"
        },
        {
          "word_index": 3,
          "text": "ٱلْأَلْبَـٰبِ"
        }
      ]
    },
    {
      "surah_number": 40,
      "ayah_number": 55,
      "words": [
        {
          "word_index": 0,
          "text": "فَٱصْبِرْ"
        },
        {
          "word_index": 1,
          "text": "إِنَّ"
        },
        {
          "word_index": 2,
          "text": "وَعْدَ"
        },
        {
          "word_index": 3,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 4,
          "text": "حَقٌّۭ"
        },
        {
          "word_index": 5,
          "text": "وَٱسْتَغْفِرْ"
        },
        {
          "word_index": 6,
          "text": "لِذَنۢبِكَ"
        },
        {
          "word_index": 7,
          "text": "وَسَبِّحْ"
        },
        {
          "word_index": 8,
          "text": "بِحَمْدِ"
        },
        {
          "word_index": 9,
          "text": "رَبِّكَ"
        },
        {
          "word_index": 10,
          "text": "بِٱلْعَشِىِّ"
        },
        {
          "word_index": 11,
          "text": "وَٱلْإِبْكَـٰرِ"
        }
      ]
    },
    {
      "surah_number": 40,
      "ayah_number": 56,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّ"
        },
