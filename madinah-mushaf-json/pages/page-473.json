        {
          "word_index": 4,
          "text": "مِنْ"
        },
        {
          "word_index": 5,
          "text": "خَلْقِ"
        },
        {
          "word_index": 6,
          "text": "ٱلنَّاسِ"
        },
        {
          "word_index": 7,
          "text": "وَلَـٰكِنَّ"
