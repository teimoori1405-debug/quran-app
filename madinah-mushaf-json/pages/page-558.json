  "verses": [
    {
      "surah_number": 65,
      "ayah_number": 1,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلنَّبِىُّ"
        },
        {
          "word_index": 2,
          "text": "إِذَا"
        },
        {
