          "text": "طَلَّقْتُمُ"
        },
        {
          "word_index": 4,
          "text": "ٱلنِّسَآءَ"
        },
        {
          "word_index": 5,
          "text": "فَطَلِّقُوهُنَّ"
        },
        {
          "word_index": 6,
          "text": "لِعِدَّتِهِنَّ"
        },
        {
          "word_index": 7,
          "text": "وَأَحْصُوا۟"
