          "text": "مُّبَيِّنَةٍۢ ۚ"
        },
        {
          "word_index": 23,
          "text": "وَتِلْكَ"
        },
        {
          "word_index": 24,
          "text": "حُدُودُ"
        },
        {
          "word_index": 25,
          "text": "ٱللَّهِ ۚ"
        },
        {
