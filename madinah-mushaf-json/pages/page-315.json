  "verses": [
    {
      "surah_number": 20,
      "ayah_number": 52,
      "words": [
        {
          "word_index": 0,
          "text": "قَالَ"
        },
        {
          "word_index": 1,
          "text": "عِلْمُهَا"
        },
        {
          "word_index": 2,
          "text": "عِندَ"
        },
        {
          "word_index": 3,
          "text": "رَبِّى"
        },
        {
          "word_index": 4,
          "text": "فِى"
        },
        {
          "word_index": 5,
          "text": "كِتَـٰبٍۢ ۖ"
        },
        {
          "word_index": 6,
          "text": "لَّا"
        },
        {
          "word_index": 7,
          "text": "يَضِلُّ"
        },
        {
          "word_index": 8,
          "text": "رَبِّى"
        },
        {
          "word_index": 9,
          "text": "وَلَا"
        },
        {
          "word_index": 10,
          "text": "يَنسَى"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 53,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلَّذِى"
        },
        {
          "word_index": 1,
          "text": "جَعَلَ"
        },
        {
          "word_index": 2,
          "text": "لَكُمُ"
        },
        {
          "word_index": 3,
          "text": "ٱلْأَرْضَ"
        },
        {
          "word_index": 4,
          "text": "مَهْدًۭا"
        },
        {
          "word_index": 5,
          "text": "وَسَلَكَ"
        },
        {
          "word_index": 6,
          "text": "لَكُمْ"
        },
        {
          "word_index": 7,
          "text": "فِيهَا"
        },
        {
          "word_index": 8,
          "text": "سُبُلًۭا"
        },
        {
          "word_index": 9,
          "text": "وَأَنزَلَ"
        },
        {
          "word_index": 10,
          "text": "مِنَ"
        },
        {
          "word_index": 11,
          "text": "ٱلسَّمَآءِ"
        },
        {
          "word_index": 12,
          "text": "مَآءًۭ"
        },
        {
          "word_index": 13,
          "text": "فَأَخْرَجْنَا"
        },
        {
          "word_index": 14,
          "text": "بِهِۦٓ"
        },
        {
          "word_index": 15,
          "text": "أَزْوَٰجًۭا"
        },
        {
          "word_index": 16,
          "text": "مِّن"
        },
        {
          "word_index": 17,
          "text": "نَّبَاتٍۢ"
        },
        {
          "word_index": 18,
          "text": "شَتَّىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 54,
      "words": [
        {
          "word_index": 0,
          "text": "كُلُوا۟"
        },
        {
          "word_index": 1,
          "text": "وَٱرْعَوْا۟"
        },
        {
          "word_index": 2,
          "text": "أَنْعَـٰمَكُمْ ۗ"
        },
        {
          "word_index": 3,
          "text": "إِنَّ"
        },
        {
          "word_index": 4,
          "text": "فِى"
        },
        {
          "word_index": 5,
          "text": "ذَٰلِكَ"
        },
        {
          "word_index": 6,
          "text": "لَـَٔايَـٰتٍۢ"
        },
        {
          "word_index": 7,
          "text": "لِّأُو۟لِى"
        },
        {
          "word_index": 8,
          "text": "ٱلنُّهَىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 55,
      "words": [
        {
          "word_index": 0,
          "text": "۞ مِنْهَا"
        },
        {
          "word_index": 1,
          "text": "خَلَقْنَـٰكُمْ"
        },
        {
          "word_index": 2,
          "text": "وَفِيهَا"
        },
        {
          "word_index": 3,
          "text": "نُعِيدُكُمْ"
        },
        {
          "word_index": 4,
          "text": "وَمِنْهَا"
        },
        {
          "word_index": 5,
          "text": "نُخْرِجُكُمْ"
        },
        {
          "word_index": 6,
          "text": "تَارَةً"
        },
        {
          "word_index": 7,
          "text": "أُخْرَىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 56,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "أَرَيْنَـٰهُ"
        },
        {
          "word_index": 2,
          "text": "ءَايَـٰتِنَا"
        },
        {
          "word_index": 3,
          "text": "كُلَّهَا"
        },
        {
          "word_index": 4,
          "text": "فَكَذَّبَ"
        },
        {
          "word_index": 5,
          "text": "وَأَبَىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 57,
      "words": [
        {
          "word_index": 0,
          "text": "قَالَ"
        },
        {
          "word_index": 1,
          "text": "أَجِئْتَنَا"
        },
        {
          "word_index": 2,
          "text": "لِتُخْرِجَنَا"
        },
        {
          "word_index": 3,
          "text": "مِنْ"
        },
        {
          "word_index": 4,
          "text": "أَرْضِنَا"
        },
        {
          "word_index": 5,
          "text": "بِسِحْرِكَ"
        },
        {
          "word_index": 6,
          "text": "يَـٰمُوسَىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 58,
      "words": [
        {
          "word_index": 0,
          "text": "فَلَنَأْتِيَنَّكَ"
        },
        {
          "word_index": 1,
          "text": "بِسِحْرٍۢ"
        },
        {
          "word_index": 2,
          "text": "مِّثْلِهِۦ"
        },
        {
          "word_index": 3,
          "text": "فَٱجْعَلْ"
        },
        {
          "word_index": 4,
          "text": "بَيْنَنَا"
        },
        {
          "word_index": 5,
          "text": "وَبَيْنَكَ"
        },
        {
          "word_index": 6,
          "text": "مَوْعِدًۭا"
        },
        {
          "word_index": 7,
          "text": "لَّا"
        },
        {
          "word_index": 8,
          "text": "نُخْلِفُهُۥ"
        },
        {
          "word_index": 9,
          "text": "نَحْنُ"
        },
        {
          "word_index": 10,
          "text": "وَلَآ"
        },
        {
          "word_index": 11,
          "text": "أَنتَ"
        },
        {
          "word_index": 12,
          "text": "مَكَانًۭا"
        },
        {
          "word_index": 13,
          "text": "سُوًۭى"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 59,
      "words": [
        {
          "word_index": 0,
          "text": "قَالَ"
        },
        {
          "word_index": 1,
          "text": "مَوْعِدُكُمْ"
        },
        {
          "word_index": 2,
          "text": "يَوْمُ"
        },
        {
          "word_index": 3,
          "text": "ٱلزِّينَةِ"
        },
        {
          "word_index": 4,
          "text": "وَأَن"
        },
        {
          "word_index": 5,
          "text": "يُحْشَرَ"
        },
        {
          "word_index": 6,
          "text": "ٱلنَّاسُ"
        },
        {
          "word_index": 7,
          "text": "ضُحًۭى"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 60,
      "words": [
        {
          "word_index": 0,
          "text": "فَتَوَلَّىٰ"
        },
        {
          "word_index": 1,
          "text": "فِرْعَوْنُ"
        },
        {
          "word_index": 2,
          "text": "فَجَمَعَ"
        },
        {
          "word_index": 3,
          "text": "كَيْدَهُۥ"
        },
        {
          "word_index": 4,
          "text": "ثُمَّ"
        },
        {
          "word_index": 5,
          "text": "أَتَىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 61,
      "words": [
        {
          "word_index": 0,
          "text": "قَالَ"
        },
        {
          "word_index": 1,
          "text": "لَهُم"
        },
        {
          "word_index": 2,
          "text": "مُّوسَىٰ"
        },
        {
          "word_index": 3,
          "text": "وَيْلَكُمْ"
        },
        {
          "word_index": 4,
          "text": "لَا"
        },
        {
          "word_index": 5,
          "text": "تَفْتَرُوا۟"
        },
        {
          "word_index": 6,
          "text": "عَلَى"
        },
        {
          "word_index": 7,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 8,
          "text": "كَذِبًۭا"
        },
        {
          "word_index": 9,
          "text": "فَيُسْحِتَكُم"
        },
        {
          "word_index": 10,
          "text": "بِعَذَابٍۢ ۖ"
        },
        {
          "word_index": 11,
          "text": "وَقَدْ"
        },
        {
          "word_index": 12,
          "text": "خَابَ"
        },
        {
          "word_index": 13,
          "text": "مَنِ"
        },
        {
          "word_index": 14,
          "text": "ٱفْتَرَىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 62,
      "words": [
        {
          "word_index": 0,
          "text": "فَتَنَـٰزَعُوٓا۟"
        },
        {
          "word_index": 1,
          "text": "أَمْرَهُم"
        },
        {
          "word_index": 2,
          "text": "بَيْنَهُمْ"
        },
        {
          "word_index": 3,
          "text": "وَأَسَرُّوا۟"
        },
        {
          "word_index": 4,
          "text": "ٱلنَّجْوَىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 63,
      "words": [
        {
          "word_index": 0,
          "text": "قَالُوٓا۟"
        },
        {
          "word_index": 1,
          "text": "إِنْ"
        },
        {
          "word_index": 2,
          "text": "هَـٰذَٰنِ"
        },
        {
          "word_index": 3,
          "text": "لَسَـٰحِرَٰنِ"
        },
        {
          "word_index": 4,
          "text": "يُرِيدَانِ"
        },
        {
          "word_index": 5,
          "text": "أَن"
        },
        {
          "word_index": 6,
          "text": "يُخْرِجَاكُم"
        },
        {
          "word_index": 7,
          "text": "مِّنْ"
        },
        {
          "word_index": 8,
          "text": "أَرْضِكُم"
        },
        {
          "word_index": 9,
          "text": "بِسِحْرِهِمَا"
        },
        {
          "word_index": 10,
          "text": "وَيَذْهَبَا"
        },
        {
          "word_index": 11,
          "text": "بِطَرِيقَتِكُمُ"
        },
        {
          "word_index": 12,
          "text": "ٱلْمُثْلَىٰ"
        }
      ]
    },
    {
      "surah_number": 20,
      "ayah_number": 64,
      "words": [
