          "text": "بِوَٰلِدَيْهِ"
        },
        {
          "word_index": 3,
          "text": "حُسْنًۭا ۖ"
        },
        {
          "word_index": 4,
          "text": "وَإِن"
        },
        {
          "word_index": 5,
          "text": "جَـٰهَدَاكَ"
        },
        {
          "word_index": 6,
          "text": "لِتُشْرِكَ"
        },
