          "word_index": 15,
          "text": "إِلَىَّ"
        },
        {
          "word_index": 16,
          "text": "مَرْجِعُكُمْ"
        },
        {
          "word_index": 17,
          "text": "فَأُنَبِّئُكُم"
        },
        {
          "word_index": 18,
          "text": "بِمَا"
        },
