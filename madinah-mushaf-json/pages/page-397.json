      "words": [
        {
          "word_index": 0,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 2,
          "text": "وَعَمِلُوا۟"
        },
        {
          "word_index": 3,
          "text": "ٱلصَّـٰلِحَـٰتِ"
        },
        {
          "word_index": 4,
          "text": "لَنُكَفِّرَنَّ"
        },
        {
          "word_index": 5,
          "text": "عَنْهُمْ"
        },
        {
          "word_index": 6,
          "text": "سَيِّـَٔاتِهِمْ"
        },
        {
          "word_index": 7,
          "text": "وَلَنَجْزِيَنَّهُمْ"
        },
        {
          "word_index": 8,
          "text": "أَحْسَنَ"
        },
        {
          "word_index": 9,
          "text": "ٱلَّذِى"
        },
        {
          "word_index": 10,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 11,
          "text": "يَعْمَلُونَ"
        }
      ]
    },
    {
      "surah_number": 29,
      "ayah_number": 8,
      "words": [
        {
          "word_index": 0,
          "text": "وَوَصَّيْنَا"
        },
        {
          "word_index": 1,
          "text": "ٱلْإِنسَـٰنَ"
        },
        {
