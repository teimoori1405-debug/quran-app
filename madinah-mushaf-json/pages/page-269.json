      ]
    },
    {
      "surah_number": 16,
      "ayah_number": 16,
      "words": [
        {
          "word_index": 0,
          "text": "وَعَلَـٰمَـٰتٍۢ ۚ"
        },
        {
          "word_index": 1,
          "text": "وَبِٱلنَّجْمِ"
