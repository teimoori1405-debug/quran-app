          "text": "رَوَٰسِىَ"
        },
        {
          "word_index": 4,
          "text": "أَن"
        },
        {
          "word_index": 5,
          "text": "تَمِيدَ"
        },
        {
          "word_index": 6,
          "text": "بِكُمْ"
        },
        {
          "word_index": 7,
          "text": "وَأَنْهَـٰرًۭا"
        },
        {
          "word_index": 8,
          "text": "وَسُبُلًۭا"
