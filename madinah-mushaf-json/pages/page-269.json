          "text": "هُمْ"
        },
        {
          "word_index": 3,
          "text": "يَهْتَدُونَ"
        }
      ]
    },
    {
      "surah_number": 16,
      "ayah_number": 17,
      "words": [
        {
          "word_index": 0,
          "text": "أَفَمَن"
        },
        {
          "word_index": 1,
          "text": "يَخْلُقُ"
        },
        {
          "word_index": 2,
          "text": "كَمَن"
