  "verses": [
    {
      "surah_number": 58,
      "ayah_number": 22,
      "words": [
        {
          "word_index": 0,
          "text": "لَّا"
        },
        {
          "word_index": 1,
          "text": "تَجِدُ"
        },
        {
          "word_index": 2,
          "text": "قَوْمًۭا"
        },
        {
          "word_index": 3,
          "text": "يُؤْمِنُونَ"
        },
        {
          "word_index": 4,
          "text": "بِٱللَّهِ"
        },
        {
          "word_index": 5,
          "text": "وَٱلْيَوْمِ"
        },
        {
          "word_index": 6,
          "text": "ٱلْـَٔاخِرِ"
        },
        {
          "word_index": 7,
          "text": "يُوَآدُّونَ"
        },
        {
          "word_index": 8,
          "text": "مَنْ"
        },
        {
          "word_index": 9,
          "text": "حَآدَّ"
        },
        {
          "word_index": 10,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 11,
          "text": "وَرَسُولَهُۥ"
        },
        {
          "word_index": 12,
          "text": "وَلَوْ"
        },
        {
          "word_index": 13,
          "text": "كَانُوٓا۟"
        },
        {
          "word_index": 14,
          "text": "ءَابَآءَهُمْ"
        },
        {
          "word_index": 15,
          "text": "أَوْ"
        },
        {
          "word_index": 16,
          "text": "أَبْنَآءَهُمْ"
        },
        {
          "word_index": 17,
          "text": "أَوْ"
        },
        {
          "word_index": 18,
          "text": "إِخْوَٰنَهُمْ"
        },
        {
          "word_index": 19,
          "text": "أَوْ"
        },
        {
          "word_index": 20,
          "text": "عَشِيرَتَهُمْ ۚ"
        },
        {
          "word_index": 21,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 22,
          "text": "كَتَبَ"
        },
        {
          "word_index": 23,
          "text": "فِى"
        },
        {
          "word_index": 24,
          "text": "قُلُوبِهِمُ"
        },
        {
          "word_index": 25,
          "text": "ٱلْإِيمَـٰنَ"
        },
        {
          "word_index": 26,
          "text": "وَأَيَّدَهُم"
        },
        {
          "word_index": 27,
          "text": "بِرُوحٍۢ"
        },
        {
          "word_index": 28,
          "text": "مِّنْهُ ۖ"
        },
        {
          "word_index": 29,
          "text": "وَيُدْخِلُهُمْ"
        },
        {
          "word_index": 30,
          "text": "جَنَّـٰتٍۢ"
        },
        {
          "word_index": 31,
          "text": "تَجْرِى"
        },
        {
          "word_index": 32,
          "text": "مِن"
        },
        {
          "word_index": 33,
          "text": "تَحْتِهَا"
        },
        {
          "word_index": 34,
          "text": "ٱلْأَنْهَـٰرُ"
        },
        {
          "word_index": 35,
          "text": "خَـٰلِدِينَ"
        },
        {
          "word_index": 36,
          "text": "فِيهَا ۚ"
        },
        {
          "word_index": 37,
          "text": "رَضِىَ"
        },
        {
          "word_index": 38,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 39,
          "text": "عَنْهُمْ"
        },
        {
          "word_index": 40,
          "text": "وَرَضُوا۟"
        },
        {
          "word_index": 41,
          "text": "عَنْهُ ۚ"
        },
        {
          "word_index": 42,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 43,
          "text": "حِزْبُ"
        },
        {
          "word_index": 44,
          "text": "ٱللَّهِ ۚ"
        },
        {
          "word_index": 45,
          "text": "أَلَآ"
        },
        {
          "word_index": 46,
          "text": "إِنَّ"
        },
        {
          "word_index": 47,
          "text": "حِزْبَ"
        },
        {
          "word_index": 48,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 49,
          "text": "هُمُ"
        },
        {
          "word_index": 50,
          "text": "ٱلْمُفْلِحُونَ"
        }
      ]
    },
    {
