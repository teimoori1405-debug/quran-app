        {
          "word_index": 4,
          "text": "لَا"
        },
        {
          "word_index": 5,
          "text": "يَسْتَطِيعُونَ"
        },
        {
          "word_index": 6,
          "text": "نَصْرَكُمْ"
        },
        {
          "word_index": 7,
          "text": "وَلَآ"
        },
        {
          "word_index": 8,
          "text": "أَنفُسَهُمْ"
