          "text": "لَا"
        },
        {
          "word_index": 5,
          "text": "يَسْمَعُوا۟ ۖ"
        },
        {
          "word_index": 6,
          "text": "وَتَرَىٰهُمْ"
        },
        {
          "word_index": 7,
          "text": "يَنظُرُونَ"
