        },
        {
          "word_index": 2,
          "text": "وَكُلًّا"
        },
        {
          "word_index": 3,
          "text": "ءَاتَيْنَا"
        },
        {
          "word_index": 4,
          "text": "حُكْمًۭا"
        },
        {
          "word_index": 5,
          "text": "وَعِلْمًۭا ۚ"
        },
        {
          "word_index": 6,
          "text": "وَسَخَّرْنَا"
