        {
          "word_index": 4,
          "text": "فِى"
        },
        {
          "word_index": 5,
          "text": "ٱلْحَرْثِ"
        },
        {
          "word_index": 6,
          "text": "إِذْ"
        },
        {
          "word_index": 7,
          "text": "نَفَشَتْ"
