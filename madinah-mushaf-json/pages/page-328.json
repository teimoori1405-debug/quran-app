{
  "page": 328,
  "verses": [
    {
      "surah_number": 21,
      "ayah_number": 73,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَعَلْنَـٰهُمْ"
        },
        {
          "word_index": 1,
          "text": "أَئِمَّةًۭ"
        },
        {
          "word_index": 2,
          "text": "يَهْدُونَ"
        },
        {
          "word_index": 3,
          "text": "بِأَمْرِنَا"
        },
        {
          "word_index": 4,
          "text": "وَأَوْحَيْنَآ"
        },
        {
          "word_index": 5,
          "text": "إِلَيْهِمْ"
        },
        {
          "word_index": 6,
          "text": "فِعْلَ"
        },
        {
          "word_index": 7,
          "text": "ٱلْخَيْرَٰتِ"
        },
        {
          "word_index": 8,
          "text": "وَإِقَامَ"
        },
        {
          "word_index": 9,
          "text": "ٱلصَّلَوٰةِ"
        },
        {
          "word_index": 10,
          "text": "وَإِيتَآءَ"
        },
        {
          "word_index": 11,
          "text": "ٱلزَّكَوٰةِ ۖ"
        },
        {
          "word_index": 12,
          "text": "وَكَانُوا۟"
        },
        {
          "word_index": 13,
          "text": "لَنَا"
        },
        {
          "word_index": 14,
          "text": "عَـٰبِدِينَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 74,
      "words": [
        {
          "word_index": 0,
          "text": "وَلُوطًا"
        },
        {
          "word_index": 1,
          "text": "ءَاتَيْنَـٰهُ"
        },
        {
          "word_index": 2,
          "text": "حُكْمًۭا"
        },
        {
          "word_index": 3,
          "text": "وَعِلْمًۭا"
        },
        {
          "word_index": 4,
          "text": "وَنَجَّيْنَـٰهُ"
        },
        {
          "word_index": 5,
          "text": "مِنَ"
        },
        {
          "word_index": 6,
          "text": "ٱلْقَرْيَةِ"
        },
        {
          "word_index": 7,
          "text": "ٱلَّتِى"
        },
        {
          "word_index": 8,
          "text": "كَانَت"
        },
        {
          "word_index": 9,
          "text": "تَّعْمَلُ"
        },
        {
          "word_index": 10,
          "text": "ٱلْخَبَـٰٓئِثَ ۗ"
        },
        {
          "word_index": 11,
          "text": "إِنَّهُمْ"
        },
        {
          "word_index": 12,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 13,
          "text": "قَوْمَ"
        },
        {
          "word_index": 14,
          "text": "سَوْءٍۢ"
        },
        {
          "word_index": 15,
          "text": "فَـٰسِقِينَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 75,
      "words": [
        {
          "word_index": 0,
          "text": "وَأَدْخَلْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "فِى"
        },
        {
          "word_index": 2,
          "text": "رَحْمَتِنَآ ۖ"
        },
        {
          "word_index": 3,
          "text": "إِنَّهُۥ"
        },
        {
          "word_index": 4,
          "text": "مِنَ"
        },
        {
          "word_index": 5,
          "text": "ٱلصَّـٰلِحِينَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 76,
      "words": [
        {
          "word_index": 0,
          "text": "وَنُوحًا"
        },
        {
          "word_index": 1,
          "text": "إِذْ"
        },
        {
          "word_index": 2,
          "text": "نَادَىٰ"
        },
        {
          "word_index": 3,
          "text": "مِن"
        },
        {
          "word_index": 4,
          "text": "قَبْلُ"
        },
        {
          "word_index": 5,
          "text": "فَٱسْتَجَبْنَا"
        },
        {
          "word_index": 6,
          "text": "لَهُۥ"
        },
        {
          "word_index": 7,
          "text": "فَنَجَّيْنَـٰهُ"
        },
        {
          "word_index": 8,
          "text": "وَأَهْلَهُۥ"
        },
        {
          "word_index": 9,
          "text": "مِنَ"
        },
        {
          "word_index": 10,
          "text": "ٱلْكَرْبِ"
        },
        {
          "word_index": 11,
          "text": "ٱلْعَظِيمِ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 77,
      "words": [
        {
          "word_index": 0,
          "text": "وَنَصَرْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "مِنَ"
        },
        {
          "word_index": 2,
          "text": "ٱلْقَوْمِ"
        },
        {
          "word_index": 3,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 4,
          "text": "كَذَّبُوا۟"
        },
        {
          "word_index": 5,
          "text": "بِـَٔايَـٰتِنَآ ۚ"
        },
        {
          "word_index": 6,
          "text": "إِنَّهُمْ"
        },
        {
          "word_index": 7,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 8,
          "text": "قَوْمَ"
        },
        {
          "word_index": 9,
          "text": "سَوْءٍۢ"
        },
        {
          "word_index": 10,
          "text": "فَأَغْرَقْنَـٰهُمْ"
        },
        {
          "word_index": 11,
          "text": "أَجْمَعِينَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 78,
      "words": [
        {
          "word_index": 0,
          "text": "وَدَاوُۥدَ"
        },
        {
