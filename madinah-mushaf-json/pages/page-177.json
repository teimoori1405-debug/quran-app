{
  "page": 177,
  "verses": [
    {
      "surah_number": 8,
      "ayah_number": 1,
      "words": [
        {
          "word_index": 0,
          "text": "يَسْـَٔلُونَكَ"
        },
        {
          "word_index": 1,
          "text": "عَنِ"
        },
        {
          "word_index": 2,
          "text": "ٱلْأَنفَالِ ۖ"
        },
        {
          "word_index": 3,
          "text": "قُلِ"
        },
        {
          "word_index": 4,
          "text": "ٱلْأَنفَالُ"
        },
        {
          "word_index": 5,
          "text": "لِلَّهِ"
        },
        {
          "word_index": 6,
          "text": "وَٱلرَّسُولِ ۖ"
        },
        {
          "word_index": 7,
          "text": "فَٱتَّقُوا۟"
        },
        {
          "word_index": 8,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 9,
          "text": "وَأَصْلِحُوا۟"
        },
        {
          "word_index": 10,
          "text": "ذَاتَ"
        },
        {
          "word_index": 11,
          "text": "بَيْنِكُمْ ۖ"
        },
        {
          "word_index": 12,
          "text": "وَأَطِيعُوا۟"
        },
        {
          "word_index": 13,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 14,
          "text": "وَرَسُولَهُۥٓ"
        },
        {
          "word_index": 15,
          "text": "إِن"
        },
        {
          "word_index": 16,
          "text": "كُنتُم"
        },
        {
          "word_index": 17,
          "text": "مُّؤْمِنِينَ"
        }
      ]
    },
    {
      "surah_number": 8,
      "ayah_number": 2,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّمَا"
        },
        {
          "word_index": 1,
          "text": "ٱلْمُؤْمِنُونَ"
        },
        {
          "word_index": 2,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 3,
          "text": "إِذَا"
        },
        {
          "word_index": 4,
          "text": "ذُكِرَ"
        },
        {
          "word_index": 5,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 6,
          "text": "وَجِلَتْ"
        },
        {
          "word_index": 7,
          "text": "قُلُوبُهُمْ"
        },
        {
          "word_index": 8,
          "text": "وَإِذَا"
        },
        {
          "word_index": 9,
          "text": "تُلِيَتْ"
        },
        {
          "word_index": 10,
          "text": "عَلَيْهِمْ"
        },
        {
          "word_index": 11,
          "text": "ءَايَـٰتُهُۥ"
        },
        {
          "word_index": 12,
          "text": "زَادَتْهُمْ"
        },
        {
          "word_index": 13,
          "text": "إِيمَـٰنًۭا"
        },
        {
          "word_index": 14,
          "text": "وَعَلَىٰ"
        },
        {
          "word_index": 15,
          "text": "رَبِّهِمْ"
        },
        {
          "word_index": 16,
          "text": "يَتَوَكَّلُونَ"
        }
      ]
    },
    {
      "surah_number": 8,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "يُقِيمُونَ"
        },
        {
          "word_index": 2,
          "text": "ٱلصَّلَوٰةَ"
        },
        {
          "word_index": 3,
          "text": "وَمِمَّا"
        },
        {
          "word_index": 4,
          "text": "رَزَقْنَـٰهُمْ"
        },
        {
          "word_index": 5,
          "text": "يُنفِقُونَ"
        }
      ]
    },
    {
      "surah_number": 8,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 1,
          "text": "هُمُ"
        },
        {
          "word_index": 2,
          "text": "ٱلْمُؤْمِنُونَ"
        },
        {
          "word_index": 3,
          "text": "حَقًّۭا ۚ"
        },
        {
          "word_index": 4,
          "text": "لَّهُمْ"
        },
        {
          "word_index": 5,
          "text": "دَرَجَـٰتٌ"
        },
        {
          "word_index": 6,
          "text": "عِندَ"
        },
        {
          "word_index": 7,
          "text": "رَبِّهِمْ"
        },
        {
          "word_index": 8,
          "text": "وَمَغْفِرَةٌۭ"
        },
        {
          "word_index": 9,
          "text": "وَرِزْقٌۭ"
        },
        {
          "word_index": 10,
          "text": "كَرِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 8,
      "ayah_number": 5,
      "words": [
        {
          "word_index": 0,
          "text": "كَمَآ"
        },
        {
          "word_index": 1,
          "text": "أَخْرَجَكَ"
        },
        {
          "word_index": 2,
          "text": "رَبُّكَ"
        },
        {
          "word_index": 3,
          "text": "مِنۢ"
        },
        {
          "word_index": 4,
          "text": "بَيْتِكَ"
        },
        {
          "word_index": 5,
          "text": "بِٱلْحَقِّ"
        },
        {
          "word_index": 6,
          "text": "وَإِنَّ"
        },
        {
          "word_index": 7,
          "text": "فَرِيقًۭا"
        },
        {
          "word_index": 8,
          "text": "مِّنَ"
        },
        {
          "word_index": 9,
          "text": "ٱلْمُؤْمِنِينَ"
        },
        {
          "word_index": 10,
          "text": "لَكَـٰرِهُونَ"
        }
      ]
    },
    {
      "surah_number": 8,
      "ayah_number": 6,
      "words": [
        {
          "word_index": 0,
          "text": "يُجَـٰدِلُونَكَ"
        },
        {
          "word_index": 1,
          "text": "فِى"
        },
        {
          "word_index": 2,
          "text": "ٱلْحَقِّ"
        },
        {
          "word_index": 3,
          "text": "بَعْدَ مَا"
        },
        {
          "word_index": 4,
          "text": "تَبَيَّنَ"
        },
        {
          "word_index": 5,
          "text": "كَأَنَّمَا"
        },
        {
          "word_index": 6,
          "text": "يُسَاقُونَ"
        },
        {
          "word_index": 7,
          "text": "إِلَى"
        },
        {
          "word_index": 8,
          "text": "ٱلْمَوْتِ"
        },
        {
          "word_index": 9,
          "text": "وَهُمْ"
        },
        {
          "word_index": 10,
          "text": "يَنظُرُونَ"
        }
      ]
    },
    {
      "surah_number": 8,
      "ayah_number": 7,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِذْ"
        },
        {
          "word_index": 1,
          "text": "يَعِدُكُمُ"
        },
        {
          "word_index": 2,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 3,
          "text": "إِحْدَى"
        },
        {
          "word_index": 4,
          "text": "ٱلطَّآئِفَتَيْنِ"
        },
        {
          "word_index": 5,
          "text": "أَنَّهَا"
        },
        {
          "word_index": 6,
          "text": "لَكُمْ"
        },
        {
          "word_index": 7,
          "text": "وَتَوَدُّونَ"
        },
        {
          "word_index": 8,
          "text": "أَنَّ"
        },
        {
          "word_index": 9,
          "text": "غَيْرَ"
        },
        {
          "word_index": 10,
          "text": "ذَاتِ"
        },
        {
          "word_index": 11,
          "text": "ٱلشَّوْكَةِ"
        },
        {
          "word_index": 12,
          "text": "تَكُونُ"
        },
        {
          "word_index": 13,
          "text": "لَكُمْ"
        },
        {
          "word_index": 14,
          "text": "وَيُرِيدُ"
        },
        {
          "word_index": 15,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 16,
          "text": "أَن"
        },
        {
          "word_index": 17,
          "text": "يُحِقَّ"
        },
        {
          "word_index": 18,
          "text": "ٱلْحَقَّ"
        },
        {
          "word_index": 19,
          "text": "بِكَلِمَـٰتِهِۦ"
        },
        {
          "word_index": 20,
          "text": "وَيَقْطَعَ"
        },
        {
          "word_index": 21,
          "text": "دَابِرَ"
        },
        {
          "word_index": 22,
          "text": "ٱلْكَـٰفِرِينَ"
        }
      ]
    },
    {
      "surah_number": 8,
      "ayah_number": 8,
      "words": [
        {
          "word_index": 0,
          "text": "لِيُحِقَّ"
        },
        {
          "word_index": 1,
          "text": "ٱلْحَقَّ"
        },
        {
          "word_index": 2,
          "text": "وَيُبْطِلَ"
        },
        {
          "word_index": 3,
          "text": "ٱلْبَـٰطِلَ"
        },
        {
          "word_index": 4,
          "text": "وَلَوْ"
        },
        {
          "word_index": 5,
          "text": "كَرِهَ"
        },
        {
          "word_index": 6,
