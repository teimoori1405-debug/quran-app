          "text": "عَلَىٰٓ"
        },
        {
          "word_index": 4,
          "text": "أَعْيُنِهِمْ"
        },
        {
          "word_index": 5,
          "text": "فَٱسْتَبَقُوا۟"
        },
        {
          "word_index": 6,
          "text": "ٱلصِّرَٰطَ"
        },
        {
          "word_index": 7,
          "text": "فَأَنَّىٰ"
