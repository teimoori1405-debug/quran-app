  "verses": [
    {
      "surah_number": 36,
      "ayah_number": 55,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّ"
        },
        {
          "word_index": 1,
          "text": "أَصْحَـٰبَ"
        },
        {
          "word_index": 2,
          "text": "ٱلْجَنَّةِ"
        },
        {
          "word_index": 3,
          "text": "ٱلْيَوْمَ"
        },
        {
          "word_index": 4,
          "text": "فِى"
        },
        {
          "word_index": 5,
          "text": "شُغُلٍۢ"
        },
        {
          "word_index": 6,
          "text": "فَـٰكِهُونَ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 56,
      "words": [
        {
          "word_index": 0,
          "text": "هُمْ"
        },
        {
          "word_index": 1,
          "text": "وَأَزْوَٰجُهُمْ"
        },
        {
          "word_index": 2,
          "text": "فِى"
        },
        {
          "word_index": 3,
          "text": "ظِلَـٰلٍ"
        },
        {
          "word_index": 4,
          "text": "عَلَى"
        },
        {
          "word_index": 5,
          "text": "ٱلْأَرَآئِكِ"
        },
        {
          "word_index": 6,
          "text": "مُتَّكِـُٔونَ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 57,
      "words": [
        {
          "word_index": 0,
          "text": "لَهُمْ"
        },
        {
          "word_index": 1,
          "text": "فِيهَا"
        },
        {
          "word_index": 2,
          "text": "فَـٰكِهَةٌۭ"
        },
        {
          "word_index": 3,
          "text": "وَلَهُم"
        },
        {
          "word_index": 4,
          "text": "مَّا"
        },
        {
          "word_index": 5,
          "text": "يَدَّعُونَ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 58,
      "words": [
        {
          "word_index": 0,
          "text": "سَلَـٰمٌۭ"
        },
        {
          "word_index": 1,
          "text": "قَوْلًۭا"
        },
        {
          "word_index": 2,
          "text": "مِّن"
        },
        {
          "word_index": 3,
          "text": "رَّبٍّۢ"
        },
        {
          "word_index": 4,
          "text": "رَّحِيمٍۢ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 59,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱمْتَـٰزُوا۟"
        },
        {
          "word_index": 1,
          "text": "ٱلْيَوْمَ"
        },
        {
          "word_index": 2,
          "text": "أَيُّهَا"
        },
        {
          "word_index": 3,
          "text": "ٱلْمُجْرِمُونَ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 60,
      "words": [
        {
          "word_index": 0,
          "text": "۞ أَلَمْ"
        },
        {
          "word_index": 1,
          "text": "أَعْهَدْ"
        },
        {
          "word_index": 2,
          "text": "إِلَيْكُمْ"
        },
        {
          "word_index": 3,
          "text": "يَـٰبَنِىٓ"
        },
        {
          "word_index": 4,
          "text": "ءَادَمَ"
        },
        {
          "word_index": 5,
          "text": "أَن"
        },
        {
          "word_index": 6,
          "text": "لَّا"
        },
        {
          "word_index": 7,
          "text": "تَعْبُدُوا۟"
        },
        {
          "word_index": 8,
          "text": "ٱلشَّيْطَـٰنَ ۖ"
        },
        {
          "word_index": 9,
          "text": "إِنَّهُۥ"
        },
        {
          "word_index": 10,
          "text": "لَكُمْ"
        },
        {
          "word_index": 11,
          "text": "عَدُوٌّۭ"
        },
        {
          "word_index": 12,
          "text": "مُّبِينٌۭ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 61,
      "words": [
        {
          "word_index": 0,
          "text": "وَأَنِ"
        },
        {
          "word_index": 1,
          "text": "ٱعْبُدُونِى ۚ"
        },
        {
          "word_index": 2,
          "text": "هَـٰذَا"
        },
        {
          "word_index": 3,
          "text": "صِرَٰطٌۭ"
        },
        {
          "word_index": 4,
          "text": "مُّسْتَقِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 62,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "أَضَلَّ"
        },
        {
          "word_index": 2,
          "text": "مِنكُمْ"
        },
        {
          "word_index": 3,
          "text": "جِبِلًّۭا"
        },
        {
          "word_index": 4,
          "text": "كَثِيرًا ۖ"
        },
        {
          "word_index": 5,
          "text": "أَفَلَمْ"
        },
        {
          "word_index": 6,
          "text": "تَكُونُوا۟"
        },
        {
          "word_index": 7,
          "text": "تَعْقِلُونَ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 63,
      "words": [
        {
          "word_index": 0,
          "text": "هَـٰذِهِۦ"
        },
        {
          "word_index": 1,
          "text": "جَهَنَّمُ"
        },
        {
          "word_index": 2,
          "text": "ٱلَّتِى"
        },
        {
          "word_index": 3,
          "text": "كُنتُمْ"
        },
        {
          "word_index": 4,
          "text": "تُوعَدُونَ"
        }
      ]
    },
    {
      "surah_number": 36,
      "ayah_number": 64,
      "words": [
        {
          "word_index": 0,
          "text": "ٱصْلَوْهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلْيَوْمَ"
        },
        {
          "word_index": 2,
          "text": "بِمَا"
        },
        {
          "word_index": 3,
          "text": "كُنتُمْ"
        },
        {
          "word_index": 4,
          "text": "تَكْفُرُونَ"
