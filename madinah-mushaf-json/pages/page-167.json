        {
          "word_index": 4,
          "text": "فِرْعَوْنَ"
        },
        {
          "word_index": 5,
          "text": "يَسُومُونَكُمْ"
        },
        {
          "word_index": 6,
          "text": "سُوٓءَ"
        },
        {
          "word_index": 7,
          "text": "ٱلْعَذَابِ ۖ"
