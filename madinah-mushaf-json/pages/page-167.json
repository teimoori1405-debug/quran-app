        {
          "word_index": 14,
          "text": "لَّنَآ"
        },
        {
          "word_index": 15,
          "text": "إِلَـٰهًۭا"
        },
        {
          "word_index": 16,
          "text": "كَمَا"
        },
        {
          "word_index": 17,
          "text": "لَهُمْ"
        },
        {
          "word_index": 18,
          "text": "ءَالِهَةٌۭ ۚ"
        },
        {
          "word_index": 19,
          "text": "قَالَ"
        },
        {
          "word_index": 20,
          "text": "إِنَّكُمْ"
        },
        {
          "word_index": 21,
          "text": "قَوْمٌۭ"
        },
        {
          "word_index": 22,
          "text": "تَجْهَلُونَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 139,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّ"
        },
        {
          "word_index": 1,
          "text": "هَـٰٓؤُلَآءِ"
        },
        {
          "word_index": 2,
          "text": "مُتَبَّرٌۭ"
        },
        {
          "word_index": 3,
          "text": "مَّا"
        },
        {
          "word_index": 4,
          "text": "هُمْ"
        },
        {
          "word_index": 5,
          "text": "فِيهِ"
        },
        {
          "word_index": 6,
          "text": "وَبَـٰطِلٌۭ"
        },
        {
          "word_index": 7,
          "text": "مَّا"
        },
        {
          "word_index": 8,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 9,
          "text": "يَعْمَلُونَ"
