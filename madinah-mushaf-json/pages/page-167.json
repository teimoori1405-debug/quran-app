  "verses": [
    {
      "surah_number": 7,
      "ayah_number": 138,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَـٰوَزْنَا"
        },
        {
          "word_index": 1,
          "text": "بِبَنِىٓ"
        },
        {
          "word_index": 2,
          "text": "إِسْرَٰٓءِيلَ"
        },
        {
          "word_index": 3,
          "text": "ٱلْبَحْرَ"
        },
        {
          "word_index": 4,
          "text": "فَأَتَوْا۟"
        },
        {
          "word_index": 5,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 6,
          "text": "قَوْمٍۢ"
        },
        {
          "word_index": 7,
          "text": "يَعْكُفُونَ"
        },
        {
          "word_index": 8,
          "text": "عَلَىٰٓ"
        },
        {
          "word_index": 9,
          "text": "أَصْنَامٍۢ"
        },
        {
          "word_index": 10,
          "text": "لَّهُمْ ۚ"
        },
        {
          "word_index": 11,
          "text": "قَالُوا۟"
        },
        {
          "word_index": 12,
          "text": "يَـٰمُوسَى"
        },
        {
          "word_index": 13,
          "text": "ٱجْعَل"
