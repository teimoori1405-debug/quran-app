          "text": "تَرْهَقُهُمْ"
        },
        {
          "word_index": 3,
          "text": "ذِلَّةٌۭ ۖ"
        },
        {
          "word_index": 4,
          "text": "وَقَدْ"
        },
        {
          "word_index": 5,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 6,
          "text": "يُدْعَوْنَ"
        },
        {
          "word_index": 7,
          "text": "إِلَى"
        },
