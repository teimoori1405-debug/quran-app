          "word_index": 3,
          "text": "بِهَـٰذَا"
        },
        {
          "word_index": 4,
          "text": "ٱلْحَدِيثِ ۖ"
        },
        {
          "word_index": 5,
          "text": "سَنَسْتَدْرِجُهُم"
        },
        {
          "word_index": 6,
          "text": "مِّنْ"
        },
        {
          "word_index": 7,
          "text": "حَيْثُ"
        },
        {
