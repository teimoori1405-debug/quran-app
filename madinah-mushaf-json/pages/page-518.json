      "ayah_number": 2,
      "words": [
        {
          "word_index": 0,
          "text": "بَلْ"
        },
        {
          "word_index": 1,
          "text": "عَجِبُوٓا۟"
        },
        {
          "word_index": 2,
          "text": "أَن"
        },
        {
          "word_index": 3,
          "text": "جَآءَهُم"
        },
        {
          "word_index": 4,
          "text": "مُّنذِرٌۭ"
        },
        {
          "word_index": 5,
          "text": "مِّنْهُمْ"
        },
        {
          "word_index": 6,
          "text": "فَقَالَ"
        },
        {
          "word_index": 7,
          "text": "ٱلْكَـٰفِرُونَ"
        },
        {
          "word_index": 8,
          "text": "هَـٰذَا"
