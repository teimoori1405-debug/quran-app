      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "أَءِذَا"
        },
        {
          "word_index": 1,
          "text": "مِتْنَا"
        },
        {
          "word_index": 2,
          "text": "وَكُنَّا"
        },
        {
          "word_index": 3,
          "text": "تُرَابًۭا ۖ"
        },
        {
          "word_index": 4,
          "text": "ذَٰلِكَ"
        },
        {
          "word_index": 5,
          "text": "رَجْعٌۢ"
        },
        {
          "word_index": 6,
          "text": "بَعِيدٌۭ"
        }
      ]
    },
    {
      "surah_number": 50,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "قَدْ"
        },
        {
          "word_index": 1,
          "text": "عَلِمْنَا"
