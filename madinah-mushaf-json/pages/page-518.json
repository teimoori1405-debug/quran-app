          "text": "ٱلْأَرْضُ"
        },
        {
          "word_index": 5,
          "text": "مِنْهُمْ ۖ"
        },
        {
          "word_index": 6,
          "text": "وَعِندَنَا"
        },
        {
          "word_index": 7,
          "text": "كِتَـٰبٌ"
        },
        {
          "word_index": 8,
          "text": "حَفِيظٌۢ"
