        },
        {
          "word_index": 15,
          "text": "ٱلْحَكِيمُ"
        }
      ]
    },
    {
      "surah_number": 40,
      "ayah_number": 9,
      "words": [
        {
          "word_index": 0,
          "text": "وَقِهِمُ"
        },
        {
          "word_index": 1,
          "text": "ٱلسَّيِّـَٔاتِ ۚ"
        },
