          "word_index": 5,
          "text": "قَوْمًا"
        },
        {
          "word_index": 6,
          "text": "عَالِينَ"
        }
      ]
    },
    {
      "surah_number": 23,
      "ayah_number": 47,
      "words": [
        {
          "word_index": 0,
          "text": "فَقَالُوٓا۟"
