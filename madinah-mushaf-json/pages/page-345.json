        {
          "word_index": 5,
          "text": "بِـَٔايَـٰتِنَا"
        },
        {
          "word_index": 6,
          "text": "وَسُلْطَـٰنٍۢ"
        },
        {
          "word_index": 7,
          "text": "مُّبِينٍ"
        }
      ]
    },
    {
      "surah_number": 23,
      "ayah_number": 46,
      "words": [
        {
          "word_index": 0,
          "text": "إِلَىٰ"
        },
