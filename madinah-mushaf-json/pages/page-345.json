        {
          "word_index": 12,
          "text": "بَعْضًۭا"
        },
        {
          "word_index": 13,
          "text": "وَجَعَلْنَـٰهُمْ"
        },
        {
          "word_index": 14,
          "text": "أَحَادِيثَ ۚ"
        },
        {
          "word_index": 15,
          "text": "فَبُعْدًۭا"
        },
        {
          "word_index": 16,
          "text": "لِّقَوْمٍۢ"
        },
        {
          "word_index": 17,
          "text": "لَّا"
        },
        {
