          "text": "رُسُلَنَا"
        },
        {
          "word_index": 3,
          "text": "تَتْرَا ۖ"
        },
        {
          "word_index": 4,
          "text": "كُلَّ"
        },
        {
          "word_index": 5,
          "text": "مَا"
        },
        {
          "word_index": 6,
          "text": "جَآءَ"
        },
        {
          "word_index": 7,
          "text": "أُمَّةًۭ"
        },
        {
          "word_index": 8,
          "text": "رَّسُولُهَا"
        },
        {
          "word_index": 9,
          "text": "كَذَّبُوهُ ۚ"
        },
        {
          "word_index": 10,
          "text": "فَأَتْبَعْنَا"
