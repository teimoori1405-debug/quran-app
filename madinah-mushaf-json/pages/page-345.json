        {
          "word_index": 5,
          "text": "لَنَا"
        },
        {
          "word_index": 6,
          "text": "عَـٰبِدُونَ"
        }
      ]
    },
    {
      "surah_number": 23,
      "ayah_number": 48,
      "words": [
        {
          "word_index": 0,
          "text": "فَكَذَّبُوهُمَا"
