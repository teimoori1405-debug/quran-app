          "text": "فِى"
        },
        {
          "word_index": 28,
          "text": "ٱلْأَرْضِ"
        },
        {
          "word_index": 29,
          "text": "بَعْدَ"
        },
        {
          "word_index": 30,
          "text": "إِصْلَـٰحِهَا ۚ"
        },
        {
          "word_index": 31,
          "text": "ذَٰلِكُمْ"
        },
