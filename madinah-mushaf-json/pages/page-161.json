          "word_index": 14,
          "text": "جَآءَتْكُم"
        },
        {
          "word_index": 15,
          "text": "بَيِّنَةٌۭ"
        },
        {
          "word_index": 16,
          "text": "مِّن"
        },
        {
          "word_index": 17,
          "text": "رَّبِّكُمْ ۖ"
        },
        {
          "word_index": 18,
          "text": "فَأَوْفُوا۟"
        },
        {
          "word_index": 19,
          "text": "ٱلْكَيْلَ"
        },
        {
          "word_index": 20,
          "text": "وَٱلْمِيزَانَ"
        },
        {
          "word_index": 21,
          "text": "وَلَا"
        },
        {
          "word_index": 22,
          "text": "تَبْخَسُوا۟"
        },
