  "verses": [
    {
      "surah_number": 7,
      "ayah_number": 82,
      "words": [
        {
          "word_index": 0,
          "text": "وَمَا"
        },
        {
          "word_index": 1,
          "text": "كَانَ"
        },
        {
          "word_index": 2,
          "text": "جَوَابَ"
        },
        {
          "word_index": 3,
          "text": "قَوْمِهِۦٓ"
        },
        {
          "word_index": 4,
          "text": "إِلَّآ"
        },
        {
          "word_index": 5,
          "text": "أَن"
        },
        {
          "word_index": 6,
          "text": "قَالُوٓا۟"
        },
        {
          "word_index": 7,
          "text": "أَخْرِجُوهُم"
        },
        {
          "word_index": 8,
          "text": "مِّن"
        },
        {
          "word_index": 9,
          "text": "قَرْيَتِكُمْ ۖ"
        },
        {
          "word_index": 10,
          "text": "إِنَّهُمْ"
        },
        {
          "word_index": 11,
          "text": "أُنَاسٌۭ"
        },
        {
          "word_index": 12,
          "text": "يَتَطَهَّرُونَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 83,
      "words": [
        {
          "word_index": 0,
          "text": "فَأَنجَيْنَـٰهُ"
        },
        {
          "word_index": 1,
          "text": "وَأَهْلَهُۥٓ"
        },
        {
          "word_index": 2,
          "text": "إِلَّا"
        },
        {
          "word_index": 3,
          "text": "ٱمْرَأَتَهُۥ"
        },
        {
          "word_index": 4,
          "text": "كَانَتْ"
        },
        {
          "word_index": 5,
          "text": "مِنَ"
        },
        {
          "word_index": 6,
          "text": "ٱلْغَـٰبِرِينَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 84,
      "words": [
        {
          "word_index": 0,
          "text": "وَأَمْطَرْنَا"
        },
        {
          "word_index": 1,
          "text": "عَلَيْهِم"
        },
        {
          "word_index": 2,
          "text": "مَّطَرًۭا ۖ"
        },
        {
          "word_index": 3,
          "text": "فَٱنظُرْ"
        },
        {
          "word_index": 4,
          "text": "كَيْفَ"
        },
        {
          "word_index": 5,
          "text": "كَانَ"
        },
        {
          "word_index": 6,
          "text": "عَـٰقِبَةُ"
        },
        {
          "word_index": 7,
          "text": "ٱلْمُجْرِمِينَ"
        }
      ]
    },
    {
      "surah_number": 7,
      "ayah_number": 85,
      "words": [
        {
          "word_index": 0,
          "text": "وَإِلَىٰ"
        },
        {
          "word_index": 1,
          "text": "مَدْيَنَ"
        },
        {
          "word_index": 2,
          "text": "أَخَاهُمْ"
        },
        {
          "word_index": 3,
          "text": "شُعَيْبًۭا ۗ"
        },
        {
          "word_index": 4,
          "text": "قَالَ"
        },
        {
          "word_index": 5,
          "text": "يَـٰقَوْمِ"
        },
        {
          "word_index": 6,
          "text": "ٱعْبُدُوا۟"
        },
        {
          "word_index": 7,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 8,
          "text": "مَا"
        },
        {
          "word_index": 9,
          "text": "لَكُم"
        },
        {
          "word_index": 10,
          "text": "مِّنْ"
        },
        {
          "word_index": 11,
          "text": "إِلَـٰهٍ"
