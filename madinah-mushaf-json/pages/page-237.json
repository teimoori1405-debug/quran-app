{
  "page": 237,
  "verses": [
    {
      "surah_number": 12,
      "ayah_number": 15,
      "words": [
        {
          "word_index": 0,
          "text": "فَلَمَّا"
        },
        {
          "word_index": 1,
          "text": "ذَهَبُوا۟"
        },
        {
          "word_index": 2,
          "text": "بِهِۦ"
        },
        {
          "word_index": 3,
          "text": "وَأَجْمَعُوٓا۟"
        },
        {
          "word_index": 4,
          "text": "أَن"
        },
        {
          "word_index": 5,
          "text": "يَجْعَلُوهُ"
        },
        {
          "word_index": 6,
          "text": "فِى"
        },
        {
          "word_index": 7,
          "text": "غَيَـٰبَتِ"
        },
        {
          "word_index": 8,
          "text": "ٱلْجُبِّ ۚ"
        },
        {
          "word_index": 9,
          "text": "وَأَوْحَيْنَآ"
        },
        {
          "word_index": 10,
          "text": "إِلَيْهِ"
        },
        {
          "word_index": 11,
          "text": "لَتُنَبِّئَنَّهُم"
        },
        {
          "word_index": 12,
          "text": "بِأَمْرِهِمْ"
        },
        {
          "word_index": 13,
          "text": "هَـٰذَا"
        },
        {
          "word_index": 14,
          "text": "وَهُمْ"
        },
        {
          "word_index": 15,
          "text": "لَا"
        },
        {
          "word_index": 16,
          "text": "يَشْعُرُونَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 16,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَآءُوٓ"
        },
        {
          "word_index": 1,
          "text": "أَبَاهُمْ"
        },
        {
          "word_index": 2,
          "text": "عِشَآءًۭ"
        },
        {
          "word_index": 3,
          "text": "يَبْكُونَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 17,
      "words": [
        {
          "word_index": 0,
          "text": "قَالُوا۟"
        },
        {
          "word_index": 1,
          "text": "يَـٰٓأَبَانَآ"
        },
        {
          "word_index": 2,
          "text": "إِنَّا"
        },
        {
          "word_index": 3,
          "text": "ذَهَبْنَا"
        },
        {
          "word_index": 4,
          "text": "نَسْتَبِقُ"
        },
        {
          "word_index": 5,
          "text": "وَتَرَكْنَا"
        },
        {
          "word_index": 6,
          "text": "يُوسُفَ"
        },
        {
          "word_index": 7,
          "text": "عِندَ"
        },
        {
          "word_index": 8,
          "text": "مَتَـٰعِنَا"
        },
        {
          "word_index": 9,
          "text": "فَأَكَلَهُ"
        },
        {
          "word_index": 10,
          "text": "ٱلذِّئْبُ ۖ"
        },
        {
          "word_index": 11,
          "text": "وَمَآ"
        },
        {
          "word_index": 12,
          "text": "أَنتَ"
        },
        {
          "word_index": 13,
          "text": "بِمُؤْمِنٍۢ"
        },
        {
          "word_index": 14,
          "text": "لَّنَا"
        },
        {
          "word_index": 15,
          "text": "وَلَوْ"
        },
        {
          "word_index": 16,
          "text": "كُنَّا"
        },
        {
          "word_index": 17,
          "text": "صَـٰدِقِينَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 18,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَآءُو"
        },
        {
          "word_index": 1,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 2,
          "text": "قَمِيصِهِۦ"
        },
        {
          "word_index": 3,
          "text": "بِدَمٍۢ"
        },
        {
          "word_index": 4,
          "text": "كَذِبٍۢ ۚ"
        },
        {
          "word_index": 5,
          "text": "قَالَ"
        },
        {
          "word_index": 6,
          "text": "بَلْ"
        },
        {
          "word_index": 7,
          "text": "سَوَّلَتْ"
        },
        {
          "word_index": 8,
          "text": "لَكُمْ"
        },
        {
          "word_index": 9,
          "text": "أَنفُسُكُمْ"
        },
        {
          "word_index": 10,
          "text": "أَمْرًۭا ۖ"
        },
        {
          "word_index": 11,
          "text": "فَصَبْرٌۭ"
        },
        {
          "word_index": 12,
          "text": "جَمِيلٌۭ ۖ"
        },
        {
          "word_index": 13,
          "text": "وَٱللَّهُ"
        },
        {
          "word_index": 14,
          "text": "ٱلْمُسْتَعَانُ"
        },
        {
          "word_index": 15,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 16,
          "text": "مَا"
        },
        {
          "word_index": 17,
          "text": "تَصِفُونَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 19,
      "words": [
        {
          "word_index": 0,
          "text": "وَجَآءَتْ"
        },
        {
          "word_index": 1,
          "text": "سَيَّارَةٌۭ"
        },
        {
          "word_index": 2,
          "text": "فَأَرْسَلُوا۟"
        },
        {
          "word_index": 3,
          "text": "وَارِدَهُمْ"
        },
        {
          "word_index": 4,
          "text": "فَأَدْلَىٰ"
        },
        {
          "word_index": 5,
          "text": "دَلْوَهُۥ ۖ"
        },
        {
          "word_index": 6,
          "text": "قَالَ"
        },
        {
          "word_index": 7,
          "text": "يَـٰبُشْرَىٰ"
        },
        {
          "word_index": 8,
          "text": "هَـٰذَا"
        },
        {
          "word_index": 9,
          "text": "غُلَـٰمٌۭ ۚ"
        },
        {
          "word_index": 10,
          "text": "وَأَسَرُّوهُ"
        },
        {
          "word_index": 11,
          "text": "بِضَـٰعَةًۭ ۚ"
        },
        {
          "word_index": 12,
          "text": "وَٱللَّهُ"
        },
        {
          "word_index": 13,
          "text": "عَلِيمٌۢ"
        },
        {
          "word_index": 14,
          "text": "بِمَا"
        },
        {
          "word_index": 15,
          "text": "يَعْمَلُونَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 20,
      "words": [
        {
          "word_index": 0,
          "text": "وَشَرَوْهُ"
        },
        {
          "word_index": 1,
          "text": "بِثَمَنٍۭ"
        },
        {
          "word_index": 2,
          "text": "بَخْسٍۢ"
        },
        {
          "word_index": 3,
          "text": "دَرَٰهِمَ"
        },
        {
          "word_index": 4,
          "text": "مَعْدُودَةٍۢ"
        },
        {
          "word_index": 5,
          "text": "وَكَانُوا۟"
        },
        {
          "word_index": 6,
          "text": "فِيهِ"
        },
        {
          "word_index": 7,
          "text": "مِنَ"
        },
        {
          "word_index": 8,
          "text": "ٱلزَّٰهِدِينَ"
        }
      ]
    },
    {
      "surah_number": 12,
      "ayah_number": 21,
      "words": [
        {
          "word_index": 0,
          "text": "وَقَالَ"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِى"
        },
        {
          "word_index": 2,
          "text": "ٱشْتَرَىٰهُ"
        },
        {
          "word_index": 3,
          "text": "مِن"
        },
        {
          "word_index": 4,
          "text": "مِّصْرَ"
        },
        {
          "word_index": 5,
          "text": "لِٱمْرَأَتِهِۦٓ"
        },
        {
          "word_index": 6,
          "text": "أَكْرِمِى"
        },
        {
          "word_index": 7,
          "text": "مَثْوَىٰهُ"
        },
        {
          "word_index": 8,
          "text": "عَسَىٰٓ"
        },
        {
          "word_index": 9,
          "text": "أَن"
        },
        {
          "word_index": 10,
          "text": "يَنفَعَنَآ"
        },
        {
          "word_index": 11,
          "text": "أَوْ"
        },
        {
          "word_index": 12,
          "text": "نَتَّخِذَهُۥ"
        },
        {
          "word_index": 13,
          "text": "وَلَدًۭا ۚ"
        },
        {
          "word_index": 14,
          "text": "وَكَذَٰلِكَ"
        },
        {
          "word_index": 15,
          "text": "مَكَّنَّا"
        },
        {
          "word_index": 16,
          "text": "لِيُوسُفَ"
        },
        {
          "word_index": 17,
          "text": "فِى"
        },
        {
          "word_index": 18,
          "text": "ٱلْأَرْضِ"
        },
        {
          "word_index": 19,
          "text": "وَلِنُعَلِّمَهُۥ"
        },
        {
          "word_index": 20,
          "text": "مِن"
        },
        {
          "word_index": 21,
          "text": "تَأْوِيلِ"
        },
        {
          "word_index": 22,
          "text": "ٱلْأَحَادِيثِ ۚ"
        },
        {
          "word_index": 23,
          "text": "وَٱللَّهُ"
        },
        {
          "word_index": 24,
          "text": "غَالِبٌ"
        },
        {
          "word_index": 25,
          "text": "عَلَىٰٓ"
        },
        {
          "word_index": 26,
          "text": "أَمْرِهِۦ"
        },
        {
          "word_index": 27,
          "text": "وَلَـٰكِنَّ"
        },
        {
          "word_index": 28,
          "text": "أَكْثَرَ"
        },
        {
          "word_index": 29,
          "text": "ٱلنَّاسِ"
        },
        {
          "word_index": 30,
          "text": "لَا"
        },
        {
          "word_index": 31,
          "text": "يَعْلَمُونَ"
        }
      ]
    },
    {
