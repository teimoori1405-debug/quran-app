          "text": "وَلَمَّا"
        },
        {
          "word_index": 1,
          "text": "بَلَغَ"
        },
        {
          "word_index": 2,
          "text": "أَشُدَّهُۥٓ"
        },
        {
          "word_index": 3,
          "text": "ءَاتَيْنَـٰهُ"
