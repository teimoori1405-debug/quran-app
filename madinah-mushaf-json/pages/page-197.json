{
  "page": 197,
  "verses": [
    {
      "surah_number": 9,
      "ayah_number": 62,
      "words": [
        {
          "word_index": 0,
          "text": "يَحْلِفُونَ"
        },
        {
          "word_index": 1,
          "text": "بِٱللَّهِ"
        },
        {
          "word_index": 2,
          "text": "لَكُمْ"
        },
        {
          "word_index": 3,
          "text": "لِيُرْضُوكُمْ"
        },
        {
          "word_index": 4,
          "text": "وَٱللَّهُ"
        },
        {
          "word_index": 5,
          "text": "وَرَسُولُهُۥٓ"
        },
        {
          "word_index": 6,
          "text": "أَحَقُّ"
        },
        {
          "word_index": 7,
          "text": "أَن"
        },
        {
          "word_index": 8,
          "text": "يُرْضُوهُ"
        },
        {
          "word_index": 9,
          "text": "إِن"
        },
        {
          "word_index": 10,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 11,
          "text": "مُؤْمِنِينَ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 63,
      "words": [
        {
          "word_index": 0,
          "text": "أَلَمْ"
        },
        {
          "word_index": 1,
          "text": "يَعْلَمُوٓا۟"
        },
        {
          "word_index": 2,
          "text": "أَنَّهُۥ"
        },
        {
          "word_index": 3,
          "text": "مَن"
        },
        {
          "word_index": 4,
          "text": "يُحَادِدِ"
        },
        {
          "word_index": 5,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 6,
          "text": "وَرَسُولَهُۥ"
        },
        {
          "word_index": 7,
          "text": "فَأَنَّ"
        },
        {
          "word_index": 8,
          "text": "لَهُۥ"
        },
        {
          "word_index": 9,
          "text": "نَارَ"
        },
        {
          "word_index": 10,
          "text": "جَهَنَّمَ"
        },
        {
          "word_index": 11,
          "text": "خَـٰلِدًۭا"
        },
        {
          "word_index": 12,
          "text": "فِيهَا ۚ"
        },
        {
          "word_index": 13,
          "text": "ذَٰلِكَ"
        },
        {
          "word_index": 14,
          "text": "ٱلْخِزْىُ"
        },
        {
          "word_index": 15,
          "text": "ٱلْعَظِيمُ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 64,
      "words": [
        {
          "word_index": 0,
          "text": "يَحْذَرُ"
        },
        {
          "word_index": 1,
          "text": "ٱلْمُنَـٰفِقُونَ"
        },
        {
          "word_index": 2,
          "text": "أَن"
        },
        {
          "word_index": 3,
          "text": "تُنَزَّلَ"
        },
        {
          "word_index": 4,
          "text": "عَلَيْهِمْ"
        },
        {
          "word_index": 5,
          "text": "سُورَةٌۭ"
        },
        {
          "word_index": 6,
          "text": "تُنَبِّئُهُم"
        },
        {
          "word_index": 7,
          "text": "بِمَا"
        },
        {
          "word_index": 8,
          "text": "فِى"
        },
        {
          "word_index": 9,
          "text": "قُلُوبِهِمْ ۚ"
        },
        {
          "word_index": 10,
          "text": "قُلِ"
        },
        {
          "word_index": 11,
          "text": "ٱسْتَهْزِءُوٓا۟"
        },
        {
          "word_index": 12,
          "text": "إِنَّ"
        },
        {
          "word_index": 13,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 14,
          "text": "مُخْرِجٌۭ"
        },
        {
          "word_index": 15,
          "text": "مَّا"
        },
        {
          "word_index": 16,
          "text": "تَحْذَرُونَ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 65,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَئِن"
        },
        {
          "word_index": 1,
          "text": "سَأَلْتَهُمْ"
        },
        {
          "word_index": 2,
          "text": "لَيَقُولُنَّ"
        },
        {
          "word_index": 3,
          "text": "إِنَّمَا"
        },
        {
          "word_index": 4,
          "text": "كُنَّا"
        },
        {
          "word_index": 5,
          "text": "نَخُوضُ"
        },
        {
          "word_index": 6,
          "text": "وَنَلْعَبُ ۚ"
        },
        {
          "word_index": 7,
          "text": "قُلْ"
        },
        {
          "word_index": 8,
          "text": "أَبِٱللَّهِ"
        },
        {
          "word_index": 9,
          "text": "وَءَايَـٰتِهِۦ"
        },
        {
          "word_index": 10,
          "text": "وَرَسُولِهِۦ"
        },
        {
          "word_index": 11,
          "text": "كُنتُمْ"
        },
        {
          "word_index": 12,
          "text": "تَسْتَهْزِءُونَ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 66,
      "words": [
        {
          "word_index": 0,
          "text": "لَا"
        },
        {
          "word_index": 1,
          "text": "تَعْتَذِرُوا۟"
        },
        {
          "word_index": 2,
          "text": "قَدْ"
        },
        {
          "word_index": 3,
          "text": "كَفَرْتُم"
        },
        {
          "word_index": 4,
          "text": "بَعْدَ"
        },
        {
          "word_index": 5,
          "text": "إِيمَـٰنِكُمْ ۚ"
        },
        {
          "word_index": 6,
          "text": "إِن"
        },
        {
          "word_index": 7,
          "text": "نَّعْفُ"
        },
        {
          "word_index": 8,
          "text": "عَن"
        },
        {
          "word_index": 9,
          "text": "طَآئِفَةٍۢ"
        },
        {
          "word_index": 10,
          "text": "مِّنكُمْ"
        },
        {
          "word_index": 11,
          "text": "نُعَذِّبْ"
        },
        {
          "word_index": 12,
          "text": "طَآئِفَةًۢ"
        },
        {
          "word_index": 13,
          "text": "بِأَنَّهُمْ"
        },
        {
          "word_index": 14,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 15,
          "text": "مُجْرِمِينَ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 67,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلْمُنَـٰفِقُونَ"
        },
        {
          "word_index": 1,
          "text": "وَٱلْمُنَـٰفِقَـٰتُ"
        },
        {
          "word_index": 2,
          "text": "بَعْضُهُم"
        },
        {
          "word_index": 3,
          "text": "مِّنۢ"
        },
        {
          "word_index": 4,
          "text": "بَعْضٍۢ ۚ"
        },
        {
          "word_index": 5,
          "text": "يَأْمُرُونَ"
        },
        {
          "word_index": 6,
          "text": "بِٱلْمُنكَرِ"
        },
        {
          "word_index": 7,
          "text": "وَيَنْهَوْنَ"
        },
        {
          "word_index": 8,
          "text": "عَنِ"
        },
        {
          "word_index": 9,
          "text": "ٱلْمَعْرُوفِ"
        },
        {
          "word_index": 10,
          "text": "وَيَقْبِضُونَ"
        },
        {
          "word_index": 11,
          "text": "أَيْدِيَهُمْ ۚ"
        },
        {
          "word_index": 12,
          "text": "نَسُوا۟"
        },
        {
          "word_index": 13,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 14,
          "text": "فَنَسِيَهُمْ ۗ"
        },
        {
          "word_index": 15,
          "text": "إِنَّ"
        },
        {
          "word_index": 16,
          "text": "ٱلْمُنَـٰفِقِينَ"
        },
        {
          "word_index": 17,
          "text": "هُمُ"
        },
        {
          "word_index": 18,
