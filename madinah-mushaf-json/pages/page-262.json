          "word_index": 3,
          "text": "قَرْيَةٍ"
        },
        {
          "word_index": 4,
          "text": "إِلَّا"
        },
        {
          "word_index": 5,
          "text": "وَلَهَا"
        },
        {
          "word_index": 6,
          "text": "كِتَابٌۭ"
        },
        {
          "word_index": 7,
          "text": "مَّعْلُومٌۭ"
        }
      ]
    },
    {
      "surah_number": 15,
      "ayah_number": 5,
      "words": [
        {
          "word_index": 0,
          "text": "مَّا"
        },
