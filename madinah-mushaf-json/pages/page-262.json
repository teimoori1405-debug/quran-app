        {
          "word_index": 2,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 3,
          "text": "كَفَرُوا۟"
        },
        {
          "word_index": 4,
          "text": "لَوْ"
        },
        {
          "word_index": 5,
          "text": "كَانُوا۟"
        },
        {
          "word_index": 6,
          "text": "مُسْلِمِينَ"
        }
      ]
    },
    {
      "surah_number": 15,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "ذَرْهُمْ"
        },
        {
          "word_index": 1,
          "text": "يَأْكُلُوا۟"
        },
        {
          "word_index": 2,
          "text": "وَيَتَمَتَّعُوا۟"
        },
        {
          "word_index": 3,
          "text": "وَيُلْهِهِمُ"
        },
        {
          "word_index": 4,
          "text": "ٱلْأَمَلُ ۖ"
        },
        {
          "word_index": 5,
          "text": "فَسَوْفَ"
        },
        {
          "word_index": 6,
          "text": "يَعْلَمُونَ"
        }
      ]
    },
    {
      "surah_number": 15,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "وَمَآ"
        },
        {
          "word_index": 1,
          "text": "أَهْلَكْنَا"
        },
        {
          "word_index": 2,
          "text": "مِن"
