    {
      "surah_number": 15,
      "ayah_number": 1,
      "words": [
        {
          "word_index": 0,
          "text": "الٓر ۚ"
        },
        {
          "word_index": 1,
          "text": "تِلْكَ"
        },
        {
          "word_index": 2,
          "text": "ءَايَـٰتُ"
        },
        {
          "word_index": 3,
          "text": "ٱلْكِتَـٰبِ"
        },
        {
          "word_index": 4,
          "text": "وَقُرْءَانٍۢ"
        },
        {
          "word_index": 5,
          "text": "مُّبِينٍۢ"
        }
      ]
    },
    {
      "surah_number": 15,
      "ayah_number": 2,
      "words": [
        {
          "word_index": 0,
          "text": "رُّبَمَا"
        },
        {
          "word_index": 1,
          "text": "يَوَدُّ"
