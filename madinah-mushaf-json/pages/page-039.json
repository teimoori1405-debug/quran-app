          "text": "فِىٓ"
        },
        {
          "word_index": 21,
          "text": "أَنفُسِهِنَّ"
        },
        {
          "word_index": 22,
          "text": "مِن"
        },
        {
          "word_index": 23,
          "text": "مَّعْرُوفٍۢ ۗ"
        },
        {
          "word_index": 24,
          "text": "وَٱللَّهُ"
