  "verses": [
    {
      "surah_number": 2,
      "ayah_number": 238,
      "words": [
        {
          "word_index": 0,
          "text": "حَـٰفِظُوا۟"
        },
        {
          "word_index": 1,
          "text": "عَلَى"
        },
        {
          "word_index": 2,
          "text": "ٱلصَّلَوَٰتِ"
        },
        {
          "word_index": 3,
          "text": "وَٱلصَّلَوٰةِ"
        },
        {
          "word_index": 4,
          "text": "ٱلْوُسْطَىٰ"
        },
        {
          "word_index": 5,
          "text": "وَقُومُوا۟"
        },
        {
          "word_index": 6,
          "text": "لِلَّهِ"
        },
        {
          "word_index": 7,
          "text": "قَـٰنِتِينَ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 239,
      "words": [
        {
          "word_index": 0,
          "text": "فَإِنْ"
        },
        {
          "word_index": 1,
          "text": "خِفْتُمْ"
        },
