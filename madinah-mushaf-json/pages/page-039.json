          "word_index": 8,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 9,
          "text": "كَمَا"
        },
        {
          "word_index": 10,
          "text": "عَلَّمَكُم"
        },
        {
          "word_index": 11,
          "text": "مَّا"
        },
        {
          "word_index": 12,
          "text": "لَمْ"
        },
        {
          "word_index": 13,
          "text": "تَكُونُوا۟"
        },
        {
          "word_index": 14,
          "text": "تَعْلَمُونَ"
        }
      ]
    },
    {
      "surah_number": 2,
      "ayah_number": 240,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "يُتَوَفَّوْنَ"
        },
        {
          "word_index": 2,
          "text": "مِنكُمْ"
        },
        {
          "word_index": 3,
          "text": "وَيَذَرُونَ"
        },
        {
          "word_index": 4,
          "text": "أَزْوَٰجًۭا"
        },
        {
          "word_index": 5,
          "text": "وَصِيَّةًۭ"
        },
        {
          "word_index": 6,
          "text": "لِّأَزْوَٰجِهِم"
        },
        {
          "word_index": 7,
          "text": "مَّتَـٰعًا"
