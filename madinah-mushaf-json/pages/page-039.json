          "word_index": 2,
          "text": "فَرِجَالًا"
        },
        {
          "word_index": 3,
          "text": "أَوْ"
        },
        {
          "word_index": 4,
          "text": "رُكْبَانًۭا ۖ"
        },
        {
          "word_index": 5,
          "text": "فَإِذَآ"
        },
        {
          "word_index": 6,
          "text": "أَمِنتُمْ"
        },
        {
          "word_index": 7,
          "text": "فَٱذْكُرُوا۟"
