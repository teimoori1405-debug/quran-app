  "verses": [
    {
      "surah_number": 19,
      "ayah_number": 12,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰيَحْيَىٰ"
        },
        {
          "word_index": 1,
          "text": "خُذِ"
        },
        {
          "word_index": 2,
          "text": "ٱلْكِتَـٰبَ"
        },
        {
          "word_index": 3,
          "text": "بِقُوَّةٍۢ ۖ"
        },
        {
          "word_index": 4,
          "text": "وَءَاتَيْنَـٰهُ"
        },
        {
          "word_index": 5,
          "text": "ٱلْحُكْمَ"
        },
        {
          "word_index": 6,
          "text": "صَبِيًّۭا"
        }
      ]
    },
    {
      "surah_number": 19,
      "ayah_number": 13,
      "words": [
        {
          "word_index": 0,
          "text": "وَحَنَانًۭا"
        },
        {
          "word_index": 1,
          "text": "مِّن"
        },
        {
          "word_index": 2,
          "text": "لَّدُنَّا"
        },
        {
          "word_index": 3,
          "text": "وَزَكَوٰةًۭ ۖ"
        },
        {
          "word_index": 4,
          "text": "وَكَانَ"
        },
        {
          "word_index": 5,
          "text": "تَقِيًّۭا"
        }
      ]
    },
    {
      "surah_number": 19,
      "ayah_number": 14,
      "words": [
        {
          "word_index": 0,
          "text": "وَبَرًّۢا"
        },
        {
          "word_index": 1,
          "text": "بِوَٰلِدَيْهِ"
        },
        {
          "word_index": 2,
          "text": "وَلَمْ"
        },
        {
          "word_index": 3,
          "text": "يَكُن"
        },
        {
          "word_index": 4,
          "text": "جَبَّارًا"
        },
        {
          "word_index": 5,
          "text": "عَصِيًّۭا"
        }
      ]
    },
    {
      "surah_number": 19,
      "ayah_number": 15,
      "words": [
        {
          "word_index": 0,
          "text": "وَسَلَـٰمٌ"
