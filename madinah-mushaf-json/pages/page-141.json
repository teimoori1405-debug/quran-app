          "text": "كُلِّ"
        },
        {
          "word_index": 14,
          "text": "شَىْءٍۢ"
        },
        {
          "word_index": 15,
          "text": "وَكِيلٌۭ"
        }
      ]
    },
    {
      "surah_number": 6,
      "ayah_number": 103,
      "words": [
        {
          "word_index": 0,
          "text": "لَّا"
        },
        {
          "word_index": 1,
          "text": "تُدْرِكُهُ"
