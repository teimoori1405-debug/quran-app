          "word_index": 4,
          "text": "يُدْرِكُ"
        },
        {
          "word_index": 5,
          "text": "ٱلْأَبْصَـٰرَ ۖ"
        },
        {
          "word_index": 6,
          "text": "وَهُوَ"
        },
        {
          "word_index": 7,
          "text": "ٱللَّطِيفُ"
        },
