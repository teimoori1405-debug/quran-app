          "text": "ٱللَّهُ"
        },
        {
          "word_index": 2,
          "text": "رَبُّكُمْ ۖ"
        },
        {
          "word_index": 3,
          "text": "لَآ"
        },
        {
          "word_index": 4,
          "text": "إِلَـٰهَ"
        },
        {
          "word_index": 5,
          "text": "إِلَّا"
        },
        {
          "word_index": 6,
          "text": "هُوَ ۖ"
        },
        {
          "word_index": 7,
          "text": "خَـٰلِقُ"
        },
        {
          "word_index": 8,
          "text": "كُلِّ"
        },
        {
          "word_index": 9,
          "text": "شَىْءٍۢ"
        },
        {
          "word_index": 10,
          "text": "فَٱعْبُدُوهُ ۚ"
        },
        {
          "word_index": 11,
          "text": "وَهُوَ"
        },
