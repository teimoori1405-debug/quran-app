          "text": "نَزَّلْنَآ"
        },
        {
          "word_index": 3,
          "text": "إِلَيْهِمُ"
        },
        {
          "word_index": 4,
          "text": "ٱلْمَلَـٰٓئِكَةَ"
        },
        {
          "word_index": 5,
          "text": "وَكَلَّمَهُمُ"
        },
        {
          "word_index": 6,
          "text": "ٱلْمَوْتَىٰ"
        },
        {
          "word_index": 7,
          "text": "وَحَشَرْنَا"
