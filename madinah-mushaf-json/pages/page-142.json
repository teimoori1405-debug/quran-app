          "text": "لِيُؤْمِنُوٓا۟"
        },
        {
          "word_index": 15,
          "text": "إِلَّآ"
        },
        {
          "word_index": 16,
          "text": "أَن"
        },
        {
          "word_index": 17,
          "text": "يَشَآءَ"
        },
        {
          "word_index": 18,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 19,
          "text": "وَلَـٰكِنَّ"
        },
        {
          "word_index": 20,
          "text": "أَكْثَرَهُمْ"
        },
        {
          "word_index": 21,
          "text": "يَجْهَلُونَ"
        }
      ]
    },
    {
      "surah_number": 6,
      "ayah_number": 112,
      "words": [
        {
          "word_index": 0,
          "text": "وَكَذَٰلِكَ"
        },
