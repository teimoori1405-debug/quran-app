          "text": "عَدُوًّۭا"
        },
        {
          "word_index": 5,
          "text": "شَيَـٰطِينَ"
        },
        {
          "word_index": 6,
          "text": "ٱلْإِنسِ"
        },
        {
          "word_index": 7,
          "text": "وَٱلْجِنِّ"
