          "text": "كُلَّ"
        },
        {
          "word_index": 10,
          "text": "شَىْءٍۢ"
        },
        {
          "word_index": 11,
          "text": "قُبُلًۭا"
        },
        {
          "word_index": 12,
          "text": "مَّا"
        },
        {
          "word_index": 13,
          "text": "كَانُوا۟"
        },
        {
