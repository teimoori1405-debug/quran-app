  "verses": [
    {
      "surah_number": 6,
      "ayah_number": 111,
      "words": [
        {
          "word_index": 0,
          "text": "۞ وَلَوْ"
        },
        {
          "word_index": 1,
          "text": "أَنَّنَا"
