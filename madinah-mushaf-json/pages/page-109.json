{
  "page": 109,
  "verses": [
    {
      "surah_number": 5,
      "ayah_number": 10,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "كَفَرُوا۟"
        },
        {
          "word_index": 2,
          "text": "وَكَذَّبُوا۟"
        },
        {
          "word_index": 3,
          "text": "بِـَٔايَـٰتِنَآ"
        },
        {
          "word_index": 4,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 5,
          "text": "أَصْحَـٰبُ"
        },
        {
          "word_index": 6,
          "text": "ٱلْجَحِيمِ"
        }
      ]
    },
    {
      "surah_number": 5,
      "ayah_number": 11,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 3,
          "text": "ٱذْكُرُوا۟"
        },
        {
          "word_index": 4,
          "text": "نِعْمَتَ"
        },
        {
          "word_index": 5,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 6,
          "text": "عَلَيْكُمْ"
        },
        {
          "word_index": 7,
          "text": "إِذْ"
        },
        {
          "word_index": 8,
          "text": "هَمَّ"
        },
        {
          "word_index": 9,
          "text": "قَوْمٌ"
        },
        {
          "word_index": 10,
          "text": "أَن"
        },
        {
          "word_index": 11,
          "text": "يَبْسُطُوٓا۟"
        },
        {
          "word_index": 12,
          "text": "إِلَيْكُمْ"
        },
        {
          "word_index": 13,
          "text": "أَيْدِيَهُمْ"
        },
        {
          "word_index": 14,
          "text": "فَكَفَّ"
        },
        {
          "word_index": 15,
          "text": "أَيْدِيَهُمْ"
        },
        {
          "word_index": 16,
          "text": "عَنكُمْ ۖ"
        },
        {
          "word_index": 17,
          "text": "وَٱتَّقُوا۟"
        },
        {
          "word_index": 18,
          "text": "ٱللَّهَ ۚ"
        },
        {
          "word_index": 19,
          "text": "وَعَلَى"
        },
        {
          "word_index": 20,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 21,
          "text": "فَلْيَتَوَكَّلِ"
        },
        {
          "word_index": 22,
          "text": "ٱلْمُؤْمِنُونَ"
        }
      ]
    },
    {
      "surah_number": 5,
      "ayah_number": 12,
      "words": [
        {
          "word_index": 0,
          "text": "۞ وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "أَخَذَ"
        },
        {
          "word_index": 2,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 3,
          "text": "مِيثَـٰقَ"
        },
        {
          "word_index": 4,
          "text": "بَنِىٓ"
        },
        {
          "word_index": 5,
          "text": "إِسْرَٰٓءِيلَ"
        },
        {
          "word_index": 6,
          "text": "وَبَعَثْنَا"
        },
        {
          "word_index": 7,
          "text": "مِنْهُمُ"
        },
        {
          "word_index": 8,
          "text": "ٱثْنَىْ"
        },
        {
          "word_index": 9,
          "text": "عَشَرَ"
        },
        {
          "word_index": 10,
          "text": "نَقِيبًۭا ۖ"
        },
        {
          "word_index": 11,
          "text": "وَقَالَ"
        },
        {
          "word_index": 12,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 13,
          "text": "إِنِّى"
        },
        {
          "word_index": 14,
          "text": "مَعَكُمْ ۖ"
        },
        {
          "word_index": 15,
          "text": "لَئِنْ"
        },
        {
          "word_index": 16,
          "text": "أَقَمْتُمُ"
        },
        {
          "word_index": 17,
          "text": "ٱلصَّلَوٰةَ"
        },
        {
          "word_index": 18,
          "text": "وَءَاتَيْتُمُ"
        },
        {
          "word_index": 19,
          "text": "ٱلزَّكَوٰةَ"
        },
        {
          "word_index": 20,
          "text": "وَءَامَنتُم"
        },
        {
          "word_index": 21,
          "text": "بِرُسُلِى"
        },
        {
          "word_index": 22,
          "text": "وَعَزَّرْتُمُوهُمْ"
        },
        {
          "word_index": 23,
          "text": "وَأَقْرَضْتُمُ"
        },
        {
          "word_index": 24,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 25,
          "text": "قَرْضًا"
        },
        {
          "word_index": 26,
          "text": "حَسَنًۭا"
        },
        {
          "word_index": 27,
          "text": "لَّأُكَفِّرَنَّ"
        },
        {
          "word_index": 28,
          "text": "عَنكُمْ"
        },
        {
          "word_index": 29,
          "text": "سَيِّـَٔاتِكُمْ"
        },
        {
          "word_index": 30,
          "text": "وَلَأُدْخِلَنَّكُمْ"
        },
        {
          "word_index": 31,
          "text": "جَنَّـٰتٍۢ"
        },
        {
          "word_index": 32,
          "text": "تَجْرِى"
        },
        {
          "word_index": 33,
          "text": "مِن"
        },
        {
          "word_index": 34,
          "text": "تَحْتِهَا"
        },
        {
          "word_index": 35,
          "text": "ٱلْأَنْهَـٰرُ ۚ"
        },
        {
          "word_index": 36,
          "text": "فَمَن"
        },
        {
          "word_index": 37,
          "text": "كَفَرَ"
        },
        {
          "word_index": 38,
          "text": "بَعْدَ"
        },
        {
          "word_index": 39,
          "text": "ذَٰلِكَ"
        },
        {
          "word_index": 40,
          "text": "مِنكُمْ"
        },
        {
          "word_index": 41,
          "text": "فَقَدْ"
        },
        {
          "word_index": 42,
          "text": "ضَلَّ"
        },
        {
          "word_index": 43,
          "text": "سَوَآءَ"
        },
        {
          "word_index": 44,
          "text": "ٱلسَّبِيلِ"
        }
      ]
    },
    {
      "surah_number": 5,
      "ayah_number": 13,
      "words": [
        {
          "word_index": 0,
          "text": "فَبِمَا"
        },
        {
          "word_index": 1,
          "text": "نَقْضِهِم"
        },
        {
          "word_index": 2,
          "text": "مِّيثَـٰقَهُمْ"
        },
        {
          "word_index": 3,
          "text": "لَعَنَّـٰهُمْ"
        },
        {
          "word_index": 4,
          "text": "وَجَعَلْنَا"
        },
        {
          "word_index": 5,
          "text": "قُلُوبَهُمْ"
        },
        {
          "word_index": 6,
          "text": "قَـٰسِيَةًۭ ۖ"
        },
        {
          "word_index": 7,
          "text": "يُحَرِّفُونَ"
        },
        {
          "word_index": 8,
          "text": "ٱلْكَلِمَ"
        },
        {
          "word_index": 9,
          "text": "عَن"
        },
        {
          "word_index": 10,
          "text": "مَّوَاضِعِهِۦ ۙ"
        },
        {
          "word_index": 11,
          "text": "وَنَسُوا۟"
        },
        {
          "word_index": 12,
          "text": "حَظًّۭا"
        },
        {
          "word_index": 13,
          "text": "مِّمَّا"
        },
        {
          "word_index": 14,
          "text": "ذُكِّرُوا۟"
        },
        {
          "word_index": 15,
          "text": "بِهِۦ ۚ"
        },
        {
          "word_index": 16,
          "text": "وَلَا"
        },
        {
          "word_index": 17,
          "text": "تَزَالُ"
        },
        {
          "word_index": 18,
          "text": "تَطَّلِعُ"
        },
        {
          "word_index": 19,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 20,
          "text": "خَآئِنَةٍۢ"
        },
        {
          "word_index": 21,
          "text": "مِّنْهُمْ"
        },
        {
          "word_index": 22,
          "text": "إِلَّا"
        },
        {
          "word_index": 23,
          "text": "قَلِيلًۭا"
        },
        {
          "word_index": 24,
          "text": "مِّنْهُمْ ۖ"
        },
        {
          "word_index": 25,
          "text": "فَٱعْفُ"
        },
        {
          "word_index": 26,
          "text": "عَنْهُمْ"
        },
        {
          "word_index": 27,
          "text": "وَٱصْفَحْ ۚ"
        },
        {
          "word_index": 28,
          "text": "إِنَّ"
        },
        {
          "word_index": 29,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 30,
          "text": "يُحِبُّ"
        },
        {
          "word_index": 31,
          "text": "ٱلْمُحْسِنِينَ"
        }
      ]
    }
