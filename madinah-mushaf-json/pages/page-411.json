      "ayah_number": 2,
      "words": [
        {
          "word_index": 0,
          "text": "تِلْكَ"
        },
        {
          "word_index": 1,
          "text": "ءَايَـٰتُ"
        },
        {
          "word_index": 2,
          "text": "ٱلْكِتَـٰبِ"
        },
        {
          "word_index": 3,
          "text": "ٱلْحَكِيمِ"
        }
      ]
    },
    {
      "surah_number": 31,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "هُدًۭى"
        },
        {
          "word_index": 1,
          "text": "وَرَحْمَةًۭ"
        },
        {
          "word_index": 2,
          "text": "لِّلْمُحْسِنِينَ"
        }
      ]
    },
    {
      "surah_number": 31,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "يُقِيمُونَ"
        },
        {
          "word_index": 2,
          "text": "ٱلصَّلَوٰةَ"
        },
        {
          "word_index": 3,
          "text": "وَيُؤْتُونَ"
        },
        {
          "word_index": 4,
          "text": "ٱلزَّكَوٰةَ"
        },
        {
          "word_index": 5,
          "text": "وَهُم"
        },
        {
          "word_index": 6,
          "text": "بِٱلْـَٔاخِرَةِ"
        },
        {
          "word_index": 7,
          "text": "هُمْ"
        },
        {
          "word_index": 8,
          "text": "يُوقِنُونَ"
        }
      ]
    },
    {
      "surah_number": 31,
      "ayah_number": 5,
      "words": [
        {
          "word_index": 0,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 1,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 2,
          "text": "هُدًۭى"
        },
        {
          "word_index": 3,
          "text": "مِّن"
        },
        {
          "word_index": 4,
          "text": "رَّبِّهِمْ ۖ"
        },
        {
          "word_index": 5,
          "text": "وَأُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 6,
          "text": "هُمُ"
        },
        {
          "word_index": 7,
          "text": "ٱلْمُفْلِحُونَ"
        }
      ]
    },
    {
      "surah_number": 31,
      "ayah_number": 6,
      "words": [
        {
          "word_index": 0,
          "text": "وَمِنَ"
        },
