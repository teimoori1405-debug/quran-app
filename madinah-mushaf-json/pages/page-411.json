        },
        {
          "word_index": 5,
          "text": "ٱلْحَدِيثِ"
        },
        {
          "word_index": 6,
          "text": "لِيُضِلَّ"
        },
        {
          "word_index": 7,
          "text": "عَن"
        },
        {
          "word_index": 8,
          "text": "سَبِيلِ"
