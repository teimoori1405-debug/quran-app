        },
        {
          "word_index": 5,
          "text": "لَّا"
        },
        {
          "word_index": 6,
          "text": "يَطْعَمُهَآ"
        },
        {
          "word_index": 7,
          "text": "إِلَّا"
        },
        {
          "word_index": 8,
          "text": "مَن"
