        {
          "word_index": 2,
          "text": "فِى"
        },
        {
          "word_index": 3,
          "text": "ٱلْأَرْضِ"
        },
        {
          "word_index": 4,
          "text": "وَنُرِىَ"
        },
        {
          "word_index": 5,
          "text": "فِرْعَوْنَ"
        },
        {
          "word_index": 6,
          "text": "وَهَـٰمَـٰنَ"
        },
        {
          "word_index": 7,
          "text": "وَجُنُودَهُمَا"
        },
        {
          "word_index": 8,
          "text": "مِنْهُم"
