  "verses": [
    {
      "surah_number": 28,
      "ayah_number": 6,
      "words": [
        {
          "word_index": 0,
          "text": "وَنُمَكِّنَ"
        },
        {
          "word_index": 1,
          "text": "لَهُمْ"
