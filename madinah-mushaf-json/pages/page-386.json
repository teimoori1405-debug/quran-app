          "text": "إِنَّا"
        },
        {
          "word_index": 17,
          "text": "رَآدُّوهُ"
        },
        {
          "word_index": 18,
          "text": "إِلَيْكِ"
        },
        {
          "word_index": 19,
          "text": "وَجَاعِلُوهُ"
        },
        {
          "word_index": 20,
          "text": "مِنَ"
        },
        {
          "word_index": 21,
          "text": "ٱلْمُرْسَلِينَ"
