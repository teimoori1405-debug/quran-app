          "word_index": 4,
          "text": "أَنْ"
        },
        {
          "word_index": 5,
          "text": "أَرْضِعِيهِ ۖ"
        },
        {
          "word_index": 6,
          "text": "فَإِذَا"
        },
        {
          "word_index": 7,
          "text": "خِفْتِ"
