          "text": "ٱلصَّـٰلِحَـٰتِ"
        },
        {
          "word_index": 5,
          "text": "وَتَوَاصَوْا۟"
        },
        {
          "word_index": 6,
          "text": "بِٱلْحَقِّ"
        },
        {
          "word_index": 7,
          "text": "وَتَوَاصَوْا۟"
        },
        {
          "word_index": 8,
          "text": "بِٱلصَّبْرِ"
