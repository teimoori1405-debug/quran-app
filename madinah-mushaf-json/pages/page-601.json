    },
    {
      "surah_number": 103,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "إِلَّا"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوا۟"
        },
