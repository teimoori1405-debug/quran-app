{
  "page": 190,
  "verses": [
    {
      "surah_number": 9,
      "ayah_number": 21,
      "words": [
        {
          "word_index": 0,
          "text": "يُبَشِّرُهُمْ"
        },
        {
          "word_index": 1,
          "text": "رَبُّهُم"
        },
        {
          "word_index": 2,
          "text": "بِرَحْمَةٍۢ"
        },
        {
          "word_index": 3,
          "text": "مِّنْهُ"
        },
        {
          "word_index": 4,
          "text": "وَرِضْوَٰنٍۢ"
        },
        {
          "word_index": 5,
          "text": "وَجَنَّـٰتٍۢ"
        },
        {
          "word_index": 6,
          "text": "لَّهُمْ"
        },
        {
          "word_index": 7,
          "text": "فِيهَا"
        },
        {
          "word_index": 8,
          "text": "نَعِيمٌۭ"
        },
        {
          "word_index": 9,
          "text": "مُّقِيمٌ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 22,
      "words": [
        {
          "word_index": 0,
          "text": "خَـٰلِدِينَ"
        },
        {
          "word_index": 1,
          "text": "فِيهَآ"
        },
        {
          "word_index": 2,
          "text": "أَبَدًا ۚ"
        },
        {
          "word_index": 3,
          "text": "إِنَّ"
        },
        {
          "word_index": 4,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 5,
          "text": "عِندَهُۥٓ"
        },
        {
          "word_index": 6,
          "text": "أَجْرٌ"
        },
        {
          "word_index": 7,
          "text": "عَظِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 23,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 3,
          "text": "لَا"
        },
        {
          "word_index": 4,
          "text": "تَتَّخِذُوٓا۟"
        },
        {
          "word_index": 5,
          "text": "ءَابَآءَكُمْ"
        },
        {
          "word_index": 6,
          "text": "وَإِخْوَٰنَكُمْ"
        },
        {
          "word_index": 7,
          "text": "أَوْلِيَآءَ"
        },
        {
          "word_index": 8,
          "text": "إِنِ"
        },
        {
          "word_index": 9,
          "text": "ٱسْتَحَبُّوا۟"
        },
        {
          "word_index": 10,
          "text": "ٱلْكُفْرَ"
        },
        {
          "word_index": 11,
          "text": "عَلَى"
        },
        {
          "word_index": 12,
          "text": "ٱلْإِيمَـٰنِ ۚ"
        },
        {
          "word_index": 13,
          "text": "وَمَن"
        },
        {
          "word_index": 14,
          "text": "يَتَوَلَّهُم"
        },
        {
          "word_index": 15,
          "text": "مِّنكُمْ"
        },
        {
          "word_index": 16,
          "text": "فَأُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 17,
          "text": "هُمُ"
        },
        {
          "word_index": 18,
          "text": "ٱلظَّـٰلِمُونَ"
        }
      ]
    },
    {
      "surah_number": 9,
      "ayah_number": 24,
      "words": [
        {
          "word_index": 0,
          "text": "قُلْ"
        },
        {
          "word_index": 1,
          "text": "إِن"
        },
        {
          "word_index": 2,
          "text": "كَانَ"
        },
        {
          "word_index": 3,
          "text": "ءَابَآؤُكُمْ"
        },
        {
          "word_index": 4,
          "text": "وَأَبْنَآؤُكُمْ"
        },
        {
          "word_index": 5,
          "text": "وَإِخْوَٰنُكُمْ"
        },
        {
          "word_index": 6,
          "text": "وَأَزْوَٰجُكُمْ"
        },
        {
          "word_index": 7,
          "text": "وَعَشِيرَتُكُمْ"
        },
        {
          "word_index": 8,
          "text": "وَأَمْوَٰلٌ"
        },
        {
          "word_index": 9,
          "text": "ٱقْتَرَفْتُمُوهَا"
        },
        {
          "word_index": 10,
          "text": "وَتِجَـٰرَةٌۭ"
        },
        {
          "word_index": 11,
          "text": "تَخْشَوْنَ"
        },
        {
          "word_index": 12,
          "text": "كَسَادَهَا"
        },
        {
          "word_index": 13,
          "text": "وَمَسَـٰكِنُ"
        },
        {
          "word_index": 14,
          "text": "تَرْضَوْنَهَآ"
        },
        {
          "word_index": 15,
          "text": "أَحَبَّ"
        },
        {
          "word_index": 16,
          "text": "إِلَيْكُم"
        },
        {
          "word_index": 17,
          "text": "مِّنَ"
        },
        {
          "word_index": 18,
          "text": "ٱللَّهِ"
        },
        {
          "word_index": 19,
          "text": "وَرَسُولِهِۦ"
        },
        {
          "word_index": 20,
          "text": "وَجِهَادٍۢ"
        },
        {
          "word_index": 21,
          "text": "فِى"
        },
        {
          "word_index": 22,
          "text": "سَبِيلِهِۦ"
        },
        {
          "word_index": 23,
          "text": "فَتَرَبَّصُوا۟"
        },
        {
          "word_index": 24,
          "text": "حَتَّىٰ"
        },
        {
          "word_index": 25,
          "text": "يَأْتِىَ"
        },
        {
          "word_index": 26,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 27,
          "text": "بِأَمْرِهِۦ ۗ"
        },
        {
          "word_index": 28,
          "text": "وَٱللَّهُ"
        },
        {
          "word_index": 29,
          "text": "لَا"
        },
        {
          "word_index": 30,
          "text": "يَهْدِى"
        },
        {
