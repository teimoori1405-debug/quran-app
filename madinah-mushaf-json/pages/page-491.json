        {
          "word_index": 2,
          "text": "أَرْسَلْنَا"
        },
        {
          "word_index": 3,
          "text": "مِن"
        },
        {
          "word_index": 4,
          "text": "قَبْلِكَ"
        },
        {
          "word_index": 5,
          "text": "فِى"
        },
        {
          "word_index": 6,
          "text": "قَرْيَةٍۢ"
        },
        {
          "word_index": 7,
          "text": "مِّن"
        },
        {
          "word_index": 8,
          "text": "نَّذِيرٍ"
        },
        {
          "word_index": 9,
          "text": "إِلَّا"
        },
        {
          "word_index": 10,
          "text": "قَالَ"
        },
        {
          "word_index": 11,
          "text": "مُتْرَفُوهَآ"
        },
        {
          "word_index": 12,
          "text": "إِنَّا"
        },
        {
          "word_index": 13,
          "text": "وَجَدْنَآ"
        },
        {
          "word_index": 14,
          "text": "ءَابَآءَنَا"
        },
        {
          "word_index": 15,
          "text": "عَلَىٰٓ"
        },
        {
          "word_index": 16,
          "text": "أُمَّةٍۢ"
        },
        {
          "word_index": 17,
          "text": "وَإِنَّا"
        },
        {
          "word_index": 18,
          "text": "عَلَىٰٓ"
        },
        {
          "word_index": 19,
          "text": "ءَاثَـٰرِهِم"
        },
        {
          "word_index": 20,
          "text": "مُّقْتَدُونَ"
        }
      ]
    },
    {
      "surah_number": 43,
      "ayah_number": 24,
      "words": [
        {
          "word_index": 0,
          "text": "۞ قَـٰلَ"
        },
        {
          "word_index": 1,
          "text": "أَوَلَوْ"
        },
        {
          "word_index": 2,
          "text": "جِئْتُكُم"
        },
        {
          "word_index": 3,
          "text": "بِأَهْدَىٰ"
        },
        {
          "word_index": 4,
          "text": "مِمَّا"
        },
        {
          "word_index": 5,
          "text": "وَجَدتُّمْ"
        },
        {
          "word_index": 6,
          "text": "عَلَيْهِ"
        },
        {
          "word_index": 7,
          "text": "ءَابَآءَكُمْ ۖ"
        },
        {
          "word_index": 8,
          "text": "قَالُوٓا۟"
        },
        {
          "word_index": 9,
          "text": "إِنَّا"
        },
        {
          "word_index": 10,
          "text": "بِمَآ"
