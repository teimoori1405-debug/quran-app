        {
          "word_index": 12,
          "text": "بِهِۦ"
        },
        {
          "word_index": 13,
          "text": "كَـٰفِرُونَ"
        }
      ]
    },
    {
      "surah_number": 43,
      "ayah_number": 25,
      "words": [
        {
          "word_index": 0,
          "text": "فَٱنتَقَمْنَا"
