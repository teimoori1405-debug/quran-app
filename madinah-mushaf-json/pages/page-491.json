        {
          "word_index": 4,
          "text": "وَقَوْمِهِۦٓ"
        },
        {
          "word_index": 5,
          "text": "إِنَّنِى"
        },
        {
          "word_index": 6,
          "text": "بَرَآءٌۭ"
