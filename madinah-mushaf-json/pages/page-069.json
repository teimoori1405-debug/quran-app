          "text": "يُرِيدُ"
        },
        {
          "word_index": 27,
          "text": "ٱلْـَٔاخِرَةَ ۚ"
        },
        {
          "word_index": 28,
          "text": "ثُمَّ"
        },
        {
          "word_index": 29,
          "text": "صَرَفَكُمْ"
        },
        {
          "word_index": 30,
          "text": "عَنْهُمْ"
        },
        {
          "word_index": 31,
          "text": "لِيَبْتَلِيَكُمْ ۖ"
        },
        {
          "word_index": 32,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 33,
          "text": "عَفَا"
        },
        {
          "word_index": 34,
          "text": "عَنكُمْ ۗ"
        },
        {
          "word_index": 35,
          "text": "وَٱللَّهُ"
        },
        {
          "word_index": 36,
          "text": "ذُو"
        },
        {
          "word_index": 37,
          "text": "فَضْلٍ"
        },
        {
          "word_index": 38,
          "text": "عَلَى"
        },
        {
          "word_index": 39,
          "text": "ٱلْمُؤْمِنِينَ"
        }
      ]
    },
    {
      "surah_number": 3,
