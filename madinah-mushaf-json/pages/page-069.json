  "verses": [
    {
      "surah_number": 3,
      "ayah_number": 149,
      "words": [
        {
          "word_index": 0,
          "text": "يَـٰٓأَيُّهَا"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوٓا۟"
        },
        {
          "word_index": 3,
          "text": "إِن"
        },
        {
          "word_index": 4,
          "text": "تُطِيعُوا۟"
        },
        {
          "word_index": 5,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 6,
          "text": "كَفَرُوا۟"
        },
        {
          "word_index": 7,
          "text": "يَرُدُّوكُمْ"
        },
        {
          "word_index": 8,
          "text": "عَلَىٰٓ"
        },
        {
          "word_index": 9,
          "text": "أَعْقَـٰبِكُمْ"
        },
        {
          "word_index": 10,
          "text": "فَتَنقَلِبُوا۟"
        },
        {
          "word_index": 11,
          "text": "خَـٰسِرِينَ"
        }
      ]
    },
    {
      "surah_number": 3,
      "ayah_number": 150,
      "words": [
        {
          "word_index": 0,
          "text": "بَلِ"
        },
        {
          "word_index": 1,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 2,
          "text": "مَوْلَىٰكُمْ ۖ"
        },
        {
          "word_index": 3,
          "text": "وَهُوَ"
        },
        {
          "word_index": 4,
          "text": "خَيْرُ"
        },
        {
          "word_index": 5,
          "text": "ٱلنَّـٰصِرِينَ"
        }
      ]
    },
    {
      "surah_number": 3,
      "ayah_number": 151,
      "words": [
        {
          "word_index": 0,
          "text": "سَنُلْقِى"
        },
        {
          "word_index": 1,
          "text": "فِى"
        },
        {
          "word_index": 2,
          "text": "قُلُوبِ"
        },
        {
          "word_index": 3,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 4,
          "text": "كَفَرُوا۟"
        },
        {
          "word_index": 5,
          "text": "ٱلرُّعْبَ"
        },
        {
          "word_index": 6,
          "text": "بِمَآ"
        },
        {
          "word_index": 7,
          "text": "أَشْرَكُوا۟"
        },
        {
          "word_index": 8,
          "text": "بِٱللَّهِ"
        },
        {
          "word_index": 9,
          "text": "مَا"
        },
        {
          "word_index": 10,
          "text": "لَمْ"
        },
        {
          "word_index": 11,
          "text": "يُنَزِّلْ"
        },
        {
          "word_index": 12,
          "text": "بِهِۦ"
        },
        {
          "word_index": 13,
          "text": "سُلْطَـٰنًۭا ۖ"
        },
        {
          "word_index": 14,
          "text": "وَمَأْوَىٰهُمُ"
        },
        {
          "word_index": 15,
          "text": "ٱلنَّارُ ۚ"
        },
        {
          "word_index": 16,
          "text": "وَبِئْسَ"
        },
        {
          "word_index": 17,
          "text": "مَثْوَى"
        },
        {
          "word_index": 18,
          "text": "ٱلظَّـٰلِمِينَ"
        }
      ]
    },
    {
      "surah_number": 3,
      "ayah_number": 152,
      "words": [
        {
          "word_index": 0,
          "text": "وَلَقَدْ"
        },
        {
          "word_index": 1,
          "text": "صَدَقَكُمُ"
        },
        {
          "word_index": 2,
          "text": "ٱللَّهُ"
        },
        {
          "word_index": 3,
          "text": "وَعْدَهُۥٓ"
        },
        {
          "word_index": 4,
          "text": "إِذْ"
        },
        {
          "word_index": 5,
          "text": "تَحُسُّونَهُم"
        },
        {
          "word_index": 6,
          "text": "بِإِذْنِهِۦ ۖ"
        },
        {
          "word_index": 7,
          "text": "حَتَّىٰٓ"
        },
        {
          "word_index": 8,
          "text": "إِذَا"
        },
        {
          "word_index": 9,
          "text": "فَشِلْتُمْ"
        },
        {
          "word_index": 10,
          "text": "وَتَنَـٰزَعْتُمْ"
        },
        {
          "word_index": 11,
          "text": "فِى"
        },
        {
          "word_index": 12,
          "text": "ٱلْأَمْرِ"
        },
        {
          "word_index": 13,
          "text": "وَعَصَيْتُم"
        },
        {
          "word_index": 14,
          "text": "مِّنۢ"
        },
        {
          "word_index": 15,
          "text": "بَعْدِ"
        },
        {
          "word_index": 16,
          "text": "مَآ"
        },
        {
          "word_index": 17,
          "text": "أَرَىٰكُم"
        },
        {
          "word_index": 18,
          "text": "مَّا"
        },
        {
          "word_index": 19,
          "text": "تُحِبُّونَ ۚ"
        },
        {
          "word_index": 20,
          "text": "مِنكُم"
        },
        {
          "word_index": 21,
          "text": "مَّن"
        },
        {
          "word_index": 22,
          "text": "يُرِيدُ"
        },
        {
          "word_index": 23,
          "text": "ٱلدُّنْيَا"
        },
        {
          "word_index": 24,
          "text": "وَمِنكُم"
        },
        {
          "word_index": 25,
