        {
          "word_index": 5,
          "text": "أَزْوَٰجِكُمْ"
        },
        {
          "word_index": 6,
          "text": "وَأَوْلَـٰدِكُمْ"
        },
        {
          "word_index": 7,
          "text": "عَدُوًّۭا"
