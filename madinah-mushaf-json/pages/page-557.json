          "text": "شَىْءٍ"
        },
        {
          "word_index": 15,
          "text": "عَلِيمٌۭ"
        }
      ]
    },
    {
      "surah_number": 64,
      "ayah_number": 12,
      "words": [
        {
          "word_index": 0,
          "text": "وَأَطِيعُوا۟"
        },
        {
          "word_index": 1,
          "text": "ٱللَّهَ"
        },
        {
          "word_index": 2,
          "text": "وَأَطِيعُوا۟"
        },
        {
          "word_index": 3,
          "text": "ٱلرَّسُولَ ۚ"
        },
        {
          "word_index": 4,
          "text": "فَإِن"
        },
        {
          "word_index": 5,
          "text": "تَوَلَّيْتُمْ"
        },
        {
          "word_index": 6,
          "text": "فَإِنَّمَا"
        },
        {
          "word_index": 7,
          "text": "عَلَىٰ"
