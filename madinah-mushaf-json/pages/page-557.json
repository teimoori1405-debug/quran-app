  "verses": [
    {
      "surah_number": 64,
      "ayah_number": 10,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "كَفَرُوا۟"
        },
        {
          "word_index": 2,
          "text": "وَكَذَّبُوا۟"
        },
        {
          "word_index": 3,
          "text": "بِـَٔايَـٰتِنَآ"
        },
        {
          "word_index": 4,
          "text": "أُو۟لَـٰٓئِكَ"
        },
        {
          "word_index": 5,
          "text": "أَصْحَـٰبُ"
        },
        {
          "word_index": 6,
          "text": "ٱلنَّارِ"
        },
        {
          "word_index": 7,
          "text": "خَـٰلِدِينَ"
        },
        {
          "word_index": 8,
          "text": "فِيهَا ۖ"
        },
