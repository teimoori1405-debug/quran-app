          "text": "مُّصِيبَةٍ"
        },
        {
          "word_index": 4,
          "text": "إِلَّا"
        },
        {
          "word_index": 5,
          "text": "بِإِذْنِ"
        },
        {
          "word_index": 6,
          "text": "ٱللَّهِ ۗ"
        },
        {
          "word_index": 7,
          "text": "وَمَن"
