    {
      "surah_number": 52,
      "ayah_number": 15,
      "words": [
        {
          "word_index": 0,
          "text": "أَفَسِحْرٌ"
        },
        {
          "word_index": 1,
          "text": "هَـٰذَآ"
        },
        {
          "word_index": 2,
          "text": "أَمْ"
        },
        {
          "word_index": 3,
          "text": "أَنتُمْ"
        },
        {
          "word_index": 4,
          "text": "لَا"
        },
        {
          "word_index": 5,
          "text": "تُبْصِرُونَ"
        }
      ]
    },
    {
      "surah_number": 52,
      "ayah_number": 16,
      "words": [
        {
          "word_index": 0,
          "text": "ٱصْلَوْهَا"
        },
        {
          "word_index": 1,
          "text": "فَٱصْبِرُوٓا۟"
        },
        {
          "word_index": 2,
          "text": "أَوْ"
        },
        {
          "word_index": 3,
          "text": "لَا"
        },
        {
          "word_index": 4,
          "text": "تَصْبِرُوا۟"
        },
        {
          "word_index": 5,
          "text": "سَوَآءٌ"
        },
        {
          "word_index": 6,
          "text": "عَلَيْكُمْ ۖ"
        },
        {
          "word_index": 7,
          "text": "إِنَّمَا"
        },
        {
          "word_index": 8,
          "text": "تُجْزَوْنَ"
        },
        {
          "word_index": 9,
          "text": "مَا"
        },
        {
          "word_index": 10,
          "text": "كُنتُمْ"
        },
        {
          "word_index": 11,
          "text": "تَعْمَلُونَ"
        }
      ]
    },
    {
      "surah_number": 52,
      "ayah_number": 17,
      "words": [
        {
          "word_index": 0,
          "text": "إِنَّ"
        },
        {
          "word_index": 1,
          "text": "ٱلْمُتَّقِينَ"
        },
        {
          "word_index": 2,
          "text": "فِى"
        },
        {
          "word_index": 3,
          "text": "جَنَّـٰتٍۢ"
        },
        {
          "word_index": 4,
          "text": "وَنَعِيمٍۢ"
        }
      ]
    },
    {
      "surah_number": 52,
      "ayah_number": 18,
      "words": [
        {
          "word_index": 0,
          "text": "فَـٰكِهِينَ"
        },
        {
          "word_index": 1,
          "text": "بِمَآ"
        },
        {
          "word_index": 2,
          "text": "ءَاتَىٰهُمْ"
        },
        {
          "word_index": 3,
          "text": "رَبُّهُمْ"
        },
        {
          "word_index": 4,
          "text": "وَوَقَىٰهُمْ"
        },
        {
          "word_index": 5,
          "text": "رَبُّهُمْ"
        },
        {
          "word_index": 6,
          "text": "عَذَابَ"
        },
        {
          "word_index": 7,
          "text": "ٱلْجَحِيمِ"
        }
      ]
    },
    {
      "surah_number": 52,
      "ayah_number": 19,
      "words": [
        {
          "word_index": 0,
          "text": "كُلُوا۟"
        },
        {
          "word_index": 1,
          "text": "وَٱشْرَبُوا۟"
        },
        {
          "word_index": 2,
          "text": "هَنِيٓـًٔۢا"
        },
        {
          "word_index": 3,
          "text": "بِمَا"
        },
        {
          "word_index": 4,
          "text": "كُنتُمْ"
        },
        {
          "word_index": 5,
          "text": "تَعْمَلُونَ"
        }
      ]
    },
    {
      "surah_number": 52,
      "ayah_number": 20,
      "words": [
        {
          "word_index": 0,
          "text": "مُتَّكِـِٔينَ"
        },
        {
          "word_index": 1,
          "text": "عَلَىٰ"
        },
        {
          "word_index": 2,
          "text": "سُرُرٍۢ"
        },
        {
          "word_index": 3,
          "text": "مَّصْفُوفَةٍۢ ۖ"
        },
        {
          "word_index": 4,
          "text": "وَزَوَّجْنَـٰهُم"
        },
        {
          "word_index": 5,
          "text": "بِحُورٍ"
        },
        {
          "word_index": 6,
          "text": "عِينٍۢ"
        }
      ]
    },
    {
      "surah_number": 52,
      "ayah_number": 21,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱلَّذِينَ"
        },
        {
          "word_index": 1,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 2,
          "text": "وَٱتَّبَعَتْهُمْ"
        },
        {
          "word_index": 3,
          "text": "ذُرِّيَّتُهُم"
        },
        {
          "word_index": 4,
          "text": "بِإِيمَـٰنٍ"
        },
        {
          "word_index": 5,
          "text": "أَلْحَقْنَا"
        },
        {
          "word_index": 6,
          "text": "بِهِمْ"
        },
        {
          "word_index": 7,
          "text": "ذُرِّيَّتَهُمْ"
        },
        {
          "word_index": 8,
          "text": "وَمَآ"
        },
        {
          "word_index": 9,
          "text": "أَلَتْنَـٰهُم"
        },
        {
          "word_index": 10,
          "text": "مِّنْ"
        },
        {
          "word_index": 11,
          "text": "عَمَلِهِم"
        },
        {
          "word_index": 12,
          "text": "مِّن"
        },
        {
          "word_index": 13,
          "text": "شَىْءٍۢ ۚ"
        },
        {
          "word_index": 14,
          "text": "كُلُّ"
        },
        {
          "word_index": 15,
          "text": "ٱمْرِئٍۭ"
        },
        {
          "word_index": 16,
          "text": "بِمَا"
        },
        {
          "word_index": 17,
          "text": "كَسَبَ"
        },
        {
          "word_index": 18,
          "text": "رَهِينٌۭ"
        }
