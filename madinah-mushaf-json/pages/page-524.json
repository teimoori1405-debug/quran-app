          "text": "مِّمَّا"
        },
        {
          "word_index": 4,
          "text": "يَشْتَهُونَ"
        }
      ]
    },
    {
      "surah_number": 52,
      "ayah_number": 23,
      "words": [
        {
          "word_index": 0,
          "text": "يَتَنَـٰزَعُونَ"
        },
        {
          "word_index": 1,
          "text": "فِيهَا"
        },
        {
          "word_index": 2,
          "text": "كَأْسًۭا"
