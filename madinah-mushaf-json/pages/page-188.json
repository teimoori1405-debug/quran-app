          "text": "ٱلْمَسْجِدِ"
        },
        {
          "word_index": 13,
          "text": "ٱلْحَرَامِ ۖ"
        },
        {
          "word_index": 14,
          "text": "فَمَا"
        },
        {
          "word_index": 15,
          "text": "ٱسْتَقَـٰمُوا۟"
