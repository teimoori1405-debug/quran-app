          "text": "عَنْ"
        },
        {
          "word_index": 13,
          "text": "ءَايَـٰتِنَا"
        },
        {
          "word_index": 14,
          "text": "غَـٰفِلُونَ"
        }
      ]
    },
    {
      "surah_number": 10,
      "ayah_number": 8,
      "words": [
        {
          "word_index": 0,
          "text": "أُو۟لَـٰٓئِكَ"
        },
