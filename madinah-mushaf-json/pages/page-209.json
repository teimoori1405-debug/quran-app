          "word_index": 3,
          "text": "يَرْجُونَ"
        },
        {
          "word_index": 4,
          "text": "لِقَآءَنَا"
        },
        {
          "word_index": 5,
          "text": "وَرَضُوا۟"
        },
        {
          "word_index": 6,
          "text": "بِٱلْحَيَوٰةِ"
        },
        {
          "word_index": 7,
          "text": "ٱلدُّنْيَا"
