          "word_index": 0,
          "text": "إِنَّ"
        },
        {
          "word_index": 1,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 2,
          "text": "ءَامَنُوا۟"
        },
        {
          "word_index": 3,
          "text": "وَعَمِلُوا۟"
        },
        {
          "word_index": 4,
          "text": "ٱلصَّـٰلِحَـٰتِ"
        },
        {
          "word_index": 5,
          "text": "يَهْدِيهِمْ"
