          "word_index": 3,
          "text": "ٱللَّهُمَّ"
        },
        {
          "word_index": 4,
          "text": "وَتَحِيَّتُهُمْ"
        },
        {
          "word_index": 5,
          "text": "فِيهَا"
        },
        {
          "word_index": 6,
          "text": "سَلَـٰمٌۭ ۚ"
