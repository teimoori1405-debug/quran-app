          "text": "ٱلْبَنَـٰتِ"
        },
        {
          "word_index": 3,
          "text": "سُبْحَـٰنَهُۥ ۙ"
        },
        {
          "word_index": 4,
          "text": "وَلَهُم"
        },
        {
          "word_index": 5,
          "text": "مَّا"
        },
        {
          "word_index": 6,
          "text": "يَشْتَهُونَ"
