  "verses": [
    {
      "surah_number": 16,
      "ayah_number": 55,
      "words": [
        {
          "word_index": 0,
          "text": "لِيَكْفُرُوا۟"
        },
        {
          "word_index": 1,
          "text": "بِمَآ"
        },
        {
          "word_index": 2,
          "text": "ءَاتَيْنَـٰهُمْ ۚ"
        },
        {
          "word_index": 3,
          "text": "فَتَمَتَّعُوا۟ ۖ"
        },
        {
          "word_index": 4,
          "text": "فَسَوْفَ"
        },
        {
          "word_index": 5,
          "text": "تَعْلَمُونَ"
        }
      ]
    },
    {
      "surah_number": 16,
      "ayah_number": 56,
      "words": [
        {
          "word_index": 0,
          "text": "وَيَجْعَلُونَ"
        },
        {
          "word_index": 1,
          "text": "لِمَا"
        },
        {
          "word_index": 2,
          "text": "لَا"
        },
        {
