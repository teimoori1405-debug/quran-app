          "text": "يَعْلَمُونَ"
        },
        {
          "word_index": 4,
          "text": "نَصِيبًۭا"
        },
        {
          "word_index": 5,
          "text": "مِّمَّا"
        },
        {
          "word_index": 6,
          "text": "رَزَقْنَـٰهُمْ ۗ"
        },
        {
          "word_index": 7,
          "text": "تَٱللَّهِ"
        },
        {
          "word_index": 8,
          "text": "لَتُسْـَٔلُنَّ"
        },
        {
          "word_index": 9,
          "text": "عَمَّا"
        },
