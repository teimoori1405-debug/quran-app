        {
          "word_index": 3,
          "text": "إِلَّا"
        },
        {
          "word_index": 4,
          "text": "رِجَالًۭا"
        },
        {
          "word_index": 5,
          "text": "نُّوحِىٓ"
        },
        {
          "word_index": 6,
          "text": "إِلَيْهِمْ ۖ"
        },
        {
          "word_index": 7,
          "text": "فَسْـَٔلُوٓا۟"
        },
        {
          "word_index": 8,
          "text": "أَهْلَ"
        },
        {
          "word_index": 9,
          "text": "ٱلذِّكْرِ"
        },
