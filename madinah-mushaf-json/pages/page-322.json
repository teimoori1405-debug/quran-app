  "verses": [
    {
      "surah_number": 21,
      "ayah_number": 1,
      "words": [
        {
          "word_index": 0,
          "text": "ٱقْتَرَبَ"
        },
        {
          "word_index": 1,
          "text": "لِلنَّاسِ"
        },
        {
          "word_index": 2,
          "text": "حِسَابُهُمْ"
        },
        {
          "word_index": 3,
          "text": "وَهُمْ"
        },
        {
          "word_index": 4,
          "text": "فِى"
        },
        {
          "word_index": 5,
          "text": "غَفْلَةٍۢ"
        },
        {
          "word_index": 6,
          "text": "مُّعْرِضُونَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 2,
      "words": [
        {
          "word_index": 0,
          "text": "مَا"
        },
        {
          "word_index": 1,
          "text": "يَأْتِيهِم"
        },
        {
          "word_index": 2,
          "text": "مِّن"
        },
        {
          "word_index": 3,
          "text": "ذِكْرٍۢ"
        },
        {
          "word_index": 4,
          "text": "مِّن"
        },
        {
          "word_index": 5,
          "text": "رَّبِّهِم"
        },
        {
          "word_index": 6,
          "text": "مُّحْدَثٍ"
        },
        {
          "word_index": 7,
          "text": "إِلَّا"
        },
        {
          "word_index": 8,
          "text": "ٱسْتَمَعُوهُ"
        },
        {
          "word_index": 9,
          "text": "وَهُمْ"
        },
        {
          "word_index": 10,
          "text": "يَلْعَبُونَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 3,
      "words": [
        {
          "word_index": 0,
          "text": "لَاهِيَةًۭ"
        },
        {
          "word_index": 1,
          "text": "قُلُوبُهُمْ ۗ"
        },
        {
          "word_index": 2,
          "text": "وَأَسَرُّوا۟"
        },
        {
          "word_index": 3,
          "text": "ٱلنَّجْوَى"
        },
        {
          "word_index": 4,
          "text": "ٱلَّذِينَ"
        },
        {
          "word_index": 5,
          "text": "ظَلَمُوا۟"
        },
        {
          "word_index": 6,
          "text": "هَلْ"
        },
        {
          "word_index": 7,
          "text": "هَـٰذَآ"
        },
        {
          "word_index": 8,
          "text": "إِلَّا"
        },
        {
          "word_index": 9,
          "text": "بَشَرٌۭ"
        },
        {
          "word_index": 10,
          "text": "مِّثْلُكُمْ ۖ"
        },
        {
          "word_index": 11,
          "text": "أَفَتَأْتُونَ"
        },
        {
          "word_index": 12,
          "text": "ٱلسِّحْرَ"
        },
        {
          "word_index": 13,
          "text": "وَأَنتُمْ"
        },
        {
          "word_index": 14,
          "text": "تُبْصِرُونَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 4,
      "words": [
        {
          "word_index": 0,
          "text": "قَالَ"
        },
        {
          "word_index": 1,
          "text": "رَبِّى"
        },
        {
          "word_index": 2,
          "text": "يَعْلَمُ"
        },
        {
          "word_index": 3,
          "text": "ٱلْقَوْلَ"
        },
        {
          "word_index": 4,
          "text": "فِى"
        },
        {
          "word_index": 5,
          "text": "ٱلسَّمَآءِ"
        },
        {
          "word_index": 6,
          "text": "وَٱلْأَرْضِ ۖ"
        },
        {
          "word_index": 7,
          "text": "وَهُوَ"
        },
        {
          "word_index": 8,
          "text": "ٱلسَّمِيعُ"
        },
        {
          "word_index": 9,
          "text": "ٱلْعَلِيمُ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 5,
      "words": [
        {
          "word_index": 0,
          "text": "بَلْ"
        },
        {
          "word_index": 1,
          "text": "قَالُوٓا۟"
        },
        {
          "word_index": 2,
          "text": "أَضْغَـٰثُ"
        },
        {
          "word_index": 3,
          "text": "أَحْلَـٰمٍۭ"
        },
        {
          "word_index": 4,
          "text": "بَلِ"
        },
        {
          "word_index": 5,
          "text": "ٱفْتَرَىٰهُ"
        },
        {
          "word_index": 6,
          "text": "بَلْ"
        },
        {
          "word_index": 7,
          "text": "هُوَ"
        },
        {
          "word_index": 8,
          "text": "شَاعِرٌۭ"
        },
        {
          "word_index": 9,
          "text": "فَلْيَأْتِنَا"
        },
        {
          "word_index": 10,
          "text": "بِـَٔايَةٍۢ"
        },
        {
          "word_index": 11,
          "text": "كَمَآ"
        },
        {
          "word_index": 12,
          "text": "أُرْسِلَ"
        },
        {
          "word_index": 13,
          "text": "ٱلْأَوَّلُونَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 6,
      "words": [
        {
          "word_index": 0,
          "text": "مَآ"
        },
        {
          "word_index": 1,
          "text": "ءَامَنَتْ"
        },
        {
          "word_index": 2,
          "text": "قَبْلَهُم"
        },
        {
          "word_index": 3,
          "text": "مِّن"
        },
        {
          "word_index": 4,
          "text": "قَرْيَةٍ"
        },
        {
          "word_index": 5,
          "text": "أَهْلَكْنَـٰهَآ ۖ"
        },
        {
          "word_index": 6,
          "text": "أَفَهُمْ"
        },
        {
          "word_index": 7,
          "text": "يُؤْمِنُونَ"
        }
      ]
    },
    {
      "surah_number": 21,
      "ayah_number": 7,
      "words": [
        {
          "word_index": 0,
          "text": "وَمَآ"
        },
        {
          "word_index": 1,
          "text": "أَرْسَلْنَا"
        },
        {
          "word_index": 2,
          "text": "قَبْلَكَ"
