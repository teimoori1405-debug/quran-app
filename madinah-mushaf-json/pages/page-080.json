          "word_index": 3,
          "text": "مِن"
        },
        {
          "word_index": 4,
          "text": "نِّسَآئِكُمْ"
        },
        {
          "word_index": 5,
          "text": "فَٱسْتَشْهِدُوا۟"
        },
        {
          "word_index": 6,
          "text": "عَلَيْهِنَّ"
        },
