  "verses": [
    {
      "surah_number": 3,
      "ayah_number": 133,
      "words": [
        {
          "word_index": 0,
          "text": "۞ وَسَارِعُوٓا۟"
        },
        {
          "word_index": 1,
          "text": "إِلَىٰ"
        },
        {
          "word_index": 2,
          "text": "مَغْفِرَةٍۢ"
        },
        {
          "word_index": 3,
          "text": "مِّن"
        },
        {
          "word_index": 4,
          "text": "رَّبِّكُمْ"
        },
        {
          "word_index": 5,
          "text": "وَجَنَّةٍ"
        },
        {
          "word_index": 6,
          "text": "عَرْضُهَا"
        },
        {
          "word_index": 7,
          "text": "ٱلسَّمَـٰوَٰتُ"
        },
        {
          "word_index": 8,
          "text": "وَٱلْأَرْضُ"
