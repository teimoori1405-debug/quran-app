          "word_index": 10,
          "text": "لِلْمُتَّقِينَ"
        }
      ]
    },
    {
      "surah_number": 3,
      "ayah_number": 134,
      "words": [
        {
          "word_index": 0,
          "text": "ٱلَّذِينَ"
