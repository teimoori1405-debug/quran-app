          "word_index": 11,
          "text": "يُحِبُّ"
        },
        {
          "word_index": 12,
          "text": "ٱلْمُحْسِنِينَ"
        }
      ]
    },
    {
      "surah_number": 3,
      "ayah_number": 135,
      "words": [
        {
          "word_index": 0,
          "text": "وَٱلَّذِينَ"
