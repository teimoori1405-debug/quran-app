          "word_index": 4,
          "text": "وَٱلضَّرَّآءِ"
        },
        {
          "word_index": 5,
          "text": "وَٱلْكَـٰظِمِينَ"
        },
        {
          "word_index": 6,
          "text": "ٱلْغَيْظَ"
